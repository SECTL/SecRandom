<Styles xmlns="https://github.com/avaloniaui"
        xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core">
    <Style Selector="TextBox[(sr|TouchInputModeAssist.IsTouchMode)=True]">
        <Setter Property="ContextFlyout">
            <sr:TouchTextCommandBarFlyout Placement="Top" />
        </Setter>
    </Style>
</Styles>
