<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
                    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">
    <Design.PreviewWith>
        <Border Padding="50 50 50 300">
            <StackPanel Spacing="10">
                <Button>Remove Focus</Button>

                <TextBlock>FluentAvalonia.UI:</TextBlock>
                <ComboBox Width="200">
                    <ComboBoxItem>111</ComboBoxItem>
                    <ComboBoxItem>222</ComboBoxItem>
                    <ComboBoxItem>333</ComboBoxItem>
                    <ComboBoxItem>444</ComboBoxItem>
                    <ComboBoxItem>555</ComboBoxItem>
                </ComboBox>

                <TextBlock>SecRandom.Core:</TextBlock>
                <sr:MultiComboBox Width="200">
                    <sr:MultiComboBoxItem>111</sr:MultiComboBoxItem>
                    <sr:MultiComboBoxItem>222</sr:MultiComboBoxItem>
                    <sr:MultiComboBoxItem>333</sr:MultiComboBoxItem>
                    <sr:MultiComboBoxItem>444</sr:MultiComboBoxItem>
                    <sr:MultiComboBoxItem>555</sr:MultiComboBoxItem>
                </sr:MultiComboBox>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <x:Double x:Key="MultiComboBoxArrowThemeFontSize">21</x:Double>
    <x:Double x:Key="MultiComboBoxThemeMinWidth">64</x:Double>
    <x:Double x:Key="MultiComboBoxThemeMaxWidth">420</x:Double>
    <x:Double x:Key="MultiComboBoxPopupThemeMinWidth">80</x:Double>
    <x:Double x:Key="MultiComboBoxPopupThemeTouchMinWidth">240</x:Double>
    <x:Double x:Key="MultiComboBoxMinHeight">32</x:Double>
    <x:Int32 x:Key="MultiComboBoxPopupMaxNumberOfItems">15</x:Int32>
    <x:Int32 x:Key="MultiComboBoxPopupMaxNumberOfItemsThatCanBeShownOnOneSide">7</x:Int32>
    <x:String x:Key="MultiComboBoxItemScaleAnimationDuration">00:00:00.167</x:String>
    <Thickness x:Key="MultiComboBoxBorderThemeThickness">1</Thickness>
    <Thickness x:Key="MultiComboBoxDropdownBorderThickness">1</Thickness>
    <Thickness x:Key="MultiComboBoxHeaderThemeMargin">0,0,0,4</Thickness>
    <Thickness x:Key="MultiComboBoxPopupBorderThemeThickness">2</Thickness>
    <Thickness x:Key="MultiComboBoxItemThemePadding">11,5,11,7</Thickness>
    <Thickness x:Key="MultiComboBoxItemThemeTouchPadding">11,11,11,13</Thickness>
    <Thickness x:Key="MultiComboBoxItemThemeGameControllerPadding">11,11,11,13</Thickness>
    <Thickness x:Key="MultiComboBoxBackgroundBorderThicknessFocused">2</Thickness>
    <Thickness x:Key="MultiComboBoxDropdownBorderPadding">0</Thickness>
    <Thickness x:Key="MultiComboBoxDropdownContentMargin">0,2</Thickness>
    <Thickness x:Key="MultiComboBoxTopHeaderMargin">0,0,0,8</Thickness>
    <Thickness x:Key="MultiComboBoxPadding">4</Thickness>
    <Thickness x:Key="MultiComboBoxEditableTextPadding">11,5,32,6</Thickness>
    <CornerRadius x:Key="MultiComboBoxHiglightBorderCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="MultiComboBoxDropDownButtonBackgroundCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="MultiComboBoxItemCornerRadius">3</CornerRadius>
    <!-- Changed to double to avoid converters -->
    <FontWeight x:Key="MultiComboBoxHeaderThemeFontWeight">Normal</FontWeight>
    <FontWeight x:Key="MultiComboBoxPlaceholderTextThemeFontWeight">SemiLight</FontWeight>

    <ControlTheme TargetType="sr:MultiComboBox" x:Key="{x:Type sr:MultiComboBox}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource MultiComboBoxPadding}" />
        <Setter Property="MaxWidth" Value="{DynamicResource MultiComboBoxThemeMaxWidth}" />
        <Setter Property="MaxDropDownHeight" Value="504" />
        <Setter Property="Foreground" Value="{DynamicResource ComboBoxForeground}" />
        <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource MultiComboBoxBorderThemeThickness}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="MaxSelectionBoxHeight" Value="270" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <ControlTemplate TargetType="sr:MultiComboBox">
                <DataValidationErrors>
                    <Border x:Name="PART_BackgroundBorder"
                            Background="Transparent">
                        <Grid RowDefinitions="Auto, *, Auto"
                              ColumnDefinitions="*,32">
                            <Border x:Name="Background"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    MinWidth="{DynamicResource MultiComboBoxThemeMinWidth}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />

                            <Border x:Name="HighlightBackground"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    BorderThickness="{DynamicResource MultiComboBoxBackgroundBorderThicknessFocused}"
                                    Opacity="0"
                                    Background="{DynamicResource ComboBoxBackgroundFocused}"
                                    BorderBrush="{DynamicResource ComboBoxBackgroundBorderBrushFocused}" />

                            <TextBlock x:Name="PlaceholderTextBlock"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       IsVisible="False" />

                            <Grid
                                ColumnDefinitions="Auto * Auto"
                                x:Name="ContentPresenter"
                                Grid.Row="1"
                                Grid.Column="0"
                                MaxHeight="{TemplateBinding MaxSelectionBoxHeight}"
                                Background="{x:Null}"
                                Margin="{TemplateBinding Padding}">
                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="8,0"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding InnerLeftContent}"
                                    Foreground="{DynamicResource TextBoxInnerForeground}"
                                    IsVisible="{TemplateBinding InnerLeftContent,
                                                            Converter={x:Static ObjectConverters.IsNotNull}}" />

                                <ItemsControl
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ItemsSource="{TemplateBinding SelectedItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" Background="Transparent"
                                                       ItemSpacing="2" LineSpacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                MinHeight="28"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                ClipToBounds="True">
                                                <Grid ColumnDefinitions="Auto,34">
                                                    <ContentPresenter
                                                        Grid.Column="0"
                                                        Margin="10,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Content="{Binding}"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <Button
                                                        Grid.Column="1"
                                                        Theme="{StaticResource TransparentButton}"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        CornerRadius="0"
                                                        Command="{Binding $parent[sr:MultiComboBox].RemoveCommand}"
                                                        CommandParameter="{Binding}">
                                                        <sr:FluentIcon Glyph="{sr:Fi DismissFilled}" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ContentPresenter
                                    Grid.Column="2"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Content="{TemplateBinding InnerRightContent}"
                                    Foreground="{DynamicResource TextBoxInnerForeground}"
                                    IsVisible="{TemplateBinding InnerRightContent,
                                                            Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>

                            <Border x:Name="DropDownOverlay"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    Margin="-4,4,4,4"
                                    Width="30"
                                    IsVisible="False"
                                    HorizontalAlignment="Right" />

                            <ui:FAFontIcon x:Name="DropDownGlyph"
                                           Foreground="{DynamicResource ComboBoxDropDownGlyphForeground}"
                                           MinHeight="{DynamicResource MultiComboBoxMinHeight}"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           IsHitTestVisible="False"
                                           Margin="0 0 14 0"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="12"
                                           Glyph="&#xE70D;"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                            <Popup Name="PART_Popup"
                                   WindowManagerAddShadowHint="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                   PlacementTarget="Background"
                                   IsLightDismissEnabled="True"
                                   InheritsTransform="True">
                                <Border x:Name="PopupBorder"
                                        Background="{DynamicResource ComboBoxDropDownBackground}"
                                        BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
                                        BorderThickness="{DynamicResource MultiComboBoxDropdownBorderThickness}"
                                        Padding="{DynamicResource MultiComboBoxDropdownBorderPadding}"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="{DynamicResource OverlayCornerRadius}"
                                        BackgroundSizing="InnerBorderEdge">
                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                        IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        Margin="{DynamicResource MultiComboBoxDropdownContentMargin}"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ ScrollViewer#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PlaceholderTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxPlaceHolderForegroundPointerOver}" />
            </Style>
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundPointerOver}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrushPointerOver}" />
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Style Selector="^ /template/ ScrollViewer#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundPressed}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PlaceholderTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxPlaceHolderForegroundPressed}" />
            </Style>
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundPressed}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ ScrollViewer#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxHeaderForegroundDisabled}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PlaceholderTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxHeaderForegroundDisabled}" />
            </Style>
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrushDisabled}" />
            </Style>
            <Style Selector="^ /template/ ui|FAFontIcon#DropDownGlyph">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxDropDownGlyphForegroundDisabled}" />
            </Style>
        </Style>

        <Style Selector="^:focus-visible">
            <Style Selector="^ /template/ ScrollViewer#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxForegroundFocused}" />
            </Style>
            <Style Selector="^ /template/ Border#Pill">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PlaceholderTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxPlaceHolderForegroundFocused}" />
            </Style>
            <Style Selector="^ /template/ ui|FAFontIcon#DropDownGlyph">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxDropDownGlyphForegroundFocused}" />
            </Style>
        </Style>

        <Style Selector="^:error /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="sr:MultiComboBoxItem" x:Key="{x:Type sr:MultiComboBoxItem}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForeground}" />
        <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackground}" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <ControlTemplate TargetType="sr:MultiComboBoxItem">
                <Border
                    x:Name="RootBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinHeight="{TemplateBinding MinHeight}"
                    Margin="4,2,4,2"
                    TemplatedControl.IsTemplateFocusTarget="True">
                    <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Border x:Name="CheckBox"
                                Width="18"
                                Height="18"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CheckBoxCheckBackgroundFillUnchecked}"
                                BorderBrush="{DynamicResource CheckBoxCheckBackgroundStrokeUnchecked}"
                                BorderThickness="1">
                            <sr:FluentIcon x:Name="CheckGlyph"
                                           Glyph="{sr:Fi CheckmarkFilled}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource CheckBoxCheckGlyphForegroundUnchecked}"
                                           IsVisible="{TemplateBinding IsSelected}" />
                        </Border>

                        <ContentPresenter x:Name="ContentPresenter"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Left" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundPointerOver}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxItemBorderBrushPointerOver}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundPointerOver}" />
            </Style>
        </Style>

        <Style Selector="^:pressed">
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxItemBorderBrushPressed}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundPressed}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxItemBorderBrushDisabled}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundDisabled}" />
            </Style>
            <Style Selector="^ /template/ Border#CheckBox">
                <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillUncheckedDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedDisabled}" />
            </Style>
            <Style Selector="^ /template/ sr|FluentIcon#CheckGlyph">
                <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundUncheckedDisabled}" />
            </Style>
        </Style>

        <Style Selector="^:selected">
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxItemBorderBrushSelected}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundSelected}" />
            </Style>
            <Style Selector="^ /template/ Border#CheckBox">
                <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeChecked}" />
            </Style>
            <Style Selector="^ /template/ sr|FluentIcon#CheckGlyph">
                <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" />
            </Style>
        </Style>

        <!-- WinUI styles not implemented: SelectedUnfocused  -->

        <Style Selector="^:selected:disabled">
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelectedDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxItemBorderBrushSelectedDisabled}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundSelectedDisabled}" />
            </Style>
            <Style Selector="^ /template/ Border#CheckBox">
                <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeCheckedDisabled}" />
            </Style>
            <Style Selector="^ /template/ sr|FluentIcon#CheckGlyph">
                <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedDisabled}" />
            </Style>
        </Style>

        <Style Selector="^:selected:pointerover">
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelectedPointerOver}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxItemBorderBrushSelectedPointerOver}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundSelectedPointerOver}" />
            </Style>
            <Style Selector="^ /template/ Border#CheckBox">
                <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPointerOver}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeCheckedPointerOver}" />
            </Style>
            <Style Selector="^ /template/ sr|FluentIcon#CheckGlyph">
                <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" />
            </Style>
        </Style>

        <Style Selector="^:selected:pressed">
            <Style Selector="^ /template/ Border#RootBorder">
                <Setter Property="Background" Value="{DynamicResource ComboBoxItemBackgroundSelectedPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxItemBorderBrushSelectedPressed}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource ComboBoxItemForegroundSelectedPressed}" />
            </Style>
            <Style Selector="^ /template/ Border#CheckBox">
                <Setter Property="Background" Value="{DynamicResource CheckBoxCheckBackgroundFillCheckedPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeCheckedPressed}" />
            </Style>
            <Style Selector="^ /template/ sr|FluentIcon#CheckGlyph">
                <Setter Property="Foreground" Value="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
