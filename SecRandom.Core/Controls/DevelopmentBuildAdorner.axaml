<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core">
    <ControlTemplate x:Key="DevelopmentBuildAdornerControlTemplate"
                     TargetType="sr:DevelopmentBuildAdorner">
        <Grid VerticalAlignment="Stretch"
              IsHitTestVisible="False"
              HorizontalAlignment="Stretch">
            <TextBlock VerticalAlignment="Bottom"
                       HorizontalAlignment="Left"
                       FontSize="12"
                       Opacity="0.8">
                开发中画面，不代表最终品质。<LineBreak />
                SecRandom
                <Run Text="{x:Static sr:GlobalConstants.VersionLong}" />
            </TextBlock>
        </Grid>
    </ControlTemplate>

    <ControlTheme TargetType="sr:DevelopmentBuildAdorner"
                  x:Key="{x:Type sr:DevelopmentBuildAdorner}">
        <Setter Property="Template" Value="{StaticResource DevelopmentBuildAdornerControlTemplate}" />
    </ControlTheme>
</ResourceDictionary>