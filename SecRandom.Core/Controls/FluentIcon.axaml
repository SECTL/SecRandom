<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core">
    <Design.PreviewWith>
        <sr:FluentIcon />
    </Design.PreviewWith>

    <Style Selector="sr|FluentIcon">
        <Setter Property="FontFamily" Value="{DynamicResource FluentSystemIconsResizeable}" />
    </Style>
</Styles>