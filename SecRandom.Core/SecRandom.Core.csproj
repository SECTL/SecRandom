<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <FluentIconMappingFile>Assets/FluentSystemIcons-Resizable.json</FluentIconMappingFile>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="FluentIconMappingFile" />
        <AdditionalFiles Include="$(MSBuildProjectDirectory)\$(FluentIconMappingFile)" />
        <CompilerVisibleProperty Include="LucideIconMappingFile" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.6.0" />
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="DynamicData" Version="9.4.1" />
        <PackageReference Include="FlashCap" Version="1.11.0" />
        <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
        <PackageReference Include="Irihi.Ursa" Version="1.15.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.25.1" />
        <PackageReference Include="MiniExcel" Version="1.34.2" />
        <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260427" />
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
        <PackageReference Include="Pastel" Version="4.2.0" />
        <PackageReference Include="Xaml.Behaviors" Version="11.3.9.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SecRandom.Shared\SecRandom.Shared.csproj" />
        <ProjectReference Include="..\roslyn\IconsMappingGenerator\IconsMappingGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Langs\Common\Resources.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Langs\Common\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <None Include="..\data\cv_models\*.onnx" Link="data\cv_models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Import Project="..\Global.props" />

</Project>
