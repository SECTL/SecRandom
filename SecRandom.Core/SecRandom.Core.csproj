<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableGitInfoGenerator>true</EnableGitInfoGenerator>
    </PropertyGroup>

    <PropertyGroup>
        <FluentIconMappingFile>Assets/FluentSystemIcons-Resizable.json</FluentIconMappingFile>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="FluentIconMappingFile"/>
        <AdditionalFiles Include="$(MSBuildProjectDirectory)\$(FluentIconMappingFile)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.8.0"/>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="ClassIsland.Markdown.Avalonia" Version="12.0.0" />
        <PackageReference Include="DynamicData" Version="9.4.33" />
        <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
        <PackageReference Include="MiniExcel" Version="1.45.0" />
        <PackageReference Include="Pastel" Version="8.0.0" />
        <PackageReference Include="Xaml.Behaviors" Version="12.0.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SecRandom.Shared\SecRandom.Shared.csproj"/>
        <ProjectReference Include="..\roslyn\IconsMappingGenerator\IconsMappingGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Langs\Common\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Langs\Common\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <Import Project="..\Global.props"/>

</Project>
