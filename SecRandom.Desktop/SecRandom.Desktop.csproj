<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <EnableGitInfoGenerator>true</EnableGitInfoGenerator>
        <ApplicationIcon>..\SecRandom\Assets\AppLogo.ico</ApplicationIcon>
    </PropertyGroup>

    <Import Project="..\Platforms.props" />

    <!-- CameraView ships the Windows provider only for the Windows TFM. -->
    <PropertyGroup Condition="'$(SecRandomPlatform)' == 'Windows'">
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    </PropertyGroup>
    
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

    <PropertyGroup>
        <EnableUiAccess Condition="'$(EnableUiAccess)' == ''">false</EnableUiAccess>
        <ApplicationManifest Condition="'$(EnableUiAccess)' != 'true'">app.manifest</ApplicationManifest>
        <ApplicationManifest Condition="'$(EnableUiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="CameraView.Avalonia" Version="1.0.18" />
        <PackageReference Include="Sentry.Extensions.Logging" Version="6.8.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SecRandom\SecRandom.csproj">
            <AdditionalProperties>SecRandomBundleAssetsInAssembly=false</AdditionalProperties>
        </ProjectReference>
        <ProjectReference Include="..\SecRandom.Platforms\SecRandom.Platforms.csproj" />
        <ProjectReference Include="..\SecRandom.Platforms.Abstractions\SecRandom.Platforms.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(SecRandomPlatform)' == 'Windows'">
        <ProjectReference Include="..\SecRandom.Platforms.Windows\SecRandom.Platforms.Windows.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(SecRandomPlatform)' == 'Linux'">
        <ProjectReference Include="..\SecRandom.Platforms.Linux\SecRandom.Platforms.Linux.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(SecRandomPlatform)' == 'MacOs'">
        <ProjectReference Include="..\SecRandom.Platforms.MacOs\SecRandom.Platforms.MacOs.csproj" />
    </ItemGroup>

    <Import Project="..\Global.props"/>
</Project>
