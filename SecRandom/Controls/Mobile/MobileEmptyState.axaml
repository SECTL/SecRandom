<local:MobileEmptyState xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:SecRandom.Controls.Mobile"
                       x:Class="SecRandom.Controls.Mobile.MobileEmptyState">
    <StackPanel Spacing="14"
                HorizontalAlignment="Center"
                Margin="0,48,0,24">
        <TextBlock x:Name="Icon"
                    FontFamily="avares://SecRandom/Assets/Fonts/#FluentSystemIcons-Resizable"
                   FontSize="40"
                   LineHeight="40"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                    Opacity="0.72" />
        <TextBlock x:Name="TitleText"
                    FontSize="16"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                    TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionText"
                    FontSize="12"
                   TextAlignment="Center"
                    TextWrapping="Wrap" />
        <Button x:Name="ActionButton"
                 MinHeight="48"
                Classes="accent"
                FontWeight="SemiBold"
                HorizontalContentAlignment="Center" />
    </StackPanel>
</local:MobileEmptyState>
