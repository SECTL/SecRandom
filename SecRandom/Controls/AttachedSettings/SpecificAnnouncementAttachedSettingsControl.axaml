<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:local="clr-namespace:SecRandom.Controls.AttachedSettings"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
             x:Class="SecRandom.Controls.AttachedSettings.SpecificAnnouncementAttachedSettingsControl"
             x:Name="RootControl">
    <StackPanel Spacing="8"
                DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:SpecificAnnouncementAttachedSettingsControl}}">
        <sr:Field Label="TTS 别名">
            <TextBox Text="{Binding TtsAlias, Mode=TwoWay}"
                     PlaceholderText="留空则使用原名称" />
        </sr:Field>

        <sr:Field Label="播报前缀">
            <TextBox Text="{Binding Prefix, Mode=TwoWay}"
                     PlaceholderText="可选" />
        </sr:Field>

        <sr:Field Label="播报后缀">
            <TextBox Text="{Binding Suffix, Mode=TwoWay}"
                     PlaceholderText="可选" />
        </sr:Field>

        <TextBlock Text="启用附加设置后，这里的规则会覆盖语音与音乐页中的通用播报内容。"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
