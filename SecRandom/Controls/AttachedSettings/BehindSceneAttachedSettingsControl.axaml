<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:local="clr-namespace:SecRandom.Controls.AttachedSettings"
             xmlns:la="clr-namespace:SecRandom.Langs.AttachedSettings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Controls.AttachedSettings.BehindSceneAttachedSettingsControl"
             x:Name="RootControl">
    <StackPanel Spacing="6"
                DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:BehindSceneAttachedSettingsControl}}">
        <sr:Field Label="{x:Static la:Resources.C_Probability}">
            <NumericUpDown Value="{Binding ProbabilityValue, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="100"
                           Increment="1" />
        </sr:Field>

        <TextBlock Text="{x:Static la:Resources.C_ProbabilityDescription}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
