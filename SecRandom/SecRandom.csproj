<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <GenerateResourceDesigner>true</GenerateResourceDesigner>
        <HotAvaloniaIncludeExtensions>True</HotAvaloniaIncludeExtensions>
        <!-- These views are created with DI/state constructors and load AXAML into an existing instance. -->
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <HotAvaloniaAutoEnable>False</HotAvaloniaAutoEnable>
        <HotAvalonia Condition="'$(Configuration)' == 'Debug'">True</HotAvalonia>
        <SecRandomBundleAssetsInAssembly Condition="'$(SecRandomBundleAssetsInAssembly)' == ''">true</SecRandomBundleAssetsInAssembly>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" Condition="'$(SecRandomBundleAssetsInAssembly)' == 'true'" />
        <AvaloniaResource Include="Assets\Updates\release-public-key.txt"
                          Condition="'$(SecRandomBundleAssetsInAssembly)' != 'true'" />
        <None Update="Assets\**" Condition="'$(SecRandomBundleAssetsInAssembly)' != 'true'">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            <PublishFolderType>Resource</PublishFolderType>
        </None>
        <None Remove="Assets\Updates\release-public-key.txt" />
        <AvaloniaResource Remove="Views\SettingsPages\Plugins\Overview\PluginsSettingsPage.axaml" />
    </ItemGroup>

    <ItemGroup>
