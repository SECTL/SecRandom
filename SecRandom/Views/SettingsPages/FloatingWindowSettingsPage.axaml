<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.FloatingWindow"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.FloatingWindowSettingsPage"
             x:DataType="local:FloatingWindowSettingsPage"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText x:Name="S_Display"
                         Text="{x:Static lsp:Resources.S_Display}"
                         Glyph="{sr:Fi WindowRegular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Display_StartupDisplay"
                                   Header="{x:Static lsp:Resources.S_Display_StartupDisplay}"
                                   Description="{x:Static lsp:Resources.S_Display_StartupDisplay_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.StartupDisplayFloatingWindow}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Display_Opacity"
                                   Header="{x:Static lsp:Resources.S_Display_Opacity}"
                                   Description="{x:Static lsp:Resources.S_Display_Opacity_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.FloatingWindowOpacity}" Minimum="20" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Display_TopmostMode"
                                   Header="{x:Static lsp:Resources.S_Display_TopmostMode}"
                                   Description="{x:Static lsp:Resources.S_Display_TopmostMode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PinRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.FloatingWindowTopmostMode}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_TopmostMode_None}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_TopmostMode_Topmost}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_TopmostMode_UIAccess}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Buttons"
                         Text="{x:Static lsp:Resources.S_Buttons}"
                         Glyph="{sr:Fi FlashRegular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Buttons_EnabledItems"
                                   Header="{x:Static lsp:Resources.S_Buttons_EnabledItems}"
                                   Description="{x:Static lsp:Resources.S_Buttons_EnabledItems_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonRegular}}">
                <fa:FASettingsExpander.Footer>
                    <u:MultiComboBox MinWidth="260"
                                     ItemsSource="{Binding ButtonOptions}"
                                     SelectedItems="{Binding SelectedButtonOptions}"
                                     SelectionChanged="MultiSelect_OnSelectionChanged" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Buttons_Placement"
                                   Header="{x:Static lsp:Resources.S_Buttons_Placement}"
                                   Description="{x:Static lsp:Resources.S_Buttons_Placement_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi GridRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.FloatingWindowPlacement}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Placement_Rectangle}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Placement_Vertical}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Placement_Horizontal}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Buttons_DisplayStyle"
                                   Header="{x:Static lsp:Resources.S_Buttons_DisplayStyle}"
                                   Description="{x:Static lsp:Resources.S_Buttons_DisplayStyle_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextBulletListSquareRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.FloatingWindowDisplayStyle}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_DisplayStyle_IconText}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_DisplayStyle_Icon}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_DisplayStyle_Text}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Buttons_Size"
                                   Header="{x:Static lsp:Resources.S_Buttons_Size}"
                                   Description="{x:Static lsp:Resources.S_Buttons_Size_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ResizeLargeRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.FloatingWindowSize}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Size_XXS}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Size_XS}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Size_S}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Size_M}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Size_L}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Size_XL}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Size_XXL}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Interaction"
                         Text="{x:Static lsp:Resources.S_Interaction}"
                         Glyph="{sr:Fi GestureRegular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Interaction_Behaviors"
                                   Header="{x:Static lsp:Resources.S_Interaction}"
                                   IconSource="{sr:FluentIconSource {sr:Fi GestureRegular}}">
                <fa:FASettingsExpander.Footer>
                    <u:MultiComboBox MinWidth="260"
                                     ItemsSource="{Binding InteractionOptions}"
                                     SelectedItems="{Binding SelectedInteractionOptions}"
                                     SelectionChanged="MultiSelect_OnSelectionChanged" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Interaction_StickToEdgeRecoverSeconds"
                                   Header="{x:Static lsp:Resources.S_Interaction_StickToEdgeRecoverSeconds}"
                                   Description="{x:Static lsp:Resources.S_Interaction_StickToEdgeRecoverSeconds_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.StickToEdgeRecoverSeconds}" Minimum="0" Maximum="60" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Interaction_StickToEdgeDisplayStyle"
                                   Header="{x:Static lsp:Resources.S_Interaction_StickToEdgeDisplayStyle}"
                                   Description="{x:Static lsp:Resources.S_Interaction_StickToEdgeDisplayStyle_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DockRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.StickToEdgeDisplayStyle}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_StickDisplay_Icon}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_StickDisplay_Text}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_StickDisplay_Arrow}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Interaction_LongPressDuration"
                                   Header="{x:Static lsp:Resources.S_Interaction_LongPressDuration}"
                                   Description="{x:Static lsp:Resources.S_Interaction_LongPressDuration_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.LongPressDuration}" Minimum="100" Maximum="3000" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Interaction_HideOnForegroundWindowTitles"
                                   Header="{x:Static lsp:Resources.S_Interaction_HideOnForegroundWindowTitles}"
                                   Description="{x:Static lsp:Resources.S_Interaction_HideOnForegroundWindowTitles_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowRegular}}">
                <fa:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.HideOnForegroundWindowTitles}" MinWidth="260" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Interaction_HideOnForegroundProcessNames"
                                   Header="{x:Static lsp:Resources.S_Interaction_HideOnForegroundProcessNames}"
                                   Description="{x:Static lsp:Resources.S_Interaction_HideOnForegroundProcessNames_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowRegular}}">
                <fa:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.HideOnForegroundProcessNames}" MinWidth="260" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
