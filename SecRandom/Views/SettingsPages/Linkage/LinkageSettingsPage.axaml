<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
              xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Linkage"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Linkage"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="SecRandom.Views.SettingsPages.Linkage.LinkageSettingsPage"
             x:DataType="local:LinkageSettingsPage"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText x:Name="S_External"
                         Text="{x:Static lsp:Resources.S_External}"
                         Glyph="{sr:Fi LinkFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_External_VerificationRequired"
                                   Header="{x:Static lsp:Resources.S_External_VerificationRequired}"
                                   Description="{x:Static lsp:Resources.S_External_VerificationRequired_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi LinkFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.VerificationRequired}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_External_InstantDrawDisable"
                                   Header="{x:Static lsp:Resources.S_External_InstantDrawDisable}"
                                   Description="{x:Static lsp:Resources.S_External_InstantDrawDisable_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.InstantDrawDisable}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_External_DataSource"
                                   Header="{x:Static lsp:Resources.S_External_DataSource}"
                                   Description="{x:Static lsp:Resources.S_External_DataSource_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DatabaseFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DataSource}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_DataSource_Off}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_DataSource_ClassIsland}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_DataSource_UrlProtocol}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_ClassTime"
                         Text="{x:Static lsp:Resources.S_ClassTime}"
                         Glyph="{sr:Fi ArrowSyncFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_ClassTime_HideFloatingWindow"
                                   Header="{x:Static lsp:Resources.S_ClassTime_HideFloatingWindow}"
                                   Description="{x:Static lsp:Resources.S_ClassTime_HideFloatingWindow_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.HideFloatingWindowOnClassEnd}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ClassTime_PreClassReset"
                                   Header="{x:Static lsp:Resources.S_ClassTime_PreClassReset}"
                                   Description="{x:Static lsp:Resources.S_ClassTime_PreClassReset_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ArrowSyncFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.PreClassResetEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ClassTime_PreClassResetTime"
                                   Header="{x:Static lsp:Resources.S_ClassTime_PreClassResetTime}"
                                   Description="{x:Static lsp:Resources.S_ClassTime_PreClassResetTime_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimePickerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.PreClassResetTime}" Minimum="0" Maximum="3600" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ClassTime_PreClassEnableTime"
                                   Header="{x:Static lsp:Resources.S_ClassTime_PreClassEnableTime}"
                                   Description="{x:Static lsp:Resources.S_ClassTime_PreClassEnableTime_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi CalendarLtrFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.PreClassEnableTime}" Minimum="0" Maximum="3600" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ClassTime_PostClassDisableDelay"
                                   Header="{x:Static lsp:Resources.S_ClassTime_PostClassDisableDelay}"
                                   Description="{x:Static lsp:Resources.S_ClassTime_PostClassDisableDelay_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.PostClassDisableDelay}" Minimum="0" Maximum="3600" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_SubjectHistory"
                         Text="{x:Static lsp:Resources.S_SubjectHistory}"
                         Glyph="{sr:Fi PeopleListFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_SubjectHistory_Filter"
                                   Header="{x:Static lsp:Resources.S_SubjectHistory_Filter}"
                                   Description="{x:Static lsp:Resources.S_SubjectHistory_Filter_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PeopleListFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.SubjectHistoryFilterEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_SubjectHistory_BreakAssignment"
                                   Header="{x:Static lsp:Resources.S_SubjectHistory_BreakAssignment}"
                                   Description="{x:Static lsp:Resources.S_SubjectHistory_BreakAssignment_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PeopleListFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.SubjectHistoryBreakAssignment}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_BreakAssignment_Break}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_BreakAssignment_PreviousClass}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_BreakAssignment_NextClass}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
