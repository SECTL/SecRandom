<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Linkage"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Linkage"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="560"
             x:Class="SecRandom.Views.SettingsPages.Linkage.CourseRosterSettingsPage"
             x:DataType="local:CourseRosterSettingsPage"
             x:Name="Root"
             Loaded="OnLoaded">
    <Grid RowDefinitions="Auto *" RowSpacing="8" Classes="page-container animated-intro">
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">
                <fa:FACommandBar Grid.Column="0" DefaultLabelPosition="Right">
                    <fa:FACommandBar.PrimaryCommands>
                        <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi AddFilled}}"
                                               Label="{x:Static lsp:Resources.C_AddCourse}"
                                               Click="AddCourse_OnClick" />
                        <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi ArrowSyncFilled}}"
                                               Label="{x:Static lsp:Resources.C_RefreshCourseRoster}"
                                               Click="Refresh_OnClick" />
                    </fa:FACommandBar.PrimaryCommands>
                </fa:FACommandBar>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0 0 12 0">
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox Width="200" Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="{x:Static lsp:Resources.M_CourseSearch}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="4" ClipToBounds="True"
                IsVisible="{Binding HasRows}">
            <DataGrid x:Name="S_CourseRoster_Bindings" MinHeight="320"
                      AutoGenerateColumns="False" CanUserSortColumns="True"
                      CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                      IsReadOnly="False" ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2*" MinWidth="140"
                                        Header="{x:Static lsp:Resources.C_Course}"
                                        Binding="{Binding CourseName}" IsReadOnly="True" />
                    <DataGridTemplateColumn Width="*" MinWidth="150"
                                            Header="{x:Static lsp:Resources.C_RollCallList}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:CourseRosterRow">
                                <ComboBox ItemsSource="{Binding StudentListOptions}"
                                          SelectedItem="{Binding SelectedRollCallStudentList, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:CourseRosterListOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*" MinWidth="150"
                                            Header="{x:Static lsp:Resources.C_QuickDrawList}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:CourseRosterRow">
                                <ComboBox ItemsSource="{Binding StudentListOptions}"
                                          SelectedItem="{Binding SelectedQuickDrawStudentList, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:CourseRosterListOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*" MinWidth="150"
                                            Header="{x:Static lsp:Resources.C_LotteryPool}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:CourseRosterRow">
                                <ComboBox ItemsSource="{Binding PrizeListOptions}"
                                          SelectedItem="{Binding SelectedLotteryPrizeList, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="local:CourseRosterListOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                   IsVisible="{Binding !HasRows}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 24"
                   Opacity="0.7" TextWrapping="Wrap" />
    </Grid>
</UserControl>
