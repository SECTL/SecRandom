<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Linkage"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Linkage.IntegrationChannelsSettingsPage"
             x:DataType="local:IntegrationChannelsSettingsPage"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings" Spacing="12">
            <sr:IconText x:Name="S_IntegrationChannels"
                         Text="{Binding IntegrationChannelsTitle}"
                         Glyph="{sr:Fi PlugConnectedFilled}" />
            <TextBlock Text="{Binding IntegrationChannelsDescription}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <Button HorizontalAlignment="Left"
                    Content="{Binding IntegrationChannelsScanLabel}"
                    Click="DiscoverIntegrationChannels_OnClick" />
            <TextBlock Text="{Binding IntegrationChannelsEmptyText}"
                       IsVisible="{Binding NoIntegrationChannels}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding IntegrationChannels}"
                          IsVisible="{Binding HasIntegrationChannels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:IntegrationChannelRow">
                        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="0 0 0 1" Padding="0 4">
                            <Expander>
                                <Expander.Header>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="40">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" Opacity="0.72" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                                                   VerticalAlignment="Center" Opacity="0.72" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="10" Margin="12 4 8 8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Channel.AppId}" Opacity="0.62"
                                                   FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="{Binding RenameLabel}"
                                                    Click="RenameIntegrationChannel_OnClick" />
                                            <Button Content="{Binding RemoveLabel}"
                                                    Click="RemoveIntegrationChannel_OnClick" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 24 0">
                                            <TextBlock Text="{Binding DeliveryLabel}" VerticalAlignment="Center" />
                                            <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          ToolTip.Tip="{Binding EnabledTooltip}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding LinkageLabel}" VerticalAlignment="Center" />
                                            <ToggleSwitch IsChecked="{Binding IsLinkageEnabled, Mode=TwoWay}"
                                                          ToolTip.Tip="{Binding LinkageTooltip}" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
