<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SecRandom.ViewModels"
             xmlns:conv="using:SecRandom.Converters"
             xmlns:langs="using:SecRandom.Langs.MainPages.History"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="SecRandom.Views.SettingsPages.History.RollCallHistorySettingsPage"
             x:DataType="vm:RollCallHistoryViewModel"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <conv:HistoryModeNameConverter x:Key="ModeNameConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="12 0 18 12" RowSpacing="8">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <ComboBox MinWidth="200"
                      PlaceholderText="{x:Static langs:Resources.C_SelectClass}"
                      ItemsSource="{Binding ClassNames}"
                      SelectedItem="{Binding SelectedClassName, Mode=TwoWay}" />
            <ComboBox MinWidth="160"
                      PlaceholderText="{x:Static langs:Resources.C_SelectMode}"
                      ItemsSource="{Binding ModeOptions}"
                      SelectedValue="{Binding SelectedMode, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Key}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{x:Static langs:Resources.C_Refresh}"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <DataGrid x:Name="HistoryGrid"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ItemsSource="{Binding Rows}">
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="DataGridCell TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="TextAlignment" Value="Center" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="180" MinWidth="170" IsVisible="False"
                                        Header="{x:Static langs:Resources.H_DrawTime}"
                                        SortMemberPath="SortTime"
                                        Binding="{Binding DrawTime}" />
                    <DataGridTextColumn Width="*" IsVisible="True"
                                        Header="{x:Static langs:Resources.H_StudentId}"
                                        SortMemberPath="IdSortValue"
                                        Binding="{Binding Id}" />
                    <DataGridTextColumn Width="1.5*" IsVisible="True"
                                        Header="{x:Static langs:Resources.H_Name}"
                                        SortMemberPath="Name"
                                        Binding="{Binding Name}" />
                    <DataGridTextColumn Width="*" IsVisible="True"
                                        Header="{x:Static langs:Resources.H_Gender}"
                                        SortMemberPath="Gender"
                                        Binding="{Binding Gender}" />
                    <DataGridTextColumn Width="*" IsVisible="True"
                                        Header="{x:Static langs:Resources.H_Group}"
                                        SortMemberPath="GroupSortValue"
                                        Binding="{Binding Group}" />
                    <DataGridTextColumn Width="*" IsVisible="True"
                                        Header="{x:Static langs:Resources.H_TotalCountRollCall}"
                                        SortMemberPath="TotalCount"
                                        Binding="{Binding TotalCount}" />
                    <DataGridTextColumn Width="1.2*" IsVisible="False"
                                        Header="{x:Static langs:Resources.H_DrawMode}"
                                        SortMemberPath="DrawMethod"
                                        Binding="{Binding DrawMethod}" />
                    <DataGridTextColumn Width="*" IsVisible="False"
                                        Header="{x:Static langs:Resources.H_DrawNumbers}"
                                        SortMemberPath="DrawNumbers"
                                        Binding="{Binding DrawNumbers}" />
                    <DataGridTextColumn Width="*" IsVisible="False"
                                        Header="{x:Static langs:Resources.H_GenderLimit}"
                                        SortMemberPath="DrawGender"
                                        Binding="{Binding DrawGender}" />
                    <DataGridTextColumn Width="*" IsVisible="False"
                                        Header="{x:Static langs:Resources.H_GroupLimit}"
                                        SortMemberPath="DrawGroupSortValue"
                                        Binding="{Binding DrawGroup}" />
                    <DataGridTextColumn Width="*" IsVisible="False"
                                        Header="{x:Static langs:Resources.H_Weight}"
                                        SortMemberPath="WeightSortValue"
                                        Binding="{Binding Weight}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
