<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
              xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.History"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.HistoryManagement"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="SecRandom.Views.SettingsPages.History.HistoryManagementSettingsPage"
              x:DataType="local:HistoryManagementSettingsPage"
              Loaded="OnLoaded"
              Unloaded="OnUnloaded">
    <UserControl.Styles>
        <!-- 行内两步删除：第一次点击后该行保持高亮，直到第二次点击确认。 -->
        <Style Selector="Border.history-group-row.deleting">
            <Setter Property="Background" Value="#22C42B1C" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText x:Name="S_HistoryGroups"
                         Text="{x:Static lsp:Resources.S_HistoryGroups}"
                         Glyph="{sr:Fi HistoryFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_HistoryGroups_Enabled"
                                   Header="{x:Static lsp:Resources.S_HistoryGroups_Enabled}"
                                   Description="{x:Static lsp:Resources.S_HistoryGroups_Enabled_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi HistoryFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding HistoryGroups.Enabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_HistoryGroups_Manage"
                                   Header="{x:Static lsp:Resources.S_HistoryGroups_Manage}"
                                   Description="{x:Static lsp:Resources.S_HistoryGroups_Manage_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi HistoryFilled}}"
                                   IsVisible="{Binding HistoryGroups.Enabled}">

                <!-- 展开后第一行就是"添加"：先加，再往下看全部组 -->
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_HistoryGroups_Add}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="NewHistoryGroupNameBox" MinWidth="200"
                                     PlaceholderText="{x:Static lsp:Resources.S_HistoryGroups_Add}" />
                            <Button Content="{x:Static lsp:Resources.S_HistoryGroups_Add}"
                                    Click="CreateHistoryGroup_OnClick" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!-- 全部记录组：只在这里列出、改名、两步确认删除 -->
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_HistoryGroups_Existing}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="8" MinWidth="380">
                            <TextBlock x:Name="HistoryGroupEmptyHint"
                                       Text="{x:Static lsp:Resources.S_HistoryGroups_Empty}"
                                       Opacity="0.7" />
                            <ItemsControl ItemsSource="{Binding HistoryGroupRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:HistoryGroupRow">
                                        <Border Classes="history-group-row" Classes.deleting="{Binding IsDeleting}"
                                                Padding="8 6" CornerRadius="4" Margin="0 0 0 4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                                                            IsVisible="{Binding !IsRenaming}">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding CountText}" Opacity="0.7" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center" IsVisible="{Binding IsRenaming}">
                                                    <TextBox Text="{Binding RenameText, Mode=TwoWay}" MinWidth="160" />
                                                    <Button Content="{x:Static lsp:Resources.S_HistoryGroups_Save}"
                                                            Click="SaveHistoryGroupRename_OnClick" />
                                                    <Button Content="{x:Static lsp:Resources.S_HistoryGroups_Cancel}"
                                                            Click="CancelHistoryGroupRename_OnClick" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}">
                                                    <Button Content="{x:Static lsp:Resources.S_HistoryGroups_Rename}"
                                                            Click="RenameHistoryGroup_OnClick" />
                                                    <Button Content="{x:Static lsp:Resources.S_HistoryGroups_Delete}"
                                                            Click="DeleteHistoryGroup_OnClick"
                                                            IsVisible="{Binding !IsDeleting}" />
                                                    <Button Content="{x:Static lsp:Resources.S_HistoryGroups_ConfirmDelete}"
                                                            Click="DeleteHistoryGroup_OnClick"
                                                            IsVisible="{Binding IsDeleting}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="HistoryGroupMessageText" IsVisible="False" TextWrapping="Wrap"
                                       Opacity="0.85" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_ExportHistory"
                         Text="{x:Static lsp:Resources.S_ExportHistory}"
                         Glyph="{sr:Fi ArrowDownloadFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_ExportHistory_RollCall"
                                   Header="{x:Static lsp:Resources.S_ExportHistory_RollCall}"
                                   Description="{x:Static lsp:Resources.S_ExportHistory_RollCall_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Button Content="{x:Static lsp:Resources.C_Export}"
                            Click="ExportRollCallHistory_OnClick" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_ExportProfiles}">
                    <fa:FASettingsExpanderItem.Footer>
                        <sr:MultiComboBox x:Name="ExportRollCallProfiles"
                                          MinWidth="280"
                                          PlaceholderText="{x:Static lsp:Resources.C_ExportProfiles}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="ExportRollCallSubjectRow"
                                           Content="{x:Static lsp:Resources.C_ExportSubject}"
                                           IsVisible="False">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="ExportRollCallSubject" MinWidth="220" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_ExportTimeRange}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="ExportRollCallRange"
                                  MinWidth="180"
                                  SelectionChanged="ExportRollCallRange_OnSelectionChanged" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="ExportRollCallFromRow"
                                           Content="{x:Static lsp:Resources.C_ExportStartDate}"
                                           IsVisible="False">
                    <fa:FASettingsExpanderItem.Footer>
                        <DatePicker x:Name="ExportRollCallFrom" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="ExportRollCallToRow"
                                           Content="{x:Static lsp:Resources.C_ExportEndDate}"
                                           IsVisible="False">
                    <fa:FASettingsExpanderItem.Footer>
                        <DatePicker x:Name="ExportRollCallTo" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_ExportSort}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="ExportRollCallSort" MinWidth="180" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_ExportFormat}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="ExportRollCallFormat" MinWidth="180" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ExportHistory_Lottery"
                                   Header="{x:Static lsp:Resources.S_ExportHistory_Lottery}"
                                   Description="{x:Static lsp:Resources.S_ExportHistory_Lottery_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi LotteryFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Button Content="{x:Static lsp:Resources.C_Export}"
                            Click="ExportLotteryHistory_OnClick" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_ExportProfiles}">
                    <fa:FASettingsExpanderItem.Footer>
                        <sr:MultiComboBox x:Name="ExportLotteryProfiles"
                                          MinWidth="280"
                                          PlaceholderText="{x:Static lsp:Resources.C_ExportProfiles}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_ExportTimeRange}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="ExportLotteryRange"
                                  MinWidth="180"
                                  SelectionChanged="ExportLotteryRange_OnSelectionChanged" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="ExportLotteryFromRow"
                                           Content="{x:Static lsp:Resources.C_ExportStartDate}"
                                           IsVisible="False">
                    <fa:FASettingsExpanderItem.Footer>
                        <DatePicker x:Name="ExportLotteryFrom" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="ExportLotteryToRow"
                                           Content="{x:Static lsp:Resources.C_ExportEndDate}"
                                           IsVisible="False">
                    <fa:FASettingsExpanderItem.Footer>
                        <DatePicker x:Name="ExportLotteryTo" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_ExportSort}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="ExportLotterySort" MinWidth="180" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_ExportFormat}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox x:Name="ExportLotteryFormat" MinWidth="180" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <sr:IconText x:Name="S_ClearHistory"
                         Text="{x:Static lsp:Resources.S_ClearHistory}"
                         Glyph="{sr:Fi DeleteFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_ClearHistory_RollCall"
                                   Header="{x:Static lsp:Resources.S_ClearHistory_RollCall}"
                                   Description="{x:Static lsp:Resources.S_ClearHistory_RollCall_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="RollCallClassCombo" MinWidth="180" />
                        <Button Content="{x:Static lsp:Resources.C_Clear}"
                                Click="ClearRollCallHistory_OnClick" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_ClearHistory_Lottery"
                                   Header="{x:Static lsp:Resources.S_ClearHistory_Lottery}"
                                   Description="{x:Static lsp:Resources.S_ClearHistory_Lottery_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi LotteryFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="LotteryPoolCombo" MinWidth="180" />
                        <Button Content="{x:Static lsp:Resources.C_Clear}"
                                Click="ClearLotteryHistory_OnClick" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
