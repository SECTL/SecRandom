<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lp="clr-namespace:SecRandom.Langs.SettingsPages.Picking"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Picking"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Picking.RollCallDrawSettingsPage"
             x:DataType="local:RollCallDrawSettingsPage"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText Text="{x:Static lp:Resources.Section_Draw}" Glyph="{sr:Fi FlashRegular}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DrawMode}"
                                   Description="{x:Static lp:Resources.S_DrawMode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DrawMode}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Repeat}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_NoRepeat}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_HalfRepeat}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_HalfRepeat}"
                                   Description="{x:Static lp:Resources.S_HalfRepeat_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ClipboardBulletListRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.HalfRepeat}" Minimum="0" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DrawType}"
                                   Description="{x:Static lp:Resources.S_DrawType_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DrawType}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Random}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Fair}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DefaultClass}"
                                   Description="{x:Static lp:Resources.S_DefaultClass_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PeopleListRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox ItemsSource="{Binding StudentListNames}" SelectedItem="{Binding Settings.DefaultClass}"
                              MinWidth="220" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Overridable}" Glyph="{sr:Fi LayerRegular}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.Section_Display}"
                                   Description="{x:Static lp:Resources.Section_Display}"
                                   IsExpanded="{Binding Settings.OverrideDisplaySettings, Mode=OneWay}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch OnContent="{x:Static lp:Resources.C_EnableOverride}"
                                  OffContent="{x:Static lp:Resources.C_EnableOverride}"
                                  IsChecked="{Binding Settings.OverrideDisplaySettings}" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_FontSource}"
                                           Description="{x:Static lp:Resources.S_FontSource_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedIndex="{Binding Settings.UseGlobalFont}">
                            <ComboBoxItem Content="{x:Static lp:Resources.O_FollowGlobal}" />
                            <ComboBoxItem Content="{x:Static lp:Resources.O_Custom}" />
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_CustomFont}"
                                           Description="{x:Static lp:Resources.S_CustomFont_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <sr:FontComboBox Value="{Binding Settings.CustomFont}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_FontSize}"
                                           Description="{x:Static lp:Resources.S_FontSize_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <NumericUpDown Value="{Binding Settings.FontSize}" Minimum="1" Maximum="300" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_DisplayFormat}"
                                           Description="{x:Static lp:Resources.S_DisplayFormat_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox SelectedIndex="{Binding Settings.DisplayFormat}">
                            <ComboBoxItem Content="{x:Static lp:Resources.O_Both}" />
                            <ComboBoxItem Content="{x:Static lp:Resources.O_Name}" />
                            <ComboBoxItem Content="{x:Static lp:Resources.O_Id}" />
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_ShowTags}"
                                           Description="{x:Static lp:Resources.S_ShowTags_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.ShowTags}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.Section_Reminder}"
                                   Description="{x:Static lp:Resources.Section_Reminder}"
                                   IsExpanded="{Binding Settings.OverrideReminderSettings, Mode=OneWay}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch OnContent="{x:Static lp:Resources.C_EnableOverride}"
                                  OffContent="{x:Static lp:Resources.C_EnableOverride}"
                                  IsChecked="{Binding Settings.OverrideReminderSettings}" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_ReminderText}"
                                           Description="{x:Static lp:Resources.S_ReminderText_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBox Text="{Binding Settings.ReminderText}" MinWidth="180" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_ReminderFontSize}"
                                           Description="{x:Static lp:Resources.S_ReminderFontSize_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <NumericUpDown Value="{Binding Settings.ReminderFontSize}" Minimum="10" Maximum="500" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_ReminderTextColor}"
                                           Description="{x:Static lp:Resources.S_ReminderTextColor_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ColorPicker Color="{Binding Settings.ReminderTextColor}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lp:Resources.S_ReminderTextOpacity}"
                                           Description="{x:Static lp:Resources.S_ReminderTextOpacity_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <NumericUpDown Value="{Binding Settings.ReminderTextOpacity}" Minimum="0" Maximum="100" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
