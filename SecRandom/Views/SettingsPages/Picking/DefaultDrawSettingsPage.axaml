<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lp="clr-namespace:SecRandom.Langs.SettingsPages.Picking"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Picking"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Picking.DefaultDrawSettingsPage"
             x:DataType="local:DefaultDrawSettingsPage"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText Text="{x:Static lp:Resources.Section_Draw}" Glyph="{sr:Fi FlashRegular}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DrawMode}"
                                   Description="{x:Static lp:Resources.S_DrawMode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DrawMode}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Repeat}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_NoRepeat}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_HalfRepeat}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_HalfRepeat}"
                                   Description="{x:Static lp:Resources.S_HalfRepeat_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ClipboardBulletListRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.HalfRepeat}" Minimum="0" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ClearRecord}"
                                   Description="{x:Static lp:Resources.S_ClearRecord_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi HistoryRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.ClearRecord}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Restarted}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Cleared}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Display}" Glyph="{sr:Fi TextFontRegular}"
                          Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_FontSource}"
                                   Description="{x:Static lp:Resources.S_FontSource_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.UseGlobalFont}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_FollowGlobal}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Custom}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DisplayStyle}"
                                   Description="{x:Static lp:Resources.S_DisplayStyle_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi CardUiRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DisplayStyle}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Default}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Card}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ShowRandom}"
                                   Description="{x:Static lp:Resources.S_ShowRandom_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi SlidePlayRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.ShowRandom}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_None}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_BreakLine}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Hyphen}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ShowWeightTransparency}"
                                   Description="{x:Static lp:Resources.S_ShowWeightTransparency_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DataHistogramRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowWeightTransparency}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_CustomFont}"
                                   Description="{x:Static lp:Resources.S_CustomFont_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <sr:FontComboBox Value="{Binding Settings.CustomFont}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_FontSize}"
                                   Description="{x:Static lp:Resources.S_FontSize_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.FontSize}" Minimum="1" Maximum="300" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DisplayFormat}"
                                   Description="{x:Static lp:Resources.S_DisplayFormat_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DisplayFormat}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Both}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Name}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Id}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ShowTags}"
                                   Description="{x:Static lp:Resources.S_ShowTags_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TagRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowTags}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Animation}" Glyph="{sr:Fi FlashRegular}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_Animation}" Description="{x:Static lp:Resources.S_Animation_D}" IconSource="{sr:FluentIconSource {sr:Fi FlashRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.Animation}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_ManualStop}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AutoPlay}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_NoAnimation}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AnimationInterval}" Description="{x:Static lp:Resources.S_AnimationInterval_D}" IconSource="{sr:FluentIconSource {sr:Fi TimerRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AnimationInterval}" Minimum="1" Maximum="10000" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AutoplayCount}" Description="{x:Static lp:Resources.S_AutoplayCount_D}" IconSource="{sr:FluentIconSource {sr:Fi NumberSymbolRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AutoplayCount}" Minimum="1" Maximum="999" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AnimationEnabled}" Description="{x:Static lp:Resources.S_AnimationEnabled_D}" IconSource="{sr:FluentIconSource {sr:Fi SlidePlayRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AnimationEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AnimationStyle}" Description="{x:Static lp:Resources.S_AnimationStyle_D}" IconSource="{sr:FluentIconSource {sr:Fi SlidePlayRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.AnimationStyle}" MinWidth="180">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationFadeFloat}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationFlipRoll}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationSpotlightSweep}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationFireworks}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationShuffleDeck}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationWheelFreeze}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationDirectRotate}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AnimationDuration}" Description="{x:Static lp:Resources.S_AnimationDuration_D}" IconSource="{sr:FluentIconSource {sr:Fi TimerRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AnimationDuration}" Minimum="0" Maximum="10000" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Color}" Glyph="{sr:Fi ColorRegular}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ColorTheme}" Description="{x:Static lp:Resources.S_ColorTheme_D}" IconSource="{sr:FluentIconSource {sr:Fi ColorRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.AnimationColorTheme}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_NoColor}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_RandomColor}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_FixedColor}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_FixedColor}" Description="{x:Static lp:Resources.S_FixedColor_D}" IconSource="{sr:FluentIconSource {sr:Fi ColorRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ColorPicker Color="{Binding Settings.AnimationFixedColor}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_StudentImage}" Glyph="{sr:Fi ImageRegular}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_StudentImage}" Description="{x:Static lp:Resources.S_StudentImage_D}" IconSource="{sr:FluentIconSource {sr:Fi ImageRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.StudentImage}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_StudentImagePosition}" Description="{x:Static lp:Resources.S_StudentImagePosition_D}" IconSource="{sr:FluentIconSource {sr:Fi ImageRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.StudentImagePosition}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Left}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Top}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Right}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Bottom}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Music}" Glyph="{sr:Fi Speaker2Regular}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AnimationMusic}" Description="{x:Static lp:Resources.S_AnimationMusic_D}" IconSource="{sr:FluentIconSource {sr:Fi Speaker2Regular}}">
                <fa:FASettingsExpander.Footer><TextBox Text="{Binding Settings.AnimationMusic}" MinWidth="260" /></fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ResultMusic}" Description="{x:Static lp:Resources.S_ResultMusic_D}" IconSource="{sr:FluentIconSource {sr:Fi Speaker2Regular}}">
                <fa:FASettingsExpander.Footer><TextBox Text="{Binding Settings.ResultMusic}" MinWidth="260" /></fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_MusicVolume}" Description="{x:Static lp:Resources.S_MusicVolume_D}" IconSource="{sr:FluentIconSource {sr:Fi Speaker2Regular}}">
                <fa:FASettingsExpander.Footer><StackPanel Orientation="Horizontal" Spacing="4"><NumericUpDown Value="{Binding Settings.AnimationMusicVolume}" Minimum="0" Maximum="100" /><NumericUpDown Value="{Binding Settings.ResultMusicVolume}" Minimum="0" Maximum="100" /></StackPanel></fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_MusicFadeInOut}" Description="{x:Static lp:Resources.S_MusicFadeInOut_D}" IconSource="{sr:FluentIconSource {sr:Fi Speaker2Regular}}">
                <fa:FASettingsExpander.Footer><StackPanel Orientation="Horizontal" Spacing="4"><NumericUpDown Value="{Binding Settings.AnimationMusicFadeIn}" Minimum="0" Maximum="10000" /><NumericUpDown Value="{Binding Settings.AnimationMusicFadeOut}" Minimum="0" Maximum="10000" /><NumericUpDown Value="{Binding Settings.ResultMusicFadeIn}" Minimum="0" Maximum="10000" /><NumericUpDown Value="{Binding Settings.ResultMusicFadeOut}" Minimum="0" Maximum="10000" /></StackPanel></fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Reminder}" Glyph="{sr:Fi TextFontRegular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ReminderText}"
                                   Description="{x:Static lp:Resources.S_ReminderText_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.ReminderText}" MinWidth="180" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ReminderFontSize}"
                                   Description="{x:Static lp:Resources.S_ReminderFontSize_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.ReminderFontSize}" Minimum="10" Maximum="500" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ReminderTextColor}"
                                   Description="{x:Static lp:Resources.S_ReminderTextColor_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ColorPicker Color="{Binding Settings.ReminderTextColor}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ReminderTextOpacity}"
                                   Description="{x:Static lp:Resources.S_ReminderTextOpacity_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi SlidePlayRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.ReminderTextOpacity}" Minimum="0" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
