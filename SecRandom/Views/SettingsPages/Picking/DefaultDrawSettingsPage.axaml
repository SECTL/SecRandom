<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lp="clr-namespace:SecRandom.Langs.SettingsPages.Picking"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Picking"
             xmlns:enums="clr-namespace:SecRandom.Core.Enums.Configs;assembly=SecRandom.Core"
             xmlns:converters="clr-namespace:SecRandom.Core.Converters;assembly=SecRandom.Core"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Picking.DefaultDrawSettingsPage"
              x:DataType="local:DefaultDrawSettingsPage"
              Loaded="OnLoaded"
              Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText Text="{x:Static lp:Resources.Section_Draw}" Glyph="{sr:Fi FlashFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DrawMode}"
                                   Description="{x:Static lp:Resources.S_DrawMode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DrawMode}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Repeat}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_NoRepeat}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_HalfRepeat}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_HalfRepeat}"
                                    Description="{x:Static lp:Resources.S_HalfRepeat_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi ClipboardBulletListFilled}}"
                                    IsVisible="{Binding Settings.DrawMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:DrawMode.HalfRepeat}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.HalfRepeat}" Minimum="0" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Display}" Glyph="{sr:Fi TextFontFilled}"
                          Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_FontSource}"
                                    Description="{x:Static lp:Resources.S_FontSource_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.UseGlobalFont}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_FollowGlobal}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Custom}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_CustomFont}"
                                    Description="{x:Static lp:Resources.S_CustomFont_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}"
                                    IsVisible="{Binding Settings.UseGlobalFont, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:UseGlobalFontMode.Custom}}">
                <fa:FASettingsExpander.Footer>
                    <sr:FontComboBox Value="{Binding Settings.CustomFont}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DisplayStyle}"
                                    Description="{x:Static lp:Resources.S_DisplayStyle_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi CardUiFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DisplayStyle}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Default}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Card}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ShowWeightTransparency}"
                                    Description="{x:Static lp:Resources.S_ShowWeightTransparency_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi DataHistogramFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowWeightTransparency}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_FontSize}"
                                    Description="{x:Static lp:Resources.S_FontSize_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.FontSize}" Minimum="1" Maximum="300" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_DisplayFormat}"
                                   Description="{x:Static lp:Resources.S_DisplayFormat_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DisplayFormat}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Both}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Name}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Id}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ShowTags}"
                                   Description="{x:Static lp:Resources.S_ShowTags_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TagFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowTags}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Animation}" Glyph="{sr:Fi FlashFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_Animation}" Description="{x:Static lp:Resources.S_Animation_D}" IconSource="{sr:FluentIconSource {sr:Fi FlashFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.Animation}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_ManualStop}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AutoPlay}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_NoAnimation}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AnimationInterval}" Description="{x:Static lp:Resources.S_AnimationInterval_D}" IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}" IsVisible="{Binding Settings.Animation, Converter={x:Static converters:AnimationModeConverters.IsAnimated}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AnimationInterval}" Minimum="1" Maximum="10000" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AutoplayCount}" Description="{x:Static lp:Resources.S_AutoplayCount_D}" IconSource="{sr:FluentIconSource {sr:Fi NumberSymbolFilled}}" IsVisible="{Binding Settings.Animation, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:AnimationMode.AutoPlay}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AutoplayCount}" Minimum="1" Maximum="999" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_AnimationStyle}" Description="{x:Static lp:Resources.S_AnimationStyle_D}" IconSource="{sr:FluentIconSource {sr:Fi SlidePlayFilled}}" IsVisible="{Binding Settings.Animation, Converter={x:Static converters:AnimationModeConverters.IsAnimated}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.AnimationStyle}" MinWidth="180">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationDirectRotate}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationFadeFloat}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_AnimationHorizontalShake}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Color}" Glyph="{sr:Fi ColorFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ColorTheme}" Description="{x:Static lp:Resources.S_ColorTheme_D}" IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.AnimationColorTheme}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_NoColor}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_RandomColor}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_FixedColor}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_FixedColor}" Description="{x:Static lp:Resources.S_FixedColor_D}" IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}" IsVisible="{Binding Settings.AnimationColorTheme, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:AnimationColorThemeMode.Fixed}}">
                <fa:FASettingsExpander.Footer>
                    <ColorPicker Color="{Binding Settings.AnimationFixedColor}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_StudentImage}" Glyph="{sr:Fi ImageFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_StudentImage}" Description="{x:Static lp:Resources.S_StudentImage_D}" IconSource="{sr:FluentIconSource {sr:Fi ImageFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.StudentImage}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_StudentImagePosition}" Description="{x:Static lp:Resources.S_StudentImagePosition_D}" IconSource="{sr:FluentIconSource {sr:Fi ImageFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.StudentImagePosition}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Left}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Top}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Right}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_Bottom}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Music}" Glyph="{sr:Fi Speaker2Filled}" Margin="0 0 0 4" />
            <local:DrawMusicSettingsExpander Header="{x:Static lp:Resources.Section_Music}"
                                             Description="{x:Static lp:Resources.Section_Music}"
                                             IconSource="{sr:FluentIconSource {sr:Fi Speaker2Filled}}"
                                             IsExpanded="True"
                                             Settings="{Binding Settings}"
                                             MusicSelections="{Binding MusicSelections}" />

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_VoiceAnnouncement}" Glyph="{sr:Fi PersonVoiceFilled}" Margin="0 0 0 4" />
            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_VoiceAnnouncementEnabled}"
                                    Description="{x:Static lp:Resources.S_VoiceAnnouncementEnabled_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi PersonVoiceFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.VoiceAnnouncementEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lp:Resources.Section_Reminder}" Glyph="{sr:Fi TextFontFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ReminderText}"
                                   Description="{x:Static lp:Resources.S_ReminderText_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.ReminderText}" MinWidth="180" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ReminderFontSize}"
                                   Description="{x:Static lp:Resources.S_ReminderFontSize_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.ReminderFontSize}" Minimum="10" Maximum="500" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ReminderTextColor}"
                                   Description="{x:Static lp:Resources.S_ReminderTextColor_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ColorPicker Color="{Binding Settings.ReminderTextColor}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lp:Resources.S_ReminderTextOpacity}"
                                   Description="{x:Static lp:Resources.S_ReminderTextOpacity_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi SlidePlayFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.ReminderTextOpacity}" Minimum="0" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
