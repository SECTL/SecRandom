<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Picking"
             xmlns:lc="clr-namespace:SecRandom.Langs.Common"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Picking.FaceDetectorSettingsPage"
             x:DataType="local:FaceDetectorSettingsPage"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <TextBlock Text="{x:Static lc:Resources.Settings_FaceDetector_CameraGroup}"
                       Classes="subtitle" />
            <fa:FASettingsExpander Header="{x:Static lc:Resources.Settings_FaceDetector_CameraSource}"
                                   Description="{x:Static lc:Resources.Settings_FaceDetector_CameraSource_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi CameraFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox x:Name="CameraComboBox"
                              MinWidth="220"
                              SelectionChanged="CameraComboBox_OnSelectionChanged" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="{x:Static lc:Resources.Settings_FaceDetector_Resolution}"
                                   Description="{x:Static lc:Resources.Settings_FaceDetector_Resolution_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ResizeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox x:Name="ResolutionComboBox"
                              MinWidth="220"
                              SelectionChanged="ResolutionComboBox_OnSelectionChanged" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <TextBlock Text="{x:Static lc:Resources.Settings_FaceDetector_DetectionGroup}"
                       Classes="subtitle" />
            <fa:FASettingsExpander Header="{x:Static lc:Resources.Settings_FaceDetector_DetectorMode}"
                                   Description="{x:Static lc:Resources.Settings_FaceDetector_DetectorMode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi VideoPersonSparkleFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.DetectorMode}" MinWidth="220">
                        <ComboBoxItem Content="{x:Static lc:Resources.Settings_FaceDetector_DetectorMode_Lightweight}" />
                        <ComboBoxItem Content="{x:Static lc:Resources.Settings_FaceDetector_DetectorMode_Enhanced}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <TextBlock Text="{x:Static lc:Resources.Settings_FaceDetector_PickingGroup}"
                       Classes="subtitle" />
            <fa:FASettingsExpander Header="{x:Static lc:Resources.Settings_FaceDetector_PreviewMode}"
                                   Description="{x:Static lc:Resources.Settings_FaceDetector_PreviewMode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi VideoPersonSparkleFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.CameraPreviewMode}">
                        <ComboBoxItem Content="{x:Static lc:Resources.Settings_FaceDetector_PreviewMode_Pick}" />
                        <ComboBoxItem Content="{x:Static lc:Resources.Settings_FaceDetector_PreviewMode_Always}" />
                        <ComboBoxItem Content="{x:Static lc:Resources.Settings_FaceDetector_PreviewMode_Hidden}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="{x:Static lc:Resources.Settings_FaceDetector_Duration}"
                                   Description="{x:Static lc:Resources.Settings_FaceDetector_Duration_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.PickingDurationSeconds}" Minimum="1" Maximum="60" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="{x:Static lc:Resources.Settings_FaceDetector_ProcessAudio}"
                                   Description="{x:Static lc:Resources.Settings_FaceDetector_ProcessAudio_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Filled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.PlayProcessAudio}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="{x:Static lc:Resources.Settings_FaceDetector_ResultAudio}"
                                   Description="{x:Static lc:Resources.Settings_FaceDetector_ResultAudio_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Filled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.PlayResultAudio}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="{x:Static lc:Resources.Settings_FaceDetector_FrameColor}"
                                   Description="{x:Static lc:Resources.Settings_FaceDetector_FrameColor_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ColorPicker Color="{Binding Settings.PickerFrameColor}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
