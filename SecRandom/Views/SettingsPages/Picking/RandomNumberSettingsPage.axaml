<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lp="clr-namespace:SecRandom.Langs.SettingsPages.Picking"
             xmlns:vm="using:SecRandom.ViewModels.SettingsPages"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Picking.RandomNumberSettingsPage"
             x:DataType="vm:RandomNumberSettingsPageViewModel"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText Text="{x:Static lp:Resources.Section_RandomNumber_Defaults}"
                         Glyph="{sr:Fi FlashFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_RandomNumber_RollCallRange"
                                   Header="{x:Static lp:Resources.S_RandomNumber_RollCallRange}"
                                   Description="{x:Static lp:Resources.S_RandomNumber_RollCallRange_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PeopleListFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <NumericUpDown Value="{Binding Settings.RollCallRangeStart}" Minimum="0"
                                       Maximum="1000000" Width="150" />
                        <TextBlock Text="{x:Static lp:Resources.C_RandomNumber_To}"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Settings.RollCallRangeEnd}" Minimum="0"
                                       Maximum="1000000" Width="150" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RandomNumber_LotteryRange"
                                   Header="{x:Static lp:Resources.S_RandomNumber_LotteryRange}"
                                   Description="{x:Static lp:Resources.S_RandomNumber_LotteryRange_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi GiftFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <NumericUpDown Value="{Binding Settings.LotteryRangeStart}" Minimum="0"
                                       Maximum="1000000" Width="150" />
                        <TextBlock Text="{x:Static lp:Resources.C_RandomNumber_To}"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Settings.LotteryRangeEnd}" Minimum="0"
                                       Maximum="1000000" Width="150" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RandomNumber_ResetBehavior"
                                   Header="{x:Static lp:Resources.S_RandomNumber_ResetBehavior}"
                                   Description="{x:Static lp:Resources.S_RandomNumber_ResetBehavior_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ArrowClockwiseFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.ResetBehavior}">
                        <ComboBoxItem Content="{x:Static lp:Resources.O_RandomNumber_ResetTemporaryOnly}" />
                        <ComboBoxItem Content="{x:Static lp:Resources.O_RandomNumber_ResetTemporaryAndStatistics}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>