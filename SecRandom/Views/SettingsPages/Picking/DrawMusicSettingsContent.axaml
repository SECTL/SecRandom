<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Picking"
             xmlns:lp="clr-namespace:SecRandom.Langs.SettingsPages.Picking"
              xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
              x:Class="SecRandom.Views.SettingsPages.Picking.DrawMusicSettingsContent"
              x:Name="Root"
              x:DataType="local:DrawMusicSettingsContent">
    <StackPanel>
        <Grid ColumnDefinitions="*,220" ColumnSpacing="16" Margin="0 4">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Static lp:Resources.S_AnimationMusic}" />
                <TextBlock Text="{x:Static lp:Resources.S_AnimationMusic_D}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Right"
                      ItemsSource="{Binding MusicSelections, ElementName=Root}"
                      SelectedValue="{Binding Settings.AnimationMusic, ElementName=Root, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Id}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock MaxWidth="184" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="*,220" ColumnSpacing="16" Margin="0 8 0 4">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Static lp:Resources.S_ResultMusic}" />
                <TextBlock Text="{x:Static lp:Resources.S_ResultMusic_D}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Right"
                      ItemsSource="{Binding MusicSelections, ElementName=Root}"
                      SelectedValue="{Binding Settings.ResultMusic, ElementName=Root, Mode=TwoWay}"
                      SelectedValueBinding="{Binding Id}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock MaxWidth="184" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Separator Margin="0 8" />
        <Grid ColumnDefinitions="*,220,56" ColumnSpacing="12" Margin="0 4">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Static lp:Resources.S_AnimationMusicVolume}" />
                <TextBlock Text="{x:Static lp:Resources.S_AnimationMusicVolume_D}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding Settings.AnimationMusicVolume, ElementName=Root, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Settings.AnimationMusicVolume, ElementName=Root, StringFormat={}{0}%}" />
        </Grid>
        <Grid ColumnDefinitions="*,220,56" ColumnSpacing="12" Margin="0 8 0 4">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Static lp:Resources.S_ResultMusicVolume}" />
                <TextBlock Text="{x:Static lp:Resources.S_ResultMusicVolume_D}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding Settings.ResultMusicVolume, ElementName=Root, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Settings.ResultMusicVolume, ElementName=Root, StringFormat={}{0}%}" />
        </Grid>
        <Separator Margin="0 8" />
        <Grid ColumnDefinitions="*,44,180,64" ColumnSpacing="8" Margin="0 4">
            <StackPanel Spacing="2"><TextBlock Text="{x:Static lp:Resources.S_AnimationMusicFade}" /><TextBlock Text="{x:Static lp:Resources.S_AnimationMusicFade_D}" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Static lp:Resources.C_FadeIn}" VerticalAlignment="Center" />
            <Slider Grid.Column="2" Minimum="0" Maximum="10000" TickFrequency="100" Value="{Binding Settings.AnimationMusicFadeIn, ElementName=Root, Mode=TwoWay}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Settings.AnimationMusicFadeIn, ElementName=Root, StringFormat={}{0} ms}" />
        </Grid>
        <Grid ColumnDefinitions="*,44,180,64" ColumnSpacing="8" Margin="0 4">
            <TextBlock Text="{x:Static lp:Resources.S_AnimationMusicFade}" Opacity="0" />
            <TextBlock Grid.Column="1" Text="{x:Static lp:Resources.C_FadeOut}" VerticalAlignment="Center" />
            <Slider Grid.Column="2" Minimum="0" Maximum="10000" TickFrequency="100" Value="{Binding Settings.AnimationMusicFadeOut, ElementName=Root, Mode=TwoWay}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Settings.AnimationMusicFadeOut, ElementName=Root, StringFormat={}{0} ms}" />
        </Grid>
        <Grid ColumnDefinitions="*,44,180,64" ColumnSpacing="8" Margin="0 8 0 4">
            <StackPanel Spacing="2"><TextBlock Text="{x:Static lp:Resources.S_ResultMusicFade}" /><TextBlock Text="{x:Static lp:Resources.S_ResultMusicFade_D}" Opacity="0.7" TextWrapping="Wrap" /></StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Static lp:Resources.C_FadeIn}" VerticalAlignment="Center" />
            <Slider Grid.Column="2" Minimum="0" Maximum="10000" TickFrequency="100" Value="{Binding Settings.ResultMusicFadeIn, ElementName=Root, Mode=TwoWay}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Settings.ResultMusicFadeIn, ElementName=Root, StringFormat={}{0} ms}" />
        </Grid>
        <Grid ColumnDefinitions="*,44,180,64" ColumnSpacing="8" Margin="0 4">
            <TextBlock Text="{x:Static lp:Resources.S_ResultMusicFade}" Opacity="0" />
            <TextBlock Grid.Column="1" Text="{x:Static lp:Resources.C_FadeOut}" VerticalAlignment="Center" />
            <Slider Grid.Column="2" Minimum="0" Maximum="10000" TickFrequency="100" Value="{Binding Settings.ResultMusicFadeOut, ElementName=Root, Mode=TwoWay}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right" Text="{Binding Settings.ResultMusicFadeOut, ElementName=Root, StringFormat={}{0} ms}" />
        </Grid>
    </StackPanel>
</UserControl>
