<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.DebugSettingsPage">
    <UserControl.Resources>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <fa:FASettingsExpander IconSource="{sr:FluentIconSource &#xE06F;}"
                                   Header="UI 功能测试" IsExpanded="True">
                <fa:FASettingsExpanderItem Content="发送 Toast" IsClickEnabled="True"
                                           Click="SendToast_OnClick" />
                <fa:FASettingsExpanderItem Content="打开 Drawer" IsClickEnabled="True"
                                           Click="OpenDrawer_Test" />
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>