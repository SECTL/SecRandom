<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Personalized.Timer"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:personalized="clr-namespace:SecRandom.Views.SettingsPages.Personalized"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Personalized.TimerSettingsPage"
             x:DataType="personalized:TimerSettingsPage"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText Text="{x:Static lsp:Resources.Page_Title}"
                         Glyph="{sr:Fi TimerFilled}"
                         Margin="0 0 0 4" />

            <!-- 这一行就是自动缩小的总开关：界面上没有另一处开关，关掉它计时就只留大窗 -->
            <fa:FASettingsExpander x:Name="S_AutoMiniWindow"
                                   Header="{x:Static lsp:Resources.S_AutoMiniWindow}"
                                   Description="{x:Static lsp:Resources.S_AutoMiniWindow_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ArrowMinimizeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AutoMiniWindowEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 阈值按"计时开始之后走过了多久"算（不是剩余多少），与页面文案同一口径 -->
            <fa:FASettingsExpander x:Name="S_AutoMiniWindow_Seconds"
                                   Header="{x:Static lsp:Resources.S_AutoMiniWindow_Seconds}"
                                   Description="{x:Static lsp:Resources.S_AutoMiniWindow_Seconds_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AutoMiniWindowAfterSeconds}"
                                   Minimum="{Binding MinimumAutoMiniWindowSeconds}"
                                   Maximum="{Binding MaximumAutoMiniWindowSeconds}"
                                   Increment="1"
                                   MinWidth="160" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
