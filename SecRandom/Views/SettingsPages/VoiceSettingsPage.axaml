<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages"
             xmlns:lc="clr-namespace:SecRandom.Langs.Common"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Voice"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.VoiceSettingsPage"
             x:DataType="local:VoiceSettingsPage"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText x:Name="S_Playback"
                         Text="{x:Static lsp:Resources.S_Playback}"
                         Glyph="{sr:Fi PersonVoiceRegular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Playback_Enable"
                                   Header="{x:Static lsp:Resources.S_Playback_Enable}"
                                   Description="{x:Static lsp:Resources.S_Playback_Enable_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Regular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.VoiceEnable}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Engine"
                                   Header="{x:Static lsp:Resources.S_Playback_Engine}"
                                   Description="{x:Static lsp:Resources.S_Playback_Engine_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonVoiceRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="220"
                              ItemsSource="{Binding VoiceEngineOptions}"
                              SelectedIndex="{Binding Settings.VoiceEngine, Mode=TwoWay}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Voice"
                                   Header="音色"
                                   Description="根据当前语音引擎显示可用音色。"
                                   IconSource="{sr:FluentIconSource {sr:Fi MicRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="300"
                              IsEnabled="{Binding !IsLoadingCurrentVoices}"
                              ItemsSource="{Binding CurrentVoiceOptions}"
                              SelectedItem="{Binding SelectedVoice, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Description}"
                                               Opacity="0.7"
                                               FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="语音操作"
                                   Description="刷新可用音色，或按当前设置试听播报。"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonVoiceRegular}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="刷新音色" Click="RefreshVoicesButton_OnClick" />
                        <Button Classes="accent" Content="试听" Click="TestVoiceButton_OnClick" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Volume"
                                   Header="{x:Static lsp:Resources.S_Playback_Volume}"
                                   Description="{x:Static lsp:Resources.S_Playback_Volume_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Regular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.VolumeSize}" Minimum="0" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_SpeechRate"
                                   Header="{x:Static lsp:Resources.S_Playback_SpeechRate}"
                                   Description="{x:Static lsp:Resources.S_Playback_SpeechRate_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TopSpeedRegular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.SpeechRate}" Minimum="50" Maximum="200" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_WaitComplete"
                                   Header="{x:Static lsp:Resources.S_Playback_WaitComplete}"
                                   Description="{x:Static lsp:Resources.S_Playback_WaitComplete_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.VoiceWaitComplete}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_SystemVolume"
                         Text="{x:Static lsp:Resources.S_SystemVolume}"
                         Glyph="{sr:Fi Speaker2Regular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_SystemVolume_Control"
                                   Header="{x:Static lsp:Resources.S_SystemVolume_Control}"
                                   Description="{x:Static lsp:Resources.S_SystemVolume_Control_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi SpeakerOffRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.SystemVolumeControl}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_SystemVolume_Size"
                                   Header="{x:Static lsp:Resources.S_SystemVolume_Size}"
                                   Description="{x:Static lsp:Resources.S_SystemVolume_Size_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Regular}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.SystemVolumeSize}" Minimum="0" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Music"
                         Text="{x:Static lc:Resources.Settings_Music}"
                         Glyph="{sr:Fi MusicNote2Regular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Music_BackgroundLoop"
                                   Header="{x:Static lc:Resources.Settings_BackgroundMusicLoop}"
                                   Description="{x:Static lc:Resources.Settings_BackgroundMusicLoop_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi MusicNote2Regular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding MoreSettings.BackgroundMusicLoop}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Content"
                         Text="{x:Static lsp:Resources.S_Content}"
                         Glyph="{sr:Fi TextFontRegular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Content_SpecificAnnouncements"
                                   Header="{x:Static lsp:Resources.S_Content_SpecificAnnouncements}"
                                   Description="{x:Static lsp:Resources.S_Content_SpecificAnnouncements_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.SpecificAnnouncementsEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Content_AnnounceId"
                                   Header="{x:Static lsp:Resources.S_Content_AnnounceId}"
                                   Description="{x:Static lsp:Resources.S_Content_AnnounceId_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AnnounceId}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Content_AnnounceName"
                                   Header="{x:Static lsp:Resources.S_Content_AnnounceName}"
                                   Description="{x:Static lsp:Resources.S_Content_AnnounceName_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AnnounceName}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Content_Prefix"
                                   Header="{x:Static lsp:Resources.S_Content_Prefix}"
                                   Description="{x:Static lsp:Resources.S_Content_Prefix_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.AnnouncementPrefix}" MinWidth="220" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Content_Suffix"
                                   Header="{x:Static lsp:Resources.S_Content_Suffix}"
                                   Description="{x:Static lsp:Resources.S_Content_Suffix_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontRegular}}">
                <fa:FASettingsExpander.Footer>
                    <TextBox Text="{Binding Settings.AnnouncementSuffix}" MinWidth="220" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
