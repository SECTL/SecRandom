<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Notification"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:notification="clr-namespace:SecRandom.Views.SettingsPages.Notification"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Notification.NotificationSettingsPage"
             x:DataType="notification:NotificationSettingsPage"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText x:Name="S_RollCall"
                         Text="{x:Static lsp:Resources.S_RollCall}"
                         Glyph="{sr:Fi PersonFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_RollCall_Enabled"
                                   Header="{x:Static lsp:Resources.S_RollCall_Enabled}"
                                   Description="{x:Static lsp:Resources.S_RollCall_Enabled_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.RollCall.Enabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RollCall_Animation"
                                   Header="{x:Static lsp:Resources.S_RollCall_Animation}"
                                   Description="{x:Static lsp:Resources.S_RollCall_Animation_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.RollCall.Animation}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RollCall_AutoCloseTime"
                                   Header="{x:Static lsp:Resources.S_RollCall_AutoCloseTime}"
                                   Description="{x:Static lsp:Resources.S_RollCall_AutoCloseTime_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.RollCall.AutoCloseTime}" Minimum="1" Maximum="60" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RollCall_WindowPosition"
                                   Header="{x:Static lsp:Resources.S_RollCall_WindowPosition}"
                                   Description="{x:Static lsp:Resources.S_RollCall_WindowPosition_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.RollCall.WindowPosition}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Center}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Top}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Bottom}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Left}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Right}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RollCall_Offset"
                                   Header="{x:Static lsp:Resources.S_RollCall_Offset}"
                                   Description="{x:Static lsp:Resources.S_RollCall_Offset_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PositionToBackFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <NumericUpDown Value="{Binding Settings.RollCall.HorizontalOffset}" Minimum="-2000" Maximum="2000" />
                        <NumericUpDown Value="{Binding Settings.RollCall.VerticalOffset}" Minimum="-2000" Maximum="2000" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RollCall_Transparency"
                                   Header="{x:Static lsp:Resources.S_RollCall_Transparency}"
                                   Description="{x:Static lsp:Resources.S_RollCall_Transparency_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.RollCall.Transparency}" Minimum="20" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RollCall_DisplayDuration"
                                   Header="{x:Static lsp:Resources.S_RollCall_DisplayDuration}"
                                   Description="{x:Static lsp:Resources.S_RollCall_DisplayDuration_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimePickerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.RollCall.DisplayDuration}" Minimum="1" Maximum="60" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RollCall_UseMainWindowWhenExceedThreshold"
                                   Header="{x:Static lsp:Resources.S_RollCall_UseMainWindowWhenExceedThreshold}"
                                   Description="{x:Static lsp:Resources.S_RollCall_UseMainWindowWhenExceedThreshold_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.RollCall.UseMainWindowWhenExceedThreshold}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RollCall_MainWindowDisplayThreshold"
                                   Header="{x:Static lsp:Resources.S_RollCall_MainWindowDisplayThreshold}"
                                   Description="{x:Static lsp:Resources.S_RollCall_MainWindowDisplayThreshold_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.RollCall.MainWindowDisplayThreshold}" Minimum="1" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_QuickDraw"
                         Text="{x:Static lsp:Resources.S_QuickDraw}"
                         Glyph="{sr:Fi FlashFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_QuickDraw_Enabled"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_Enabled}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_Enabled_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.QuickDraw.Enabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_QuickDraw_AutoCloseTime"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_AutoCloseTime}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_AutoCloseTime_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.QuickDraw.AutoCloseTime}" Minimum="1" Maximum="60" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_QuickDraw_Animation"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_Animation}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_Animation_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.QuickDraw.Animation}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_QuickDraw_WindowPosition"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_WindowPosition}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_WindowPosition_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.QuickDraw.WindowPosition}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Center}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Top}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Bottom}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Left}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Right}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_QuickDraw_Offset"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_Offset}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_Offset_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PositionToBackFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <NumericUpDown Value="{Binding Settings.QuickDraw.HorizontalOffset}" Minimum="-2000" Maximum="2000" />
                        <NumericUpDown Value="{Binding Settings.QuickDraw.VerticalOffset}" Minimum="-2000" Maximum="2000" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_QuickDraw_Transparency"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_Transparency}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_Transparency_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.QuickDraw.Transparency}" Minimum="20" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_QuickDraw_DisplayDuration"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_DisplayDuration}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_DisplayDuration_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimePickerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.QuickDraw.DisplayDuration}" Minimum="1" Maximum="60" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_QuickDraw_UseMainWindowWhenExceedThreshold"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_UseMainWindowWhenExceedThreshold}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_UseMainWindowWhenExceedThreshold_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.QuickDraw.UseMainWindowWhenExceedThreshold}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_QuickDraw_MainWindowDisplayThreshold"
                                   Header="{x:Static lsp:Resources.S_QuickDraw_MainWindowDisplayThreshold}"
                                   Description="{x:Static lsp:Resources.S_QuickDraw_MainWindowDisplayThreshold_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.QuickDraw.MainWindowDisplayThreshold}" Minimum="1" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Lottery"
                         Text="{x:Static lsp:Resources.S_Lottery}"
                         Glyph="{sr:Fi LotteryFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Lottery_Enabled"
                                   Header="{x:Static lsp:Resources.S_Lottery_Enabled}"
                                   Description="{x:Static lsp:Resources.S_Lottery_Enabled_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi LotteryFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Lottery.Enabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Lottery_AutoCloseTime"
                                   Header="{x:Static lsp:Resources.S_Lottery_AutoCloseTime}"
                                   Description="{x:Static lsp:Resources.S_Lottery_AutoCloseTime_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.Lottery.AutoCloseTime}" Minimum="1" Maximum="60" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Lottery_Animation"
                                   Header="{x:Static lsp:Resources.S_Lottery_Animation}"
                                   Description="{x:Static lsp:Resources.S_Lottery_Animation_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FlashFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Lottery.Animation}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Lottery_WindowPosition"
                                   Header="{x:Static lsp:Resources.S_Lottery_WindowPosition}"
                                   Description="{x:Static lsp:Resources.S_Lottery_WindowPosition_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.Lottery.WindowPosition}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Center}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Top}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Bottom}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Left}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Right}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Lottery_Offset"
                                   Header="{x:Static lsp:Resources.S_Lottery_Offset}"
                                   Description="{x:Static lsp:Resources.S_Lottery_Offset_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PositionToBackFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <NumericUpDown Value="{Binding Settings.Lottery.HorizontalOffset}" Minimum="-2000" Maximum="2000" />
                        <NumericUpDown Value="{Binding Settings.Lottery.VerticalOffset}" Minimum="-2000" Maximum="2000" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Lottery_Transparency"
                                   Header="{x:Static lsp:Resources.S_Lottery_Transparency}"
                                   Description="{x:Static lsp:Resources.S_Lottery_Transparency_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.Lottery.Transparency}" Minimum="20" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Lottery_DisplayDuration"
                                   Header="{x:Static lsp:Resources.S_Lottery_DisplayDuration}"
                                   Description="{x:Static lsp:Resources.S_Lottery_DisplayDuration_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimePickerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.Lottery.DisplayDuration}" Minimum="1" Maximum="60" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Lottery_UseMainWindowWhenExceedThreshold"
                                   Header="{x:Static lsp:Resources.S_Lottery_UseMainWindowWhenExceedThreshold}"
                                   Description="{x:Static lsp:Resources.S_Lottery_UseMainWindowWhenExceedThreshold_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Lottery.UseMainWindowWhenExceedThreshold}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Lottery_MainWindowDisplayThreshold"
                                   Header="{x:Static lsp:Resources.S_Lottery_MainWindowDisplayThreshold}"
                                   Description="{x:Static lsp:Resources.S_Lottery_MainWindowDisplayThreshold_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.Lottery.MainWindowDisplayThreshold}" Minimum="1" Maximum="100" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
