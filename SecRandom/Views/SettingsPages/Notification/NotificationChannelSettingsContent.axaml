<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Notification"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
              xmlns:notification="clr-namespace:SecRandom.Views.SettingsPages.Notification"
              x:Class="SecRandom.Views.SettingsPages.Notification.NotificationChannelSettingsContent"
              x:DataType="notification:NotificationChannelSettingsPageBase">
    <StackPanel Classes="page-container animated-intro settings">
        <fa:FASettingsExpander x:Name="S_Common_Test" Header="{Binding TestTitle}"
                               Description="{Binding TestDescription}"
                               IconSource="{sr:FluentIconSource {sr:Fi PlayFilled}}">
            <fa:FASettingsExpander.Footer>
                <Button Classes="accent"
                        Content="{Binding TestButtonText}"
                        Click="TestNotification_OnClick" />
            </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>

        <sr:IconText Text="{Binding BasicSettingsTitle}"
                     Glyph="{sr:Fi SettingsFilled}"
                     Margin="0 0 0 4" />

        <fa:FASettingsExpander x:Name="S_Default_Enabled" Header="{Binding EnabledTitle}"
                               Description="{Binding EnabledDescription}"
                               IconSource="{sr:FluentIconSource {sr:Fi CommentNoteFilled}}">
            <fa:FASettingsExpander.Footer>
                <ToggleSwitch IsChecked="{Binding ChannelSettings.Enabled}" />
            </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>

        <fa:FASettingsExpander x:Name="S_Default_Animation" Header="{Binding AnimationTitle}"
                               Description="{Binding AnimationDescription}"
                               IconSource="{sr:FluentIconSource {sr:Fi FlashFilled}}">
            <fa:FASettingsExpander.Footer>
                <ToggleSwitch IsChecked="{Binding ChannelSettings.Animation}" />
            </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>

        <Separator Margin="0 12 0 4" />
        <sr:IconText Text="{Binding OverridableSettingsTitle}"
                     Glyph="{sr:Fi SettingsFilled}"
                     Margin="0 0 0 4" />

        <fa:FASettingsExpander x:Name="S_Default_NotificationService" Header="{Binding NotificationServiceTitle}"
                               IsExpanded="{Binding OverrideServiceSettings, Mode=OneWay}"
                               IconSource="{sr:FluentIconSource {sr:Fi CommentNoteFilled}}">
            <fa:FASettingsExpander.Footer>
                <ToggleSwitch IsVisible="{Binding CanOverride}"
                              OnContent="{Binding OverrideTitle}"
                              OffContent="{Binding OverrideTitle}"
                              IsChecked="{Binding OverrideServiceSettings}" />
            </fa:FASettingsExpander.Footer>

            <fa:FASettingsExpanderItem x:Name="S_Default_NotificationServiceType" Content="{Binding NotificationServiceTypeTitle}"
                                       Description="{Binding NotificationServiceTypeDescription}">
                <fa:FASettingsExpanderItem.Footer>
                    <ComboBox ItemsSource="{Binding NotificationServiceOptions}"
                              SelectedItem="{Binding SelectedNotificationServiceOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem x:Name="S_Default_NotificationServiceFailureFallback" Content="{Binding NotificationServiceFailureFallbackTitle}"
                                        Description="{Binding NotificationServiceFailureFallbackDescription}"
                                         IsVisible="{Binding UsesExternalNotificationServiceOnly}">
                <fa:FASettingsExpanderItem.Footer>
                    <ToggleSwitch IsChecked="{Binding ChannelSettings.UseBuiltInOnServiceFailure}" />
                </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem x:Name="S_Default_DisplayDuration" Content="{Binding DisplayDurationTitle}"
                                       Description="{Binding DisplayDurationDescription}">
                <fa:FASettingsExpanderItem.Footer>
                    <NumericUpDown Value="{Binding ChannelSettings.DisplayDuration}" Minimum="1" Maximum="60" />
                </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem x:Name="S_Default_UseMainWindowWhenExceedThreshold" Content="{Binding UseMainWindowWhenExceedThresholdTitle}"
                                       Description="{Binding UseMainWindowWhenExceedThresholdDescription}">
                <fa:FASettingsExpanderItem.Footer>
                    <ToggleSwitch IsChecked="{Binding ChannelSettings.UseMainWindowWhenExceedThreshold}" />
                </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>

            <fa:FASettingsExpanderItem x:Name="S_Default_MainWindowDisplayThreshold" Content="{Binding MainWindowDisplayThresholdTitle}"
                                       Description="{Binding MainWindowDisplayThresholdDescription}">
                <fa:FASettingsExpanderItem.Footer>
                    <NumericUpDown Value="{Binding ChannelSettings.MainWindowDisplayThreshold}" Minimum="1" Maximum="100" />
                </fa:FASettingsExpanderItem.Footer>
            </fa:FASettingsExpanderItem>
        </fa:FASettingsExpander>
    </StackPanel>
</UserControl>
