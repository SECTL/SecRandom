<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Voice"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:notification="clr-namespace:SecRandom.Views.SettingsPages.Notification"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="SecRandom.Views.SettingsPages.Notification.VoiceSettingsPage"
              x:DataType="notification:VoiceSettingsPage"
              Loaded="OnLoaded"
              Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText x:Name="S_Playback"
                         Text="{x:Static lsp:Resources.S_Playback}"
                         Glyph="{sr:Fi PersonVoiceFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Playback_Enable"
                                   Header="{x:Static lsp:Resources.S_Playback_Enable}"
                                   Description="{x:Static lsp:Resources.S_Playback_Enable_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Filled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.VoiceEnable}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Engine"
                                   Header="{x:Static lsp:Resources.S_Playback_Engine}"
                                   Description="{x:Static lsp:Resources.S_Playback_Engine_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonVoiceFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="220"
                               ItemsSource="{Binding VoiceEngineOptions}"
                               SelectedValue="{Binding Settings.VoiceEngine, Mode=TwoWay}"
                               SelectedValueBinding="{Binding Id}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Voice"
                                    Header="{x:Static lsp:Resources.S_Playback_Voice}"
                                    Description="{x:Static lsp:Resources.S_Playback_Voice_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi MicFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="300"
                              IsEnabled="{Binding !IsLoadingCurrentVoices}"
                              ItemsSource="{Binding CurrentVoiceOptions}"
                              SelectedValue="{Binding SelectedVoiceId, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Id}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Description}"
                                               Opacity="0.7"
                                               FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Actions"
                                    Header="{x:Static lsp:Resources.S_Playback_Actions}"
                                    Description="{x:Static lsp:Resources.S_Playback_Actions_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonVoiceFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static lsp:Resources.C_RefreshVoices}" Click="RefreshVoicesButton_OnClick" />
                        <Button Classes="accent" Content="{x:Static lsp:Resources.C_TestVoice}" Click="TestVoiceButton_OnClick" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Volume"
                                   Header="{x:Static lsp:Resources.S_Playback_Volume}"
                                   Description="{x:Static lsp:Resources.S_Playback_Volume_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Filled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="0"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Settings.VolumeSize, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32"
                                       TextAlignment="Right"
                                       Text="{Binding Settings.VolumeSize}" />
                            <TextBlock Text="%" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_SpeechRate"
                                   Header="{x:Static lsp:Resources.S_Playback_SpeechRate}"
                                   Description="{x:Static lsp:Resources.S_Playback_SpeechRate_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TopSpeedFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="1"
                                Maximum="200"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Settings.SpeechRate, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32"
                                       TextAlignment="Right"
                                       Text="{Binding Settings.SpeechRate}" />
                            <TextBlock Text="%" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_WaitComplete"
                                   Header="{x:Static lsp:Resources.S_Playback_WaitComplete}"
                                   Description="{x:Static lsp:Resources.S_Playback_WaitComplete_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.VoiceWaitComplete}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Content"
                         Text="{x:Static lsp:Resources.S_Content}"
                         Glyph="{sr:Fi TextFontFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Content_AnnounceId"
                                   Header="{x:Static lsp:Resources.S_Content_AnnounceId}"
                                   Description="{x:Static lsp:Resources.S_Content_AnnounceId_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AnnounceId}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Content_AnnounceName"
                                   Header="{x:Static lsp:Resources.S_Content_AnnounceName}"
                                   Description="{x:Static lsp:Resources.S_Content_AnnounceName_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AnnounceName}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
