<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Voice"
             xmlns:lspm="clr-namespace:SecRandom.Langs.SettingsPages.Voice"
             xmlns:mobile="clr-namespace:SecRandom.Langs.Mobile"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:notification="clr-namespace:SecRandom.Views.SettingsPages.Notification"
             xmlns:plugin="clr-namespace:SecRandom.Langs.SettingsPages.Plugins.Overview"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.Notification.VoiceSettingsPage"
             x:DataType="notification:VoiceSettingsPage"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText x:Name="S_Playback"
                         Text="{x:Static lsp:Resources.S_Playback}"
                         Glyph="{sr:Fi PersonVoiceFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Playback_Enable"
                                   Header="{x:Static lsp:Resources.S_Playback_Enable}"
                                   Description="{x:Static lsp:Resources.S_Playback_Enable_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Filled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.VoiceEnable}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Engine"
                                   Header="{x:Static lsp:Resources.S_Playback_Engine}"
                                   Description="{x:Static lsp:Resources.S_Playback_Engine_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonVoiceFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="220"
                              ItemsSource="{Binding VoiceEngineOptions}"
                              SelectedValue="{Binding Settings.VoiceEngine, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Id}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_OmniTts"
                                   Header="{x:Static lsp:Resources.S_OmniTts}"
                                   IsVisible="{Binding IsOmniTtsSelected}"
                                   IsExpanded="False"
                                   IconSource="{sr:FluentIconSource {sr:Fi GlobeFilled}}">
                <fa:FASettingsExpanderItem x:Name="S_OmniTts_Provider"
                                           Content="{x:Static lsp:Resources.S_OmniTts_Provider}"
                                           Description="{x:Static lsp:Resources.S_OmniTts_Provider_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox Width="320"
                                  ItemsSource="{Binding OmniTtsProviderOptions}"
                                  SelectedValue="{Binding SelectedOmniTtsProvider, Mode=TwoWay}"
                                  SelectedValueBinding="{Binding Provider}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_OmniTts_ApiBaseUrl"
                                           Content="{x:Static lsp:Resources.S_OmniTts_ApiBaseUrl}"
                                           Description="{x:Static lsp:Resources.S_OmniTts_ApiBaseUrl_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBox Width="320"
                                 Text="{Binding Settings.OmniTtsApiBaseUrl, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_OmniTts_ApiKey"
                                           Content="{x:Static lsp:Resources.S_OmniTts_ApiKey}"
                                           Description="{x:Static lsp:Resources.S_OmniTts_ApiKey_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Width="320" Spacing="8">
                            <TextBox Width="320"
                                     PasswordChar="*"
                                     Text="{Binding OmniTtsApiKeyDraft, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Static lsp:Resources.C_OmniTtsSaveKey}"
                                        Click="SaveOmniTtsKeyButton_OnClick" />
                                <Button Content="{x:Static lsp:Resources.C_OmniTtsClearKey}"
                                        Click="ClearOmniTtsKeyButton_OnClick" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           Opacity="0.7"
                                           Text="{Binding OmniTtsKeyStatus}" />
                            </StackPanel>
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_OmniTts_Model"
                                           Content="{x:Static lsp:Resources.S_OmniTts_Model}"
                                           Description="{x:Static lsp:Resources.S_OmniTts_Model_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="200"
                                         Text="{Binding OmniTtsModelInput, Mode=TwoWay}" />
                                <Button Width="112"
                                        Content="{x:Static plugin:Resources.C_Add}"
                                        Click="AddOmniTtsModelButton_OnClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox Width="200"
                                          ItemsSource="{Binding OmniTtsModelOptions}"
                                          SelectedItem="{Binding Settings.OmniTtsModel, Mode=TwoWay}" />
                                <Button Width="112"
                                        Content="{x:Static lsp:Resources.C_OmniTtsRefreshModels}"
                                        Click="RefreshOmniTtsModelsButton_OnClick" />
                            </StackPanel>
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_OmniTts_Voice"
                                           Content="{x:Static lsp:Resources.S_OmniTts_Voice}"
                                           Description="{x:Static lsp:Resources.S_OmniTts_Voice_D}"
                                           IsVisible="{Binding !IsMiMoSpecialVoiceSelected}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Width="320" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="200"
                                         Text="{Binding OmniTtsVoiceInput, Mode=TwoWay}" />
                                <Button Width="112"
                                        Content="{x:Static plugin:Resources.C_Add}"
                                        Click="AddOmniTtsVoiceButton_OnClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox Width="{Binding OmniTtsVoiceSelectorWidth}"
                                          ItemsSource="{Binding OmniTtsVoiceOptions}"
                                          SelectedItem="{Binding Settings.OmniTtsVoiceId, Mode=TwoWay}" />
                                <Button Width="112"
                                        IsVisible="{Binding CanRefreshOmniTtsVoices}"
                                        Content="{x:Static lsp:Resources.C_OmniTtsRefreshVoices}"
                                        Click="RefreshOmniTtsVoicesButton_OnClick" />
                            </StackPanel>
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_MiMoVoiceDesign"
                                           Content="{x:Static lspm:MiMoResources.S_MiMoVoiceDesign}"
                                           Description="{x:Static lspm:MiMoResources.S_MiMoVoiceDesign_D}"
                                           IsVisible="{Binding IsMiMoVoiceDesignSelected}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBox Width="320"
                                 MaxHeight="128"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Settings.MiMoVoiceDesignPrompt, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_MiMoVoiceClone"
                                           Content="{x:Static lspm:MiMoResources.S_MiMoVoiceClone}"
                                           Description="{x:Static lspm:MiMoResources.S_MiMoVoiceClone_D}"
                                           IsVisible="{Binding IsMiMoVoiceCloneSelected}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Width="320" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{x:Static lspm:MiMoResources.C_MiMoVoiceCloneSelect}"
                                        Click="SelectMiMoVoiceCloneButton_OnClick" />
                                <Button Content="{x:Static lspm:MiMoResources.C_MiMoVoiceCloneClear}"
                                        IsEnabled="{Binding MiMoVoiceCloneReferenceConfigured}"
                                        Click="ClearMiMoVoiceCloneButton_OnClick" />
                            </StackPanel>
                            <TextBlock FontSize="12"
                                       Opacity="0.7"
                                       Text="{Binding MiMoVoiceCloneStatus}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_OmniTts_Instructions"
                                           Content="{x:Static lsp:Resources.S_OmniTts_Instructions}"
                                           Description="{x:Static lsp:Resources.S_OmniTts_Instructions_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBox Width="320"
                                 MaxHeight="128"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Settings.OmniTtsInstructions, Mode=TwoWay}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Voice"
                                   Header="{x:Static lsp:Resources.S_Playback_Voice}"
                                   Description="{x:Static lsp:Resources.S_Playback_Voice_D}"
                                   IsVisible="{Binding IsSystemTtsSelected}"
                                   IconSource="{sr:FluentIconSource {sr:Fi MicFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="300"
                              IsEnabled="{Binding !IsLoadingSystemVoices}"
                              ItemsSource="{Binding SystemTtsVoices}"
                              SelectedValue="{Binding Settings.SystemTtsVoiceName, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Id}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Description}"
                                               Opacity="0.7"
                                               FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_EdgeTtsVoice"
                                   Header="{x:Static lsp:Resources.S_Playback_EdgeTtsVoice}"
                                   Description="{x:Static lsp:Resources.S_Playback_EdgeTtsVoice_D}"
                                   IsVisible="{Binding IsEdgeTtsSelected}"
                                   IconSource="{sr:FluentIconSource {sr:Fi MicFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="300"
                              IsEnabled="{Binding !IsLoadingEdgeVoices}"
                              ItemsSource="{Binding EdgeTtsVoices}"
                              SelectedValue="{Binding Settings.EdgeTtsVoiceName, Mode=TwoWay}"
                              SelectedValueBinding="{Binding Id}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Description}"
                                               Opacity="0.7"
                                               FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Actions"
                                   Header="{x:Static lsp:Resources.S_Playback_Actions}"
                                   Description="{x:Static lsp:Resources.S_Playback_Actions_D}"
                                   IsExpanded="False"
                                   IconSource="{sr:FluentIconSource {sr:Fi PersonVoiceFilled}}">
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_TestVoice}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid Width="320" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     MaxHeight="128"
                                     HorizontalAlignment="Stretch"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Text="{Binding TestVoiceText, Mode=TwoWay}"
                                     LostFocus="TestVoiceTextBox_OnLostFocus" />
                            <Button Grid.Column="1"
                                    Width="32"
                                    Theme="{StaticResource TransparentButton}"
                                    Click="ResetTestVoiceTextButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi ArrowCounterclockwiseFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static lsp:Resources.C_RefreshVoices}"
                                Click="RefreshVoicesButton_OnClick" />
                        <Button Classes="accent"
                                Content="{x:Static lsp:Resources.C_TestVoice}"
                                Click="TestVoiceButton_OnClick" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_VoiceCache_BatchGenerate"
                                   Header="{x:Static lsp:Resources.S_OmniTts_BatchGenerate}"
                                   Description="{x:Static lsp:Resources.S_OmniTts_BatchGenerate_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi CloudAddFilled}}">
                <fa:FASettingsExpanderItem x:Name="S_OmniTtsBatchScope"
                                           Content="{x:Static lsp:Resources.S_OmniTtsBatchScope}"
                                           Description="{x:Static lsp:Resources.S_OmniTtsBatchScope_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Width="320" MaxWidth="320" HorizontalAlignment="Right" Spacing="8">
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding BatchRosterOptions}"
                                      IsEnabled="{Binding CanSelectBatchRoster}"
                                      SelectedItem="{Binding SelectedBatchRoster, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           MinWidth="0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Text="{Binding BatchProgressText}"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Classes="accent"
                                        Content="{x:Static lsp:Resources.C_OmniTtsStartBatch}"
                                        IsEnabled="{Binding CanStartBatch}"
                                        Click="StartBatchButton_OnClick" />
                                <Button Grid.Column="2"
                                        Content="{x:Static lsp:Resources.C_OmniTtsCancelBatch}"
                                        IsEnabled="{Binding IsBatchRunning}"
                                        Click="CancelBatchButton_OnClick" />
                            </Grid>
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_VoiceCache_Clear"
                                   Header="{x:Static lsp:Resources.S_OmniTts_ClearCache}"
                                   Description="{x:Static lsp:Resources.S_OmniTts_ClearCache_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DeleteFilled}}">
                <fa:FASettingsExpanderItem x:Name="S_OmniTtsClearScope"
                                           Content="{x:Static lsp:Resources.S_OmniTtsClearScope}"
                                           Description="{x:Static lsp:Resources.S_OmniTtsClearScope_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Width="320" MaxWidth="320" HorizontalAlignment="Right" Spacing="8">
                            <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox Grid.Column="0"
                                          HorizontalAlignment="Right"
                                          IsVisible="{Binding HasClearCacheOptions}"
                                          ItemsSource="{Binding ClearRosterOptions}"
                                          SelectedItem="{Binding SelectedClearRoster, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Column="0"
                                           IsVisible="{Binding !HasClearCacheOptions}"
                                           VerticalAlignment="Center"
                                           Text="{x:Static lsp:Resources.M_OmniTtsCacheEmpty}"
                                           TextTrimming="CharacterEllipsis"
                                           Opacity="0.7"
                                           FontSize="12" />
                                <Button Grid.Column="1"
                                    Content="{x:Static lsp:Resources.C_OmniTtsClearCache}"
                                    IsEnabled="{Binding CanClearCache}"
                                    Click="ClearOmniTtsCacheButton_OnClick" />
                            </Grid>
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_Volume"
                                   Header="{x:Static lsp:Resources.S_Playback_Volume}"
                                   Description="{x:Static lsp:Resources.S_Playback_Volume_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi Speaker2Filled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="0"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Settings.VolumeSize, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32" TextAlignment="Right" Text="{Binding Settings.VolumeSize}" />
                            <TextBlock Text="%" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_SpeechRate"
                                   Header="{x:Static lsp:Resources.S_Playback_SpeechRate}"
                                   Description="{x:Static lsp:Resources.S_Playback_SpeechRate_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TopSpeedFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="1"
                                Maximum="200"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Settings.SpeechRate, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32" TextAlignment="Right" Text="{Binding Settings.SpeechRate}" />
                            <TextBlock Text="%" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Playback_WaitComplete"
                                   Header="{x:Static lsp:Resources.S_Playback_WaitComplete}"
                                   Description="{x:Static lsp:Resources.S_Playback_WaitComplete_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.VoiceWaitComplete}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Content"
                         Text="{x:Static lsp:Resources.S_Content}"
                         Glyph="{sr:Fi TextFontFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Content_AnnounceId"
                                   Header="{x:Static lsp:Resources.S_Content_AnnounceId}"
                                   Description="{x:Static lsp:Resources.S_Content_AnnounceId_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AnnounceId}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Content_AnnounceName"
                                   Header="{x:Static lsp:Resources.S_Content_AnnounceName}"
                                   Description="{x:Static lsp:Resources.S_Content_AnnounceName_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AnnounceName}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
