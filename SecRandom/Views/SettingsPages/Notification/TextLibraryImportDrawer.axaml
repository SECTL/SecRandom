<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.Notification"
             xmlns:controls="clr-namespace:SecRandom.Controls"
             xmlns:lm="clr-namespace:SecRandom.Langs.SettingsPages.Notification.Texts"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="SecRandom.Views.SettingsPages.Notification.TextLibraryImportDrawer"
             x:DataType="local:TextLibraryImportDrawer">
    <Grid Width="400" RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="16,16,16,8" Spacing="8">
                <TextBlock Text="{x:Static lm:Resources.M_ImportTitle}"
                           Theme="{StaticResource TitleTextBlockStyle}" />

                <fa:FAInfoBar Title="{x:Static lm:Resources.M_ImportTitle}"
                              Message="{x:Static lm:Resources.M_ImportHint}"
                              Severity="Informational"
                              IsClosable="False"
                              IsOpen="True" />

                <GroupBox Header="{x:Static lm:Resources.C_ImportSource}">
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ImportModes}"
                              SelectedItem="{Binding SelectedImportModeOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:TextLibraryImportModeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </GroupBox>

                <StackPanel Spacing="8" IsVisible="{Binding IsTableMode}">
                    <Button Classes="accent" HorizontalAlignment="Left" Click="FileImportButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <sr:FluentIcon Glyph="{sr:Fi DocumentTableFilled}" />
                            <TextBlock Text="{x:Static lm:Resources.C_SelectFile}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Static lm:Resources.M_TableHint}"
                               TextWrapping="Wrap"
                               Opacity="0.7" />
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding IsJsonMode}">
                    <TextBlock Text="{x:Static lm:Resources.M_JsonHint}" TextWrapping="Wrap" Opacity="0.7" />
                    <TextBox AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxLength="14121"
                             Height="140"
                             VerticalContentAlignment="Top"
                             Text="{Binding JsonText, Mode=TwoWay}" />
                    <TextBlock Text="{Binding JsonCountText}" HorizontalAlignment="Right" Opacity="0.7" />
                    <TextBlock Text="{Binding JsonStatusText}"
                               IsVisible="{Binding JsonStatusIsError}"
                               Foreground="Red"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding JsonStatusText}"
                               IsVisible="{Binding !JsonStatusIsError}"
                               TextWrapping="Wrap"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding JsonErrorText}"
                               IsVisible="{Binding JsonStatusIsError}"
                               Foreground="Red"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding IsTransferMode}">
                    <GroupBox Header="{x:Static lm:Resources.C_TransferMode}">
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TransferModes}"
                                  SelectedItem="{Binding SelectedTransferModeOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:TextLibraryTransferModeOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </GroupBox>

                    <TextBlock Text="{x:Static lm:Resources.M_QuickQrHint}"
                               IsVisible="{Binding IsQuickQrMode}"
                               TextWrapping="Wrap"
                               Opacity="0.7" />
                    <TextBlock Text="{x:Static lm:Resources.M_OfflineQrHint}"
                               IsVisible="{Binding IsOfflineQrMode}"
                               TextWrapping="Wrap"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding OfflineQrStatsText}"
                               IsVisible="{Binding IsOfflineQrMode}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static lm:Resources.M_SessionCodeHint}"
                               IsVisible="{Binding IsSessionCodeMode}"
                               TextWrapping="Wrap"
                               Opacity="0.7" />
                    <TextBox x:Name="SessionCodeInput"
                             IsVisible="{Binding IsSessionCodeMode}"
                             MaxLength="12"
                             FontFamily="Consolas, Menlo, monospace"
                             HorizontalAlignment="Stretch"
                             TextChanged="SessionCodeInput_OnTextChanged"
                             PlaceholderText="{x:Static lm:Resources.M_SessionCodePlaceholder}" />

                    <Border IsVisible="{Binding IsCameraPreviewSupported}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Height="180">
                        <controls:RosterQrCameraPreview x:Name="CameraControl" />
                    </Border>

                    <Button Classes="accent"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding IsCameraPreviewSupported}"
                            Click="ScanButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <sr:FluentIcon Glyph="{sr:Fi QrCodeFilled}" />
                            <TextBlock Text="{Binding ScanButtonText}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Static lm:Resources.M_ScanUnsupported}"
                               IsVisible="{Binding !IsCameraPreviewSupported}"
                               TextWrapping="Wrap"
                               Opacity="0.7" />
                </StackPanel>

                <Border IsVisible="{Binding HasPreview}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        ClipToBounds="True">
                    <StackPanel Spacing="4" Margin="8">
                        <TextBlock Text="{Binding PreviewSummary}" FontWeight="SemiBold" />
                        <ScrollViewer Height="150">
                            <ItemsControl ItemsSource="{Binding PreviewTexts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="16,8,16,16" ColumnDefinitions="* Auto">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                <Button Content="{x:Static lm:Resources.C_Cancel}" Click="CancelButton_OnClick" />
                <Button Classes="accent"
                        Content="{x:Static lm:Resources.C_Import}"
                        IsEnabled="{Binding CanImport}"
                        Click="ImportButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
