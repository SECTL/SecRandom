<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Notification"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:notification="clr-namespace:SecRandom.Views.SettingsPages.Notification"
             x:Class="SecRandom.Views.SettingsPages.Notification.NotificationFloatingWindowSettingsPage"
             x:DataType="notification:NotificationFloatingWindowSettingsPage">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText x:Name="S_FloatingWindow_Appearance"
                         Text="{x:Static lsp:Resources.S_FloatingWindow_Appearance}"
                         Glyph="{sr:Fi PaintBrushFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_FloatingWindow_WindowPosition"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_WindowPosition}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_WindowPosition_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <sr:AnchorGridDropDown SelectedValue="{Binding Settings.WindowPosition, Mode=TwoWay}"
                                           Labels="{Binding WindowPositionLabels}"
                                           MinWidth="160" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_EnabledMonitor"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_EnabledMonitor}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_EnabledMonitor_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DesktopFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox ItemsSource="{Binding MonitorOptions}"
                              SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                              PlaceholderText="{x:Static lsp:Resources.O_Monitor_Unspecified}"
                              MinWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="notification:MonitorOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_Offset"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_Offset}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_Offset_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ArrowMoveFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <NumericUpDown Value="{Binding Settings.HorizontalOffset, Mode=TwoWay}"
                                       Minimum="-2000" Maximum="2000" />
                        <NumericUpDown Value="{Binding Settings.VerticalOffset, Mode=TwoWay}"
                                       Minimum="-2000" Maximum="2000" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_Transparency"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_Transparency}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_Transparency_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi EyeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="20"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Settings.Transparency, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32" TextAlignment="Right" Text="{Binding Settings.Transparency}" />
                            <TextBlock Text="%" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_BackgroundStyle"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_BackgroundStyle}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_BackgroundStyle_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="180"
                              ItemsSource="{Binding BackgroundStyleOptions}"
                              SelectedItem="{Binding SelectedBackgroundStyle, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="notification:BackgroundStyleOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_ThemeBackgroundOpacity"
                                   IsVisible="{Binding IsThemeBackgroundMode}"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_ThemeBackgroundOpacity}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_ThemeBackgroundOpacity_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi LayerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.ThemeBackgroundOpacity, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32" TextAlignment="Right" Text="{Binding Settings.ThemeBackgroundOpacity}" />
                            <TextBlock Text="%" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_BackgroundColor"
                                   IsVisible="{Binding IsSolidBackgroundMode}"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_BackgroundColor}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_BackgroundColor_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PaintBrushFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ColorPicker Color="{Binding Settings.BackgroundColor, Mode=TwoWay}"
                                 Width="240" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_BackgroundGradient"
                                   IsVisible="{Binding IsGradientBackgroundMode}"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_BackgroundGradient}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_BackgroundGradient_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ColorPicker Color="{Binding Settings.BackgroundGradientStart, Mode=TwoWay}"
                                     Width="200" />
                        <TextBlock Text="→" VerticalAlignment="Center" />
                        <ColorPicker Color="{Binding Settings.BackgroundGradientEnd, Mode=TwoWay}"
                                     Width="200" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_BackgroundGradientAngle"
                                   IsVisible="{Binding IsGradientBackgroundMode}"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_BackgroundGradientAngle}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_BackgroundGradientAngle_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi RotateRightFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="0" Maximum="360" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.BackgroundGradientAngle, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32" TextAlignment="Right"
                                       Text="{Binding Settings.BackgroundGradientAngle}" />
                            <TextBlock Text="°" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_BackgroundImage"
                                   IsVisible="{Binding IsBackgroundImageMode}"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_BackgroundImage}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_BackgroundImage_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ImageFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="96" Height="54" CornerRadius="4" ClipToBounds="True"
                                IsVisible="{Binding HasBackgroundImage}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Image Source="{Binding BackgroundImagePreview}" Stretch="UniformToFill" />
                        </Border>
                        <Button Classes="accent" Click="ImportBackgroundImage_OnClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <sr:FluentIcon Glyph="{sr:Fi ImageAddFilled}" />
                                <TextBlock Text="{x:Static lsp:Resources.C_FloatingWindow_ImportImage}" />
                            </StackPanel>
                        </Button>
                        <Button Click="ClearBackgroundImage_OnClick"
                                IsEnabled="{Binding HasBackgroundImage}"
                                Content="{x:Static lsp:Resources.C_FloatingWindow_ClearImage}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_BackgroundOpacity"
                                   IsVisible="{Binding IsBackgroundImageMode}"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_BackgroundOpacity}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_BackgroundOpacity_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi LayerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.BackgroundOpacity, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32" TextAlignment="Right" Text="{Binding Settings.BackgroundOpacity}" />
                            <TextBlock Text="%" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_AdaptiveForeground"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_AdaptiveForeground}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_AdaptiveForeground_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DesktopPulseFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding AdaptiveForegroundEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding IsAdaptiveForegroundAvailable}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <sr:IconText x:Name="S_FloatingWindow_Playback"
                         Text="{x:Static lsp:Resources.S_FloatingWindow_Playback}"
                         Glyph="{sr:Fi PlayFilled}" Margin="0 12 0 4" />

            <fa:FASettingsExpander x:Name="S_FloatingWindow_CountdownStyle"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_CountdownStyle}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_CountdownStyle_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TimerFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="180"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding CountdownStyleOptions}"
                              SelectedItem="{Binding SelectedCountdownStyleOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="notification:CountdownStyleOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 颜色配置拆成独立设置卡：模式、渐变、纯色各自一张卡，不再全部挤在同一张卡里。 -->
            <fa:FASettingsExpander x:Name="S_FloatingWindow_CountdownColorMode"
                                   IsVisible="{Binding ShowCountdownColors}"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_CountdownColorMode}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_CountdownColorMode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox MinWidth="180"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding CountdownColorModeOptions}"
                              SelectedItem="{Binding SelectedCountdownColorModeOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="notification:CountdownColorModeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 只有起始与终止两种颜色，两个颜色组件直接并排，中间不加箭头等连接符。 -->
            <fa:FASettingsExpander x:Name="S_FloatingWindow_CountdownGradient"
                                   IsVisible="{Binding IsCountdownGradientMode}"
                                   IsExpanded="True"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_CountdownGradient}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_CountdownGradient_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_CountdownColors_Gradient}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                            <ColorPicker Width="220"
                                         Color="{Binding Settings.CountdownGradientStart, Mode=TwoWay}" />
                            <ColorPicker Width="220"
                                         Color="{Binding Settings.CountdownGradientEnd, Mode=TwoWay}" />
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.C_CountdownColors_Preview}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Border Width="240" Height="10" CornerRadius="5"
                                HorizontalAlignment="Left"
                                Background="{Binding CountdownPreviewBrush}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_CountdownSolidColor"
                                   IsVisible="{Binding IsCountdownSolidMode}"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_CountdownSolidColor}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_CountdownSolidColor_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                <fa:FASettingsExpander.Footer>
                    <!-- 纯色只有一种颜色，颜色组件本身就能说明结果，不再单独放预览条。 -->
                    <StackPanel Spacing="8" HorizontalAlignment="Left">
                        <ColorPicker Width="220"
                                     Color="{Binding Settings.CountdownSolidColor, Mode=TwoWay}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_Preview"
                                   Header="{Binding PreviewTitle}"
                                   Description="{Binding PreviewDescription}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ZoomFitFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Button Classes="accent" Click="TestNotification_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <sr:FluentIcon Glyph="{sr:Fi PlayFilled}" />
                            <TextBlock Text="{Binding PreviewButtonText}" />
                        </StackPanel>
                    </Button>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
