<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Notification"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:notification="clr-namespace:SecRandom.Views.SettingsPages.Notification"
             x:Class="SecRandom.Views.SettingsPages.Notification.NotificationFloatingWindowSettingsPage"
             x:DataType="notification:NotificationFloatingWindowSettingsPage">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText x:Name="S_FloatingWindow" Text="{x:Static lsp:Resources.S_FloatingWindow}"
                         Glyph="{sr:Fi PictureInPictureFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_FloatingWindow_WindowPosition"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_WindowPosition}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_WindowPosition_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.WindowPosition, Mode=TwoWay}" MinWidth="160">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Center}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Top}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Bottom}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Left}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_WindowPosition_Right}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_EnabledMonitor"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_EnabledMonitor}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_EnabledMonitor_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DesktopFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox ItemsSource="{Binding MonitorOptions}"
                              SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                              PlaceholderText="{x:Static lsp:Resources.O_Monitor_Unspecified}"
                              MinWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="notification:MonitorOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_Offset"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_Offset}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_Offset_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ArrowMoveFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <NumericUpDown Value="{Binding Settings.HorizontalOffset, Mode=TwoWay}"
                                       Minimum="-2000" Maximum="2000" />
                        <NumericUpDown Value="{Binding Settings.VerticalOffset, Mode=TwoWay}"
                                       Minimum="-2000" Maximum="2000" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_FloatingWindow_Transparency"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_Transparency}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_Transparency_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi EyeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Slider Minimum="20"
                                Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Settings.Transparency, Mode=TwoWay}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <TextBlock Width="32" TextAlignment="Right" Text="{Binding Settings.Transparency}" />
                            <TextBlock Text="%" />
                        </StackPanel>
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander x:Name="S_FloatingWindow_AdaptiveForeground"
                                   Header="{x:Static lsp:Resources.S_FloatingWindow_AdaptiveForeground}"
                                   Description="{x:Static lsp:Resources.S_FloatingWindow_AdaptiveForeground_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DesktopPulseFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding AdaptiveForegroundEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding IsAdaptiveForegroundAvailable}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>