<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lm="clr-namespace:SecRandom.Langs.SettingsPages.Notification.Texts"
             xmlns:notification="clr-namespace:SecRandom.Views.SettingsPages.Notification"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="SecRandom.Views.SettingsPages.Notification.TextLibrarySettingsPage"
             x:DataType="notification:TextLibrarySettingsPage"
             x:Name="Root">
    <Grid RowDefinitions="Auto *" RowSpacing="8" Classes="page-container animated-intro">
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">
                <fa:FACommandBar Grid.Column="0" DefaultLabelPosition="Right">
                    <fa:FACommandBar.PrimaryCommands>
                        <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi ArrowImportFilled}}"
                                               Label="{x:Static lm:Resources.C_Import}"
                                               Click="OpenImportDrawer_OnClick" />

                        <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi ArrowDownloadFilled}}"
                                               Label="{x:Static lm:Resources.C_Export}"
                                               Click="OpenExportDrawer_OnClick" />

                        <fa:FACommandBarSeparator />

                        <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi ArrowCounterclockwiseFilled}}"
                                               Label="{x:Static lm:Resources.C_RestoreDefaults}"
                                               Click="RestoreDefaults_OnClick" />

                        <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi ArrowClockwiseFilled}}"
                                               Label="{x:Static lm:Resources.C_ResetCounts}"
                                               Click="ResetCounts_OnClick" />

                        <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi ArrowSyncFilled}}"
                                               Label="{x:Static lm:Resources.C_Refresh}"
                                               Click="Refresh_OnClick" />
                    </fa:FACommandBar.PrimaryCommands>
                </fa:FACommandBar>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Margin="0 0 12 0">
                    <TextBlock Text="{Binding StatisticsText}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBox Width="200"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="{x:Static lm:Resources.M_SearchPlaceholder}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True"
                IsVisible="{Binding !IsEmpty}">
            <DataGrid x:Name="S_TextLibrary_Entries"
                      MinHeight="320"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="3*" MinWidth="180" Header="{x:Static lm:Resources.C_Text}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="notification:TextLibraryRow">
                                <TextBlock Text="{Binding Text}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Text}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="96"
                                        Header="{x:Static lm:Resources.C_UseCount}"
                                        Binding="{Binding UseCount}" />

                    <DataGridTextColumn Width="96"
                                        Header="{x:Static lm:Resources.C_Share}"
                                        Binding="{Binding ShareText}" />

                    <DataGridTemplateColumn Width="96" Header="{x:Static lm:Resources.C_Enabled}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="notification:TextLibraryRow">
                                <ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="120" Header="{x:Static lm:Resources.C_Operations}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="notification:TextLibraryRow">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Center">
                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="{x:Static lm:Resources.C_Edit}"
                                            AutomationProperties.Name="{x:Static lm:Resources.C_Edit}"
                                            Click="EditEntry_OnClick">
                                        <sr:FluentIcon Glyph="{sr:Fi EditFilled}" />
                                    </Button>

                                    <Button Width="32"
                                            Height="32"
                                            Padding="0"
                                            Theme="{StaticResource TransparentButton}"
                                            Foreground="Red"
                                            ToolTip.Tip="{x:Static lm:Resources.C_Delete}"
                                            AutomationProperties.Name="{x:Static lm:Resources.C_Delete}"
                                            Click="DeleteEntry_OnClick">
                                        <sr:FluentIcon Glyph="{sr:Fi DeleteFilled}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{x:Static lm:Resources.M_NoMatch}"
                   IsVisible="{Binding HasNoMatches}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0 24"
                   Opacity="0.7" />

        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsEmpty}"
                    Spacing="12"
                    Margin="0 48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <TextBlock Text="{x:Static lm:Resources.M_Empty}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Opacity="0.7" />

            <Button Classes="accent" HorizontalAlignment="Center" Click="OpenImportDrawer_OnClick">
                <sr:IconText Text="{x:Static lm:Resources.C_Import}" Glyph="{sr:Fi ArrowImportFilled}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
