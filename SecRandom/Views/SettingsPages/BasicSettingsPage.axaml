<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages"
             xmlns:lsb="clr-namespace:SecRandom.Langs.SettingsPages.Basic"
             xmlns:converters="clr-namespace:SecRandom.Converters"
             xmlns:secRandom="clr-namespace:SecRandom"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.BasicSettingsPage"
             x:DataType="local:BasicSettingsPage"
             d:DataContext="{d:DesignInstance local:BasicSettingsPage}"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <converters:StringToFontFamilyConverter x:Key="StringToFontFamilyConverter" />
    </UserControl.Resources>
    
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <fa:InfoBar Title="{x:Static lsb:Resources.C_VersionNotice}"
                        Severity="Informational" IsClosable="False"
                        IsOpen="{Binding Settings.ShowVersionNotice, Mode=OneWay}">
                <fa:InfoBar.ActionButton>
                    <Button Content="{x:Static lsb:Resources.C_VersionNoticeHide}"
                            Click="HideVersionNoticeButton_OnClick" />
                </fa:InfoBar.ActionButton>
                
                <TextBlock Text="{x:Static lsb:Resources.C_VersionNoticeText}"
                           TextWrapping="Wrap"
                           Margin="0 0 0 8" />
            </fa:InfoBar>
            
            <sr:IconText x:Name="S_Behavior"
                         Text="{x:Static lsb:Resources.S_Behavior}"
                         Glyph="{sr:FI FlashRegular}"
                         Margin="0 0 0 4" />
            
            <fa:SettingsExpander x:Name="S_Behavior_Autostart"
                                 Header="{x:Static lsb:Resources.S_Behavior_Autostart}"
                                 Description="{x:Static lsb:Resources.S_Behavior_Autostart_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI ArrowSyncRegular}}">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.Autostart}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Behavior_ShowStartupWindow"
                                 Header="{x:Static lsb:Resources.S_Behavior_ShowStartupWindow}"
                                 Description="{x:Static lsb:Resources.S_Behavior_ShowStartupWindow_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI WindowRegular}}">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.ShowStartupWindow}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Behavior_AutoSaveWindowSize"
                                 Header="{x:Static lsb:Resources.S_Behavior_AutoSaveWindowSize}"
                                 Description="{x:Static lsb:Resources.S_Behavior_AutoSaveWindowSize_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI SaveRegular}}">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AutoSaveWindowSize}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Behavior_MainWindowTopmostMode"
                                 Header="{x:Static lsb:Resources.S_Behavior_MainWindowTopmostMode}"
                                 Description="{x:Static lsb:Resources.S_Behavior_MainWindowTopmostMode_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI PinRegular}}">
                <fa:SettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.MainWindowTopmostMode}">
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_MainWindowTopmostMode_None}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_MainWindowTopmostMode_Topmost}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_MainWindowTopmostMode_UiAccess}" />
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Behavior_BackgroundResident"
                                 Header="{x:Static lsb:Resources.S_Behavior_BackgroundResident}"
                                 Description="{x:Static lsb:Resources.S_Behavior_BackgroundResident_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI ResizeRegular}}">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.BackgroundResident}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Behavior_UrlProtocol"
                                 Header="{x:Static lsb:Resources.S_Behavior_UrlProtocol}"
                                 Description="{x:Static lsb:Resources.S_Behavior_UrlProtocol_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI LinkRegular}}">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.UrlProtocol}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Personalized"
                         Text="{x:Static lsb:Resources.S_Personalized}"
                         Glyph="{sr:FI ColorRegular}"
                         Margin="0 0 0 4" />
            
            <fa:SettingsExpander x:Name="S_Personalized_Theme"
                                 Header="{x:Static lsb:Resources.S_Personalized_Theme}"
                                 Description="{x:Static lsb:Resources.S_Personalized_Theme_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI DarkThemeRegular}}">
                <fa:SettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.Theme}">
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_Theme_Light}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_Theme_Dark}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_Theme_Auto}" />
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander Header="{x:Static lsb:Resources.C_ThemeManager}"
                                 Description="{x:Static lsb:Resources.C_ThemeManager_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI PaintBrushRegular}}"
                                 IsClickEnabled="True"
                                 ActionIconSource="{sr:FluentIconSource {sr:FI ChevronRightRegular}}" />
            
            <fa:SettingsExpander x:Name="S_Personalized_Language"
                                 Header="{x:Static lsb:Resources.S_Personalized_Language}"
                                 Description="{x:Static lsb:Resources.S_Personalized_Language_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI LocalLanguageRegular}}">
                <fa:SettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.Language}">
                        <ComboBoxItem Content="简体中文" />
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="日本語" />
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Personalized_Font"
                                 Header="{x:Static lsb:Resources.S_Personalized_Font}"
                                 Description="{x:Static lsb:Resources.S_Personalized_Font_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI TextFontRegular}}">
                <fa:SettingsExpander.Footer>
                    <ComboBox x:Name="FontComboBox"
                              HorizontalAlignment="Left" MaxDropDownHeight="360"
                              ItemsSource="{Binding FontFamilies}"
                              SelectedValue="{Binding Settings.Font, Converter={StaticResource StringToFontFamilyConverter}}">
                        <ComboBox.Styles>
                            <Style Selector="ComboBoxItem">
                                <Setter Property="MinHeight" Value="32"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                            
                            <Style Selector="#FontComboBox /template/ Popup#PART_Popup">
                                <Setter Property="Width" Value="280"/>
                                <Setter Property="PlacementMode" Value="BottomEdgeAlignedRight"/>
                            </Style>
                        </ComboBox.Styles>
                        
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{Binding}" FontWeight="Normal"
                                           ToolTip.Tip="{Binding Name}"
                                           Height="20" MaxWidth="240"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Classes.DefaultFont="{Binding Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static secRandom:App.DefaultFontFamily}}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Style Selector="^.DefaultFont">
                                                <Setter Property="Text" Value="{x:Static lsb:Resources.O_FontFamily_Default}"/>
                                            </Style>
                                            <Setter Property="Text" Value="{Binding}" />
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Personalized_FontWeight"
                                 Header="{x:Static lsb:Resources.S_Personalized_FontWeight}"
                                 Description="{x:Static lsb:Resources.S_Personalized_FontWeight_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI TextBoldRegular}}">
                <fa:SettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.FontWeight}">
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_Thin}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_ExtraLight}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_Light}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_Regular}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_Medium}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_SemiBold}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_Bold}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_ExtraBold}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_FontWeight_Black}" />
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Personalized_ThemeColor"
                                 Header="{x:Static lsb:Resources.S_Personalized_ThemeColor}"
                                 Description="{x:Static lsb:Resources.S_Personalized_ThemeColor_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI ColorRegular}}">
                <fa:SettingsExpander.Footer>
                    <ColorPicker Color="{Binding Settings.ThemeColor}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_DataManagement"
                         Text="{x:Static lsb:Resources.S_DataManagement}"
                         Glyph="{sr:FI DataScatterRegular}"
                         Margin="0 0 0 4" />
            
            <fa:SettingsExpander x:Name="S_DataManagement_LogViewer"
                                 Header="{x:Static lsb:Resources.S_DataManagement_LogViewer}"
                                 Description="{x:Static lsb:Resources.S_DataManagement_LogViewer_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI DocumentRegular}}"
                                 IsClickEnabled="True"
                                 ActionIconSource="{sr:FluentIconSource {sr:FI ChevronRightRegular}}" />
            
            <fa:SettingsExpander x:Name="S_DataManagement_BackupManager"
                                 Header="{x:Static lsb:Resources.S_DataManagement_BackupManager}"
                                 Description="{x:Static lsb:Resources.S_DataManagement_BackupManager_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI SaveRegular}}"
                                 IsClickEnabled="True"
                                 ActionIconSource="{sr:FluentIconSource {sr:FI ChevronRightRegular}}"
                                 Click="OpenBackupManagerButton_OnClick" />
            
            <fa:SettingsExpander x:Name="S_DataManagement_ExportDiagnosticData"
                                 Header="{x:Static lsb:Resources.S_DataManagement_ExportDiagnosticData}"
                                 Description="{x:Static lsb:Resources.S_DataManagement_ExportDiagnosticData_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI DatabaseArrowDownRegular}}"
                                 IsClickEnabled="True"
                                 ActionIconSource="{sr:FluentIconSource {sr:FI ChevronRightRegular}}" />
            
            <fa:SettingsExpander x:Name="S_DataManagement_ExportSettings"
                                 Header="{x:Static lsb:Resources.S_DataManagement_ExportSettings}"
                                 Description="{x:Static lsb:Resources.S_DataManagement_ExportSettings_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI ArrowClockwiseDashesSettingsRegular}}"
                                 IsClickEnabled="True"
                                 ActionIconSource="{sr:FluentIconSource {sr:FI ChevronRightRegular}}" />
            
            <fa:SettingsExpander x:Name="S_DataManagement_ImportSettings"
                                 Header="{x:Static lsb:Resources.S_DataManagement_ImportSettings}"
                                 Description="{x:Static lsb:Resources.S_DataManagement_ImportSettings_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI ArrowClockwiseDashesSettingsRegular}}"
                                 IsClickEnabled="True"
                                 ActionIconSource="{sr:FluentIconSource {sr:FI ChevronRightRegular}}" />
            
            <fa:SettingsExpander x:Name="S_DataManagement_ExportAllData"
                                 Header="{x:Static lsb:Resources.S_DataManagement_ExportAllData}"
                                 Description="{x:Static lsb:Resources.S_DataManagement_ExportAllData_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI DatabaseWindowRegular}}"
                                 IsClickEnabled="True"
                                 ActionIconSource="{sr:FluentIconSource {sr:FI ChevronRightRegular}}" />
            
            <fa:SettingsExpander x:Name="S_DataManagement_ImportAllData"
                                 Header="{x:Static lsb:Resources.S_DataManagement_ImportAllData}"
                                 Description="{x:Static lsb:Resources.S_DataManagement_ImportAllData_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI DatabaseWindowRegular}}"
                                 IsClickEnabled="True"
                                 ActionIconSource="{sr:FluentIconSource {sr:FI ChevronRightRegular}}" />
            
            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Telemetry"
                               Text="{x:Static lsb:Resources.S_Telemetry}"
                               Glyph="{sr:FI PulseSquareRegular}" Margin="0 0 0 4" />
            
            
            <fa:SettingsExpander x:Name="S_Telemetry_Enabled"
                                 Header="{x:Static lsb:Resources.S_Telemetry_Enabled}"
                                 Description="{x:Static lsb:Resources.S_Telemetry_Enabled_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI PulseRegular}}">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.TelemetryEnabled}" />
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            
            <fa:SettingsExpander x:Name="S_Telemetry_Mode"
                                 Header="{x:Static lsb:Resources.S_Telemetry_Mode}"
                                 Description="{x:Static lsb:Resources.S_Telemetry_Mode_D}"
                                 IconSource="{sr:FluentIconSource {sr:FI GlobeRegular}}">
                <fa:SettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.TelemetryMode}">
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_TelemetryMode_Full}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_TelemetryMode_Anonymous}" />
                        <ComboBoxItem Content="{x:Static lsb:Resources.O_TelemetryMode_Off}" />
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
