<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
             xmlns:lv="clr-namespace:SecRandom.Langs.SettingsPages.General.Verification"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             x:Class="SecRandom.Views.SettingsPages.General.ProofPlaybackSettingsPage"
             x:DataType="local:ProofPlaybackSettingsPage"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="600">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Classes="page-container animated-intro settings">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Static lv:Resources.C_ProofPlaybackStart}"
                    IsEnabled="{Binding CanStartProofPlayback}"
                    Click="StartProofPlayback_OnClick" />
            <Button Content="{x:Static lv:Resources.C_OpenVerificationWebsite}"
                    Click="OpenVerificationWebsite_OnClick"
                    ToolTip.Tip="https://secrandom.sectl.cn" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Text="{x:Static lv:Resources.S_ProofPlaybackDate}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ProofDateGroups}"
                      SelectedItem="{Binding SelectedProofDateGroup, Mode=TwoWay}"
                      PlaceholderText="{x:Static lv:Resources.S_ProofPlaybackDate}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DateText}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True">
            <DataGrid AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectedItem="{Binding SelectedProofRow, Mode=TwoWay}"
                      ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="120"
                                        Header="{x:Static lv:Resources.S_ProofPlaybackDate}"
                                        Binding="{Binding DateText}" />
                    <DataGridTextColumn Width="90"
                                        Header="{x:Static lv:Resources.C_ProofPlaybackTime}"
                                        Binding="{Binding TimeText}" />
                    <DataGridTextColumn Width="80"
                                        Header="{x:Static lv:Resources.C_ProofPlaybackKind}"
                                        Binding="{Binding KindLabel}" />
                    <DataGridTextColumn Width="2*"
                                        MinWidth="180"
                                        Header="{x:Static lv:Resources.C_ProofPlaybackAlgorithm}"
                                        Binding="{Binding AlgorithmLabel}" />
                    <DataGridTextColumn Width="90"
                                        Header="{x:Static lv:Resources.C_ProofPlaybackCandidates}"
                                        Binding="{Binding CandidateCount}" />
                    <DataGridTextColumn Width="90"
                                        Header="{x:Static lv:Resources.C_ProofPlaybackResults}"
                                        Binding="{Binding ResultCount}" />
                    <DataGridTextColumn Width="2*"
                                        MinWidth="220"
                                        Header="{x:Static lv:Resources.C_ProofPlaybackProofId}"
                                        Binding="{Binding ProofIdText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
