<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
             xmlns:lc="clr-namespace:SecRandom.Langs.Common"
             xmlns:lsb="clr-namespace:SecRandom.Langs.SettingsPages.General.Backup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="SecRandom.Views.SettingsPages.General.BackupSettingsPage"
              Loaded="OnLoaded"
              Unloaded="OnUnloaded"
             x:DataType="local:BackupSettingsPage">
    <Grid RowDefinitions="Auto,*" Margin="0 12 0 0" RowSpacing="12">
        <TabStrip x:Name="BackupTabStrip"
                  Grid.Row="0"
                  HorizontalAlignment="Center"
                  SelectedIndex="0"
                  Theme="{StaticResource TabStripStyle}">
            <TabStripItem Content="{x:Static lsb:Resources.C_Tab_LocalBackup}" />
            <TabStripItem x:Name="S_CloudBackup"
                          Content="{x:Static lsb:Resources.C_Tab_CloudBackup}"
                          IsVisible="{Binding IsCloudVisible}" />
        </TabStrip>

        <Carousel Grid.Row="1"
                  Classes="animated"
                  SelectedIndex="{Binding #BackupTabStrip.SelectedIndex}">
            <ScrollViewer>
                <StackPanel Classes="page-container animated-intro settings">
                    <fa:FASettingsExpander x:Name="S_AutoBackup"
                                           Header="{x:Static lsb:Resources.S_AutoBackup}"
                                           Description="{x:Static lsb:Resources.S_AutoBackup_D}"
                                           IconSource="{sr:FluentIconSource {sr:Fi SaveFilled}}"
                                           IsExpanded="True">
                        <fa:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Settings.AutoBackupEnabled}" />
                        </fa:FASettingsExpander.Footer>

                        <fa:FASettingsExpanderItem x:Name="S_AutoBackup_IntervalDays"
                                                   Content="{x:Static lsb:Resources.S_AutoBackup_IntervalDays}"
                                                   Description="{x:Static lsb:Resources.S_AutoBackup_IntervalDays_D}">
                            <fa:FASettingsExpanderItem.Footer>
                                <NumericUpDown Value="{Binding Settings.AutoBackupIntervalDays}"
                                                Increment="1" Minimum="1" FormatString="0" />
                            </fa:FASettingsExpanderItem.Footer>
                        </fa:FASettingsExpanderItem>

                        <fa:FASettingsExpanderItem x:Name="S_AutoBackup_MaxCount"
                                                   Content="{x:Static lsb:Resources.S_AutoBackup_MaxCount}"
                                                   Description="{x:Static lsb:Resources.S_AutoBackup_MaxCount_D}">
                            <fa:FASettingsExpanderItem.Footer>
                                <NumericUpDown Value="{Binding Settings.AutoBackupMaxCount}"
                                                Increment="1" Minimum="0" FormatString="0" />
                            </fa:FASettingsExpanderItem.Footer>
                        </fa:FASettingsExpanderItem>

                        <fa:FASettingsExpanderItem x:Name="S_AutoBackup_ViewFolder"
                                                   Content="{x:Static lsb:Resources.S_AutoBackup_ViewFolder}"
                                                   Description="{x:Static lsb:Resources.S_AutoBackup_ViewFolder_D}"
                                                   IconSource="{sr:FluentIconSource {sr:Fi DatabaseWindowFilled}}"
                                                    IsClickEnabled="True" ActionIconSource="{sr:FluentIconSource {sr:Fi OpenFilled}}"
                                                   Click="ViewBackupFolder_OnClick" />

                        <fa:FASettingsExpanderItem x:Name="S_AutoBackup_Usage"
                                                   Content="{x:Static lsb:Resources.S_AutoBackup_Usage_R}"
                                                   Description="{x:Static lsb:Resources.S_AutoBackup_Usage_D}">
                            <fa:FASettingsExpanderItem.Footer>
                                <TextBlock Text="{Binding BackupUsageText}"
                                           VerticalAlignment="Center" />
                            </fa:FASettingsExpanderItem.Footer>
                        </fa:FASettingsExpanderItem>

                        <fa:FASettingsExpanderItem x:Name="S_AutoBackup_ManualBackup"
                                                   Content="{x:Static lsb:Resources.S_AutoBackup_ManualBackup}"
                                                   Description="{x:Static lsb:Resources.S_AutoBackup_ManualBackup_D}"
                                                   IsClickEnabled="True"
                                                   Click="ManualBackup_OnClick" />
                    </fa:FASettingsExpander>

                    <fa:FASettingsExpander x:Name="S_Includes"
                                           Header="{x:Static lsb:Resources.S_Includes}"
                                           Description="{x:Static lsb:Resources.S_Includes_D}"
                                           IconSource="{sr:FluentIconSource {sr:Fi DatabaseArrowDownFilled}}">
                         <fa:FASettingsExpander.Footer>
                             <sr:MultiComboBox MinWidth="260"
                                               ItemsSource="{Binding IncludeOptions}"
                                               SelectedItems="{Binding SelectedIncludeOptions}" />
                         </fa:FASettingsExpander.Footer>
                    </fa:FASettingsExpander>

                    <Separator Margin="0 12 0 4" />
                    <sr:IconText x:Name="S_RestoreBackup"
                                 Text="{x:Static lsb:Resources.S_RestoreBackup}"
                                 Glyph="{sr:Fi DatabaseArrowDownFilled}" Margin="0 0 0 4" />

                    <Button Content="{x:Static lsb:Resources.C_RefreshBackups}"
                            Click="RefreshBackups_OnClick" />

                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1 1 1 0"
                            CornerRadius="4 4 0 0" ClipToBounds="True">
                        <DataGrid AutoGenerateColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  ItemsSource="{Binding Backups}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="3*" MinWidth="360"
                                                    Header="{x:Static lsb:Resources.C_Backups_FileName}"
                                                    Binding="{Binding FileName}" />

                                <DataGridTextColumn Width="1.2*" MinWidth="160"
                                                    Header="{x:Static lsb:Resources.C_Backups_DateTime}"
                                                    Binding="{Binding DateTime}" />

                                <DataGridTextColumn Width="*" MinWidth="96"
                                                    Header="{x:Static lsb:Resources.C_Backups_Size}"
                                                    Binding="{Binding Size}" />

                                <DataGridTemplateColumn Header="{x:Static lsb:Resources.C_Backups_Operations}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Theme="{StaticResource TransparentButton}"
                                                        Click="RestoreBackup_OnClick"
                                                        CommandParameter="{Binding}">
                                                    <sr:IconText
                                                         Glyph="{sr:Fi ArrowCounterclockwiseFilled}"
                                                        Text="{x:Static lsb:Resources.C_Backups_Operations_Restore}" />
                                                </Button>

                                                <Button Theme="{StaticResource TransparentButton}" Foreground="Red"
                                                        Click="DeleteBackup_OnClick"
                                                        CommandParameter="{Binding}">
                                                    <sr:IconText
                                                         Glyph="{sr:Fi DeleteFilled}"
                                                        Text="{x:Static lsb:Resources.C_Backups_Operations_Delete}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsCloudVisible}">
                <StackPanel Classes="page-container animated-intro settings">
                    <fa:FASettingsExpander x:Name="S_CloudBackup_Account"
                                           Header="{x:Static lsb:Resources.S_CloudBackup_Account}"
                                           Description="{x:Static lsb:Resources.S_CloudBackup_Account_D}"
                                           IconSource="{sr:FluentIconSource {sr:Fi PersonFilled}}"
                                           IsExpanded="True">
                        <fa:FASettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CloudAccountText}" VerticalAlignment="Center" />
                                <Button Content="{x:Static lsb:Resources.C_CloudBackup_SignIn}"
                                        IsVisible="{Binding !IsCloudSignedIn}"
                                        IsEnabled="{Binding !IsCloudBusy}"
                                        Click="CloudSignIn_OnClick" />
                            </StackPanel>
                        </fa:FASettingsExpander.Footer>

                        <fa:FASettingsExpanderItem x:Name="S_CloudBackup_Quota"
                                                   Content="{x:Static lsb:Resources.S_CloudBackup_Quota}"
                                                   Description="{x:Static lsb:Resources.S_CloudBackup_Quota_D}">
                            <fa:FASettingsExpanderItem.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CloudQuotaText}" VerticalAlignment="Center" />
                                    <Button Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="{x:Static lsb:Resources.C_CloudBackup_QuotaRefresh}"
                                            IsEnabled="{Binding !IsCloudQuotaRefreshing}"
                                            Click="CloudQuotaRefresh_OnClick">
                                        <sr:FluentIcon Glyph="{sr:Fi ArrowClockwiseFilled}" />
                                    </Button>
                                </StackPanel>
                            </fa:FASettingsExpanderItem.Footer>
                        </fa:FASettingsExpanderItem>

                        <fa:FASettingsExpanderItem x:Name="S_CloudBackup_OpenStoragePage"
                                                   Content="{x:Static lsb:Resources.S_CloudBackup_OpenStoragePage}"
                                                   Description="{x:Static lsb:Resources.S_CloudBackup_OpenStoragePage_D}"
                                                   IconSource="{sr:FluentIconSource {sr:Fi CloudFilled}}"
                                                   IsClickEnabled="True"
                                                   ActionIconSource="{sr:FluentIconSource {sr:Fi OpenFilled}}"
                                                   Click="CloudStoragePage_OnClick" />
                    </fa:FASettingsExpander>

                    <fa:FASettingsExpander x:Name="S_CloudBackup_Upload"
                                           Header="{x:Static lsb:Resources.S_CloudBackup_Upload}"
                                           Description="{x:Static lsb:Resources.S_CloudBackup_Upload_D}"
                                           IconSource="{sr:FluentIconSource {sr:Fi CloudArrowUpFilled}}"
                                           IsClickEnabled="True"
                                           ActionIconSource="{sr:FluentIconSource {sr:Fi CloudArrowUpFilled}}"
                                           Click="CloudUpload_OnClick">
                        <fa:FASettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding IsCloudUploading}">
                                <TextBlock Text="{x:Static lsb:Resources.M_CloudUploading}"
                                           VerticalAlignment="Center" />
                                <Button Content="{x:Static lsb:Resources.C_CloudBackup_Cancel}"
                                        Click="CloudCancel_OnClick" />
                            </StackPanel>
                        </fa:FASettingsExpander.Footer>
                    </fa:FASettingsExpander>

                    <fa:FASettingsExpander x:Name="S_CloudIncludes"
                                           Header="{x:Static lsb:Resources.S_CloudIncludes}"
                                           Description="{x:Static lsb:Resources.S_CloudIncludes_D}"
                                           IconSource="{sr:FluentIconSource {sr:Fi DatabaseArrowDownFilled}}">
                        <fa:FASettingsExpander.Footer>
                            <sr:MultiComboBox MinWidth="260"
                                              ItemsSource="{Binding CloudIncludeOptions}"
                                              SelectedItems="{Binding SelectedCloudIncludeOptions}" />
                        </fa:FASettingsExpander.Footer>
                    </fa:FASettingsExpander>

                    <fa:FASettingsExpander x:Name="S_CloudAutoBackup"
                                           Header="{x:Static lsb:Resources.S_CloudAutoBackup}"
                                           Description="{x:Static lsb:Resources.S_CloudAutoBackup_D}"
                                           IconSource="{sr:FluentIconSource {sr:Fi CloudSyncFilled}}">
                        <fa:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Settings.CloudAutoBackupEnabled}" />
                        </fa:FASettingsExpander.Footer>

                        <fa:FASettingsExpanderItem x:Name="S_CloudAutoBackup_IntervalDays"
                                                   Content="{x:Static lsb:Resources.S_CloudAutoBackup_IntervalDays}"
                                                   Description="{x:Static lsb:Resources.S_CloudAutoBackup_IntervalDays_D}">
                            <fa:FASettingsExpanderItem.Footer>
                                <NumericUpDown Value="{Binding Settings.CloudAutoBackupIntervalDays}"
                                                Increment="1" Minimum="1" FormatString="0" />
                            </fa:FASettingsExpanderItem.Footer>
                        </fa:FASettingsExpanderItem>

                        <fa:FASettingsExpanderItem x:Name="S_CloudAutoBackup_MaxCount"
                                                   Content="{x:Static lsb:Resources.S_CloudAutoBackup_MaxCount}"
                                                   Description="{x:Static lsb:Resources.S_CloudAutoBackup_MaxCount_D}">
                            <fa:FASettingsExpanderItem.Footer>
                                <NumericUpDown Value="{Binding Settings.CloudAutoBackupMaxCount}"
                                                Increment="1" Minimum="0" FormatString="0" />
                            </fa:FASettingsExpanderItem.Footer>
                        </fa:FASettingsExpanderItem>
                    </fa:FASettingsExpander>

                    <Separator Margin="0 16 0 4" />

                    <sr:IconText x:Name="S_CloudBackup_List"
                                 Text="{x:Static lsb:Resources.S_CloudBackup_List}"
                                 Glyph="{sr:Fi CloudFilled}" Margin="0 0 0 4" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static lsb:Resources.C_CloudBackup_Refresh}"
                                IsEnabled="{Binding !IsCloudBusy}"
                                Click="CloudRefresh_OnClick" />
                        <Button Content="{x:Static lsb:Resources.C_CloudBackup_Cleanup}"
                                IsEnabled="{Binding !IsCloudBusy}"
                                Click="CloudCleanup_OnClick" />
                        <TextBlock Text="{Binding CloudListStatusText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1 1 1 0"
                            CornerRadius="4 4 0 0" ClipToBounds="True">
                        <DataGrid AutoGenerateColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  ItemsSource="{Binding CloudBackups}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="3*" MinWidth="360"
                                                        Header="{x:Static lsb:Resources.C_CloudBackup_Backups_FileName}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="Red"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Width="1.2*" MinWidth="160"
                                                    Header="{x:Static lsb:Resources.C_CloudBackup_Backups_DateTime}"
                                                    Binding="{Binding DateTime}" />

                                <DataGridTextColumn Width="*" MinWidth="96"
                                                    Header="{x:Static lsb:Resources.C_CloudBackup_Backups_Size}"
                                                    Binding="{Binding Size}" />

                                <DataGridTemplateColumn Header="{x:Static lsb:Resources.C_CloudBackup_Backups_Operations}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Theme="{StaticResource TransparentButton}"
                                                        Click="CloudRestoreBackup_OnClick"
                                                        CommandParameter="{Binding}">
                                                    <sr:IconText
                                                        Glyph="{sr:Fi CloudArrowDownFilled}"
                                                        Text="{x:Static lsb:Resources.C_CloudBackup_Backups_Restore}" />
                                                </Button>

                                                <Button Theme="{StaticResource TransparentButton}" Foreground="Red"
                                                        Click="CloudDeleteBackup_OnClick"
                                                        CommandParameter="{Binding}">
                                                    <sr:IconText
                                                        Glyph="{sr:Fi DeleteFilled}"
                                                        Text="{x:Static lsb:Resources.C_Backups_Operations_Delete}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Carousel>
    </Grid>
</UserControl>
