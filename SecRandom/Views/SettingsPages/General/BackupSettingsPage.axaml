<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
             xmlns:lc="clr-namespace:SecRandom.Langs.Common"
             xmlns:lsb="clr-namespace:SecRandom.Langs.SettingsPages.General.Backup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.General.BackupSettingsPage"
             x:DataType="local:BackupSettingsPage">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <fa:FASettingsExpander x:Name="S_AutoBackup"
                                   Header="{x:Static lsb:Resources.S_AutoBackup}"
                                   Description="{x:Static lsb:Resources.S_AutoBackup_D}"
                                   IconSource="{sr:FluentIconSource &#xE083;}"
                                   IsExpanded="True">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.AutoBackupEnabled}" />
                </fa:FASettingsExpander.Footer>

                <fa:FASettingsExpanderItem x:Name="S_AutoBackup_IntervalDays"
                                           Content="{x:Static lsb:Resources.S_AutoBackup_IntervalDays}"
                                           Description="{x:Static lsb:Resources.S_AutoBackup_IntervalDays_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <NumericUpDown Value="{Binding Settings.AutoBackupIntervalDays}"
                                       Increment="1" FormatString="0" MinWidth="150" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_AutoBackup_MaxCount"
                                           Content="{x:Static lsb:Resources.S_AutoBackup_MaxCount}"
                                           Description="{x:Static lsb:Resources.S_AutoBackup_MaxCount_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <NumericUpDown Value="{Binding Settings.AutoBackupMaxCount}"
                                       Increment="1" FormatString="0" MinWidth="150" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_AutoBackup_ViewFolder"
                                           Content="{x:Static lsb:Resources.S_AutoBackup_ViewFolder}"
                                           Description="{x:Static lsb:Resources.S_AutoBackup_ViewFolder_D}"
                                           IconSource="{sr:FluentIconSource &#xE88D;}"
                                           IsClickEnabled="True" ActionIconSource="{sr:FluentIconSource &#xEC2E;}" />

                <fa:FASettingsExpanderItem x:Name="S_AutoBackup_Usage"
                                           Content="{x:Static lsb:Resources.S_AutoBackup_Usage_R}"
                                           Description="{x:Static lsb:Resources.S_AutoBackup_Usage_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock Text="{x:Static lc:Resources.C_ToBeWritten}"
                                   VerticalAlignment="Center" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_AutoBackup_ManualBackup"
                                           Content="{x:Static lsb:Resources.S_AutoBackup_ManualBackup}"
                                           Description="{x:Static lsb:Resources.S_AutoBackup_ManualBackup_D}"
                                           IsClickEnabled="True" />
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Includes"
                                   Header="{x:Static lsb:Resources.S_Includes}"
                                   Description="{x:Static lsb:Resources.S_Includes_D}"
                                   IconSource="{sr:FluentIconSource &#xE601;}">
                <fa:FASettingsExpanderItem x:Name="S_Includes_Config"
                                           Content="{x:Static lsb:Resources.S_Includes_Config}"
                                           Description="{x:Static lsb:Resources.S_Includes_Config_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IncludeConfig}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_Includes_List"
                                           Content="{x:Static lsb:Resources.S_Includes_List}"
                                           Description="{x:Static lsb:Resources.S_Includes_List_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IncludeList}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_Includes_History"
                                           Content="{x:Static lsb:Resources.S_Includes_History}"
                                           Description="{x:Static lsb:Resources.S_Includes_History_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IncludeHistory}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_Includes_Audio"
                                           Content="{x:Static lsb:Resources.S_Includes_Audio}"
                                           Description="{x:Static lsb:Resources.S_Includes_Audio_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IncludeAudio}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_Includes_Cses"
                                           Content="{x:Static lsb:Resources.S_Includes_Cses}"
                                           Description="{x:Static lsb:Resources.S_Includes_Cses_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IncludeCses}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_Includes_Images"
                                           Content="{x:Static lsb:Resources.S_Includes_Images}"
                                           Description="{x:Static lsb:Resources.S_Includes_Images_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IncludeImages}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_Includes_Themes"
                                           Content="{x:Static lsb:Resources.S_Includes_Themes}"
                                           Description="{x:Static lsb:Resources.S_Includes_Themes_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IncludeThemes}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="S_Includes_Logs"
                                           Content="{x:Static lsb:Resources.S_Includes_Logs}"
                                           Description="{x:Static lsb:Resources.S_Includes_Logs_D}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IncludeLogs}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_RestoreBackup"
                         Text="{x:Static lsb:Resources.S_RestoreBackup}"
                         Glyph="&#xE0BD;" Margin="0 0 0 4" />

            <Button Content="{x:Static lsb:Resources.C_RefreshBackups}" />

            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1 1 1 0"
                    CornerRadius="4 4 0 0" ClipToBounds="True">
                <DataGrid AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          ItemsSource="{Binding Backups}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="3*"
                                            Header="{x:Static lsb:Resources.C_Backups_FileName}"
                                            Binding="{Binding FileName}" />

                        <DataGridTextColumn Width="*"
                                            Header="{x:Static lsb:Resources.C_Backups_DateTime}"
                                            Binding="{Binding DateTime}" />

                        <DataGridTextColumn Width="*"
                                            Header="{x:Static lsb:Resources.C_Backups_Size}"
                                            Binding="{Binding Size}" />

                        <DataGridTemplateColumn Header="{x:Static lsb:Resources.C_Backups_Operations}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Theme="{StaticResource TransparentButton}">
                                            <sr:IconText
                                                Glyph="&#xE0BD;"
                                                Text="{x:Static lsb:Resources.C_Backups_Operations_Restore}" />
                                        </Button>

                                        <Button Theme="{StaticResource TransparentButton}" Foreground="Red">
                                            <sr:IconText
                                                Glyph="&#xE61D;"
                                                Text="{x:Static lsb:Resources.C_Backups_Operations_Delete}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>