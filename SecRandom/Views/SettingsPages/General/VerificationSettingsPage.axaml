<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
              xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
              xmlns:lv="clr-namespace:SecRandom.Langs.SettingsPages.General.Verification"
              xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
              x:Class="SecRandom.Views.SettingsPages.General.VerificationSettingsPage"
              x:DataType="local:VerificationSettingsPage"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText Text="{x:Static lv:Resources.S_Verification}"
                         Glyph="{sr:Fi DocumentCheckmarkRegular}"
                         Margin="0 0 0 4" />

            <fa:FAInfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                           Title="{x:Static lv:Resources.C_WitnessNoticeTitle}">
                <TextBlock Text="{x:Static lv:Resources.M_WitnessModeNotice}" TextWrapping="Wrap" />
            </fa:FAInfoBar>

            <fa:FASettingsExpander Header="{x:Static lv:Resources.S_ProofFolder}"
                                    Description="{x:Static lv:Resources.S_ProofFolder_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi FolderOpenRegular}}">
                <fa:FASettingsExpander.Footer>
                    <Button Content="{x:Static lv:Resources.C_OpenProofFolder}"
                            Click="OpenProofFolder_OnClick" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
