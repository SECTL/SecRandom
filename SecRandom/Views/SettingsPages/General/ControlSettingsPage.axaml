<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
             xmlns:lc="clr-namespace:SecRandom.Langs.SettingsPages.General.Control"
             xmlns:cn="clr-namespace:SecRandom.Core.Services.ControlNode;assembly=SecRandom.Core"
             xmlns:cc="clr-namespace:SecRandom.Shared.Models.ControlCenter;assembly=SecRandom.Shared"
             xmlns:vm="clr-namespace:SecRandom.ViewModels.SettingsPages"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.General.ControlSettingsPage"
             x:DataType="vm:ControlSettingsPageViewModel">
    <ScrollViewer>
        <!-- 接入表单只在未接入时显示；已接入状态与清除动作放在下方。 -->
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText x:Name="S_RemoteControl"
                         Text="{x:Static lc:Resources.S_RemoteControl}"
                         Glyph="{sr:Fi PlugConnectedFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_RemoteControl_Enabled"
                                   Header="{x:Static lc:Resources.S_RemoteControl_Enabled}"
                                   Description="{x:Static lc:Resources.S_RemoteControl_Enabled_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ShieldCheckmarkFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding RemoteControlEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 远程抽取页的显隐：默认关闭，只切换侧栏可见性——**不增删侧栏项**，
                 运行时改集合会让 FluentAvalonia 丢选中态（见 MainView.BuildNavigationMenuItems）。 -->
            <fa:FASettingsExpander x:Name="S_RemoteDrawPage"
                                   Header="{x:Static lc:Resources.S_RemoteDrawPage}"
                                   Description="{x:Static lc:Resources.S_RemoteDrawPage_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi SendFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding RemoteDrawPageEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <sr:IconText x:Name="S_ControlPlatform"
                         Text="{x:Static lc:Resources.S_ControlPlatform}"
                         Glyph="{sr:Fi GlobeFilled}"
                         Margin="0 12 0 4" />

            <!-- 打开集控平台：**始终可见**。配了第三方地址时文案会变成"打开第三方托管集控平台"，
                 并且打开的就是那一家的地址——按钮写着官方却跳到别人的服务器是最容易被误点的一处。 -->
            <fa:FASettingsExpander x:Name="S_OpenControlPlane"
                                   Header="{x:Static lc:Resources.S_OpenControlPlane}"
                                   Description="{x:Static lc:Resources.S_OpenControlPlane_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi GlobeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Button Content="{Binding OpenControlPlaneLabel}"
                            Command="{Binding OpenControlPlaneCommand}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RemoteControl_DisplayName"
                                   Header="{x:Static lc:Resources.S_RemoteControl_DisplayName}"
                                   Description="{x:Static lc:Resources.S_RemoteControl_DisplayName_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi TextFontFilled}}">
                <fa:FASettingsExpander.Footer>
                    <!-- 留空则上报主机名：把回落值直接做成水印，用户一眼能看见"不填会显示成什么"。 -->
                    <TextBox Text="{Binding DisplayName}"
                             MinWidth="260"
                             MaxLength="{Binding DisplayNameMaxLength}"
                             PlaceholderText="{Binding HostName}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 当前只显示一种接入表单；设备已有凭据时必须先从下方已接入卡清除。 -->
            <fa:FASettingsExpander x:Name="S_Enrollment"
                                   Header="{x:Static lc:Resources.S_Enrollment}"
                                   Description="{Binding EnrollmentModeDescription}"
                                   IsVisible="{Binding !IsEnrolled}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ShieldCheckmarkFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Static lc:Resources.S_Enrollment_Source}"
                                   Opacity="0.7"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EnrollmentModeLabel}"
                                   VerticalAlignment="Center" />
                        <Button Content="{Binding SwitchEnrollmentModeLabel}"
                                Command="{Binding SwitchEnrollmentModeCommand}"
                                IsEnabled="{Binding CanSwitchEnrollmentMode}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>

                <!-- 账号方式：地点、年级、班级逐级筛选，三项选完后才能接入。 -->
                <fa:FASettingsExpanderItem x:Name="AccountEnrollmentSiteRow"
                                           Content="{x:Static lc:Resources.S_AccountSite}"
                                           IsVisible="{Binding IsAccountEnrollmentMode}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding AccountSites}"
                                  SelectedItem="{Binding SelectedAccountSite}"
                                  MinWidth="220"
                                  IsEnabled="{Binding HasAccountSites}"
                                  PlaceholderText="{x:Static lc:Resources.S_AccountSite}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="cc:ControlCenterSite">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding PublicId}"
                                                   FontSize="11"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="AccountEnrollmentGradeRow"
                                           Content="{x:Static lc:Resources.S_AccountGrade}"
                                           IsVisible="{Binding IsAccountEnrollmentMode}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding AccountGrades}"
                                  SelectedItem="{Binding SelectedAccountGrade}"
                                  MinWidth="220"
                                  IsEnabled="{Binding HasAccountGrades}"
                                  PlaceholderText="{x:Static lc:Resources.S_AccountGrade}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="cc:ControlCenterGrade">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="AccountEnrollmentClassRow"
                                           Content="{x:Static lc:Resources.S_AccountClass}"
                                           IsVisible="{Binding IsAccountEnrollmentMode}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding AccountClasses}"
                                  SelectedItem="{Binding SelectedAccountClass}"
                                  MinWidth="220"
                                  IsEnabled="{Binding HasAccountClasses}"
                                  PlaceholderText="{x:Static lc:Resources.S_AccountClass}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="cc:ControlCenterClass">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem x:Name="AccountEnrollmentActions"
                                           Content="{x:Static lc:Resources.S_AccountCurrent}"
                                           IsVisible="{Binding IsAccountEnrollmentMode}">
                    <fa:FASettingsExpanderItem.Footer>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsAccountSignedIn}">
                            <Button Content="{x:Static lc:Resources.C_SignInAccount}"
                                    Command="{Binding SignInAccountCommand}"
                                    IsEnabled="{Binding CanSignInAccount}" />
                            <TextBlock Text="{x:Static lc:Resources.S_AccountNotSignedIn}"
                                       Opacity="0.7"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAccountSignedIn}">
                            <SelectableTextBlock Text="{Binding AccountName}" VerticalAlignment="Center" />
                            <Button Content="{x:Static lc:Resources.C_RefreshAccount}"
                                    Command="{Binding RefreshAccountCommand}"
                                    IsEnabled="{Binding !IsAccountBusy}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAccountSignedIn}">
                            <Button Content="{x:Static lc:Resources.C_EnrollAccount}"
                                    Command="{Binding EnrollWithAccountCommand}"
                                    IsEnabled="{Binding CanEnrollWithAccount}" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     IsVisible="{Binding IsAccountBusy}" />
                    </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!-- 默认地点码方式。清除动作只放在下方已接入卡。 -->
                <fa:FASettingsExpanderItem x:Name="PairCodeEnrollmentRow"
                                           Content="{x:Static lc:Resources.S_NodeEnrollment}"
                                           IsVisible="{Binding !IsAccountEnrollmentMode}">
                    <fa:FASettingsExpanderItem.Footer>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding SiteIdInput}"
                                     Width="130"
                                     MaxLength="{Binding SiteIdMaxLength}"
                                     PlaceholderText="{x:Static lc:Resources.S_Enrollment_SiteId_Ph}"
                                     ToolTip.Tip="{x:Static lc:Resources.S_Enrollment_SiteId_D}" />
                            <TextBox Text="{Binding PairingCodeInput}"
                                     Width="150"
                                     MaxLength="{Binding PairingCodeMaxLength}"
                                     PlaceholderText="{x:Static lc:Resources.S_Enrollment_PairingCode_Ph}"
                                     ToolTip.Tip="{x:Static lc:Resources.S_Enrollment_PairingCode_D}" />
                            <Button Content="{x:Static lc:Resources.C_Enroll}"
                                    Command="{Binding EnrollCommand}"
                                    IsEnabled="{Binding CanEnroll}" />
                        </StackPanel>
                    </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Enrolled"
                                   Header="{x:Static lc:Resources.S_Enrolled}"
                                   Description="{Binding EnrollmentStatusText}"
                                   IsVisible="{Binding ShowEnrollmentStatus}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PeopleFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static lc:Resources.S_Enrollment_Site}"
                                       Opacity="0.7"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Text="{Binding EnrolledSiteText}"
                                                 FontFamily="Consolas,monospace" />
                            <TextBlock Text="{x:Static lc:Resources.S_Enrollment_Device}"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       Margin="12 0 0 0" />
                            <SelectableTextBlock Text="{Binding EnrolledDeviceText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static lc:Resources.S_Enrollment_Source}"
                                       Opacity="0.7"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Text="{Binding EnrollmentSourceText}" />
                        </StackPanel>
                        <Button Content="{x:Static lc:Resources.C_ClearEnrollment}"
                                Command="{Binding ClearEnrollmentCommand}"
                                IsEnabled="{Binding CanClearEnrollment}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <!-- 年级 → 班级级联：树只在接入后拉一次，切年级不重新请求。
                 年级和班级**都必须选中**才能保存：只选年级等于"不分班"，设备会哪个班都不属于。
                 已绑定班级时先不显示选择器的作用——必须先「解除班级」，才能重新选。 -->
            <fa:FASettingsExpander x:Name="S_Enrollment_Class"
                                   Header="{x:Static lc:Resources.S_Enrollment_Class}"
                                   Description="{x:Static lc:Resources.S_Enrollment_Class_D}"
                                   IsVisible="{Binding IsEnrolled}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PeopleFilled}}">
                <fa:FASettingsExpander.Footer>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Static lc:Resources.S_Enrollment_CurrentClass}"
                                       Opacity="0.7"
                                       VerticalAlignment="Center" />
                            <SelectableTextBlock Text="{Binding EnrolledClassText}"
                                                 VerticalAlignment="Center" />
                            <Button Content="{x:Static lc:Resources.C_ClearClass}"
                                    Command="{Binding ClearClassCommand}"
                                    IsEnabled="{Binding CanClearClass}"
                                    IsVisible="{Binding HasBoundClass}" />
                        </StackPanel>
                        <TextBlock Text="{x:Static lc:Resources.S_Enrollment_Class_ClearFirst}"
                                   IsVisible="{Binding HasBoundClass}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsEnabled="{Binding CanPickClass}">
                            <ComboBox ItemsSource="{Binding GradeOptions}"
                                      SelectedItem="{Binding SelectedGrade}"
                                      MinWidth="150"
                                      PlaceholderText="{x:Static lc:Resources.S_Enrollment_Grade}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="cn:ControlGradeNode">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{Binding ClassOptions}"
                                      SelectedItem="{Binding SelectedClass}"
                                      MinWidth="150"
                                      PlaceholderText="{x:Static lc:Resources.S_Enrollment_Class_Ph}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="cn:ControlClassNode">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{x:Static lc:Resources.C_SaveClass}"
                                    Command="{Binding SaveClassCommand}"
                                    IsEnabled="{Binding CanSaveClass}" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     IsVisible="{Binding IsTreeLoading}" />
                        <!-- 班级保存结果同样走 Toast，理由见上方接入区的注释。 -->
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <sr:IconText x:Name="S_ConnectionStatus"
                         Text="{x:Static lc:Resources.S_ConnectionStatus}"
                         Glyph="{sr:Fi DesktopPulseFilled}"
                         Margin="0 12 0 4" />

            <fa:FASettingsExpander x:Name="S_RemoteControl_Status"
                                   Header="{x:Static lc:Resources.S_RemoteControl_Status}"
                                   Description="{x:Static lc:Resources.S_RemoteControl_Status_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi DesktopPulseFilled}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusDetail}" Opacity="0.7" VerticalAlignment="Center" />
                    <Button Content="{x:Static lc:Resources.C_Reconnect}"
                            Command="{Binding ReconnectCommand}" />
                </StackPanel>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_RemoteControl_DrawLocked"
                                   Header="{x:Static lc:Resources.S_RemoteControl_DrawLocked}"
                                   Description="{x:Static lc:Resources.S_RemoteControl_DrawLocked_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi LockClosedFilled}}">
                <fa:FASettingsExpander.Footer>
                    <TextBlock Text="{Binding DrawLocked}" VerticalAlignment="Center" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
