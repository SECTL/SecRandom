<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.General.Privacy"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.General.PrivacySettingsPage"
             x:DataType="local:PrivacySettingsPage">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText x:Name="S_SentryTelemetry"
                         Text="{x:Static lsp:Resources.S_SentryTelemetry}"
                         Glyph="{sr:Fi PulseSquareRegular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_SentryTelemetry_Enabled"
                                   Header="{x:Static lsp:Resources.S_SentryTelemetry_Enabled}"
                                   Description="{x:Static lsp:Resources.S_SentryTelemetry_Enabled_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PulseRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.SentryTelemetryEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_OnlineStatus"
                         Text="{x:Static lsp:Resources.S_OnlineStatus}"
                         Glyph="{sr:Fi GlobeRegular}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_OnlineStatus_Mode"
                                   Header="{x:Static lsp:Resources.S_OnlineStatus_Mode}"
                                   Description="{x:Static lsp:Resources.S_OnlineStatus_Mode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi GlobeRegular}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.OnlineStatusMode}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_OnlineStatusMode_Full}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_OnlineStatusMode_Anonymous}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_OnlineStatusMode_Off}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
