<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             x:Class="SecRandom.Views.SettingsPages.General.FeatureConfigurationSettingsPage"
             x:DataType="local:FeatureConfigurationSettingsPage">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings" Spacing="12">
            <sr:IconText Text="{Binding PageTitle}"
                         Glyph="{sr:Fi AppsFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="ProfileExpander"
                                   Description="{Binding ProfileDescription}"
                                   IconSource="{sr:FluentIconSource {sr:Fi AppsFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="ProfileSelector"
                                  MinWidth="180"
                                  SelectionChanged="ProfileSelector_OnSelectionChanged" />
                        <Button Grid.Column="1" x:Name="ActivateButton"
                                Click="Activate_OnClick" />
                        <Button Grid.Column="2" x:Name="SaveAsButton"
                                Click="SaveAs_OnClick" />
                        <Button Grid.Column="3" x:Name="SaveButton"
                                Classes="accent"
                                Click="Save_OnClick" />
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="CountText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <TabControl x:Name="CategoryTabs"
                        SelectionChanged="CategoryTabs_OnSelectionChanged" />

            <StackPanel x:Name="PageContent" Spacing="8" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="RenameButton" Click="Rename_OnClick" />
                <Button x:Name="DeleteButton" Click="Delete_OnClick" />
                <Button x:Name="DiscardButton" Click="Discard_OnClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
