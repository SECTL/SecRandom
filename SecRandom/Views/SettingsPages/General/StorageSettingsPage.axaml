<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.General.Storage"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.Views.SettingsPages.General.StorageSettingsPage"
             x:DataType="local:StorageSettingsPage">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <TextBlock Text="{x:Static lsp:Resources.M_LegacyNotice}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       IsVisible="{Binding NeedsMigrationNotice}"
                       Margin="0 8 0 0" />

            <sr:IconText x:Name="S_Change"
                         Text="{x:Static lsp:Resources.S_Change}"
                         Glyph="{sr:Fi FolderOpenFilled}"
                         Margin="0 0 0 4" />

            <TextBlock Text="{x:Static lsp:Resources.S_Change_D}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0 0 0 8" />

            <fa:FASettingsExpander x:Name="S_Mode"
                                   Header="{x:Static lsp:Resources.S_Mode}"
                                   Description="{x:Static lsp:Resources.S_Mode_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ArrowSyncFilled}}"
                                   IsVisible="{Binding IsDesktop}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding ModeIndex}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Mode_Package}"
                                      IsEnabled="{Binding IsPackageModeAvailable}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Mode_Standard}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Mode_Custom}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Target"
                                   Header="{x:Static lsp:Resources.S_Target}"
                                   Description="{x:Static lsp:Resources.S_Target_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FolderOpenFilled}}"
                                   IsVisible="{Binding IsCustomMode}">
                <fa:FASettingsExpander.Footer>
                    <Grid ColumnDefinitions="280,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding TargetPath}"
                                 IsReadOnly="{Binding IsTargetReadOnly}"
                                 PlaceholderText="{x:Static lsp:Resources.S_Target}" />
                        <Button Grid.Column="1"
                                Content="{x:Static lsp:Resources.C_Browse}"
                                Click="Browse_OnClick"
                                IsEnabled="{Binding CanBrowse}" />
                    </Grid>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Migrate"
                                   Header="{x:Static lsp:Resources.C_Migrate}"
                                   Description="{x:Static lsp:Resources.S_Migrate_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ArrowSyncFilled}}"
                                   IsVisible="{Binding IsDesktop}">
                <fa:FASettingsExpander.Footer>
                    <Button Content="{x:Static lsp:Resources.C_Migrate}"
                            Click="Migrate_OnClick"
                            Classes="accent"
                            IsEnabled="{Binding IsReadyToMigrate}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0 8 0 0"
                       IsVisible="{Binding HasStatus}" />

            <fa:FASettingsExpander x:Name="S_OtherRoots"
                                   Header="{x:Static lsp:Resources.S_OtherRoots}"
                                   Description="{x:Static lsp:Resources.S_OtherRoots_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi FolderOpenFilled}}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static lsp:Resources.M_NoOtherRoots}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               IsVisible="{Binding !HasOtherRoots}" />
                    <ItemsControl ItemsSource="{Binding OtherRoots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander x:Name="S_Location"
                                   Header="{x:Static lsp:Resources.S_Location}"
                                   Description="{x:Static lsp:Resources.S_CurrentRoot_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi HardDriveFilled}}"
                                   IsExpanded="True">
                <StackPanel Spacing="10">
                    <StackPanel x:Name="S_CurrentRoot" Spacing="2">
                        <TextBlock Text="{x:Static lsp:Resources.S_CurrentRoot}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding CurrentRoot}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="S_Source" Spacing="2">
                        <TextBlock Text="{x:Static lsp:Resources.S_Source}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="S_AnchorPath" Spacing="2" IsVisible="{Binding HasAnchor}">
                        <TextBlock Text="{x:Static lsp:Resources.S_AnchorPath}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding AnchorPathText}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>