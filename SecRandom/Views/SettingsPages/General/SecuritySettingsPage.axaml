<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.General"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.Security"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d"
             x:Class="SecRandom.Views.SettingsPages.General.SecuritySettingsPage"
             x:DataType="local:SecuritySettingsPage"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro settings">
            <sr:IconText Text="{x:Static lsp:Resources.S_Credentials}" Glyph="{sr:Fi ShieldKeyholeFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_Enabled}"
                                   Description="{x:Static lsp:Resources.S_Enabled_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ShieldKeyholeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.SecurityEnabled}"
                                  IsEnabled="{Binding CanEnableSecurity}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_Password}"
                                   Description="{x:Static lsp:Resources.S_Password_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PasswordFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Button Content="{Binding PasswordButtonText}" Click="ManagePassword_OnClick" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_Totp}"
                                   Description="{x:Static lsp:Resources.S_Totp_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ShieldKeyholeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Button Content="{Binding TotpButtonText}" IsEnabled="{Binding CanConfigureAdditionalFactors}"
                            Click="ManageTotp_OnClick" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_Usb}"
                                   Description="{x:Static lsp:Resources.S_Usb_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi UsbStickFilled}}">
                <fa:FASettingsExpander.Footer>
                    <Button Content="{x:Static lsp:Resources.C_ManageBindings}"
                            IsEnabled="{Binding CanConfigureAdditionalFactors}" Click="ManageUsb_OnClick" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lsp:Resources.S_Factors}" Glyph="{sr:Fi PasswordFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_Factors}"
                                    Description="{x:Static lsp:Resources.S_Factors_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi PasswordFilled}}">
                <fa:FASettingsExpander.Footer>
                    <u:MultiComboBox MinWidth="260" ItemsSource="{Binding FactorOptions}"
                                      SelectedItems="{Binding SelectedFactorOptions}"
                                      IsEnabled="{Binding CanEditFactorSelection}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_RequireAll}"
                                   Description="{x:Static lsp:Resources.S_RequireAll_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi ShieldKeyholeFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.RequireAllSelectedFactors}"
                                  IsEnabled="{Binding CanEditFactorSelection}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lsp:Resources.S_Protection}" Glyph="{sr:Fi LockClosedFilled}" Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_WindowOperations}"
                                   Description="{x:Static lsp:Resources.S_WindowOperations_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                <CheckBox Content="{x:Static lsp:Resources.C_OpenSettings}"
                          IsChecked="{Binding Settings.ProtectOpenSettings}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_AllowSettingsPreview}"
                          IsChecked="{Binding Settings.AllowSettingsPreview}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_ToggleMainWindow}"
                          IsChecked="{Binding Settings.ProtectToggleMainWindow}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_ToggleFloatingWindow}"
                          IsChecked="{Binding Settings.ProtectToggleFloatingWindow}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_Restart}"
                          IsChecked="{Binding Settings.ProtectRestart}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_Exit}"
                          IsChecked="{Binding Settings.ProtectExit}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_DrawOperations}"
                                   Description="{x:Static lsp:Resources.S_DrawOperations_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PeopleFilled}}">
                <CheckBox Content="{x:Static lsp:Resources.C_RollCallStart}"
                          IsChecked="{Binding Settings.ProtectRollCallStart}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_RollCallReset}"
                          IsChecked="{Binding Settings.ProtectRollCallReset}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_QuickDrawStart}"
                          IsChecked="{Binding Settings.ProtectQuickDrawStart}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_QuickDrawReset}"
                          IsChecked="{Binding Settings.ProtectQuickDrawReset}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_LotteryStart}"
                          IsChecked="{Binding Settings.ProtectLotteryStart}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />

                <CheckBox Content="{x:Static lsp:Resources.C_LotteryReset}"
                          IsChecked="{Binding Settings.ProtectLotteryReset}"
                          IsEnabled="{Binding CanEditProtectedOperations}" />
            </fa:FASettingsExpander>

            <TextBlock Text="{Binding LockoutText}"
                       IsVisible="{Binding IsLockedOut}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
