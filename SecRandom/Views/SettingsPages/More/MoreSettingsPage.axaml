<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
              xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.More"
             xmlns:lsp="clr-namespace:SecRandom.Langs.SettingsPages.More"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
               x:Class="SecRandom.Views.SettingsPages.More.MoreSettingsPage"
              x:DataType="local:MoreSettingsPage"
              Focusable="True"
              Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="page-container animated-intro">
            <sr:IconText x:Name="S_Music"
                         Text="{x:Static lsp:Resources.S_Music}"
                         Glyph="{sr:Fi MusicNote2Filled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Music_BackgroundLoop"
                                   Header="{x:Static lsp:Resources.S_Music_BackgroundLoop}"
                                   Description="{x:Static lsp:Resources.S_Music_BackgroundLoop_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi MusicNote2Filled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.BackgroundMusicLoop}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText Text="{x:Static lsp:Resources.S_PageManagement}"
                          Glyph="{sr:Fi PanelRightFilled}"
                          Margin="0 0 0 4" />

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_RollCallPanelPosition}"
                                   Description="{x:Static lsp:Resources.S_RollCallPanelPosition_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi PanelRightFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.RollCallControlPanelPosition}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Right}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Left}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_RollCallControls}"
                                    Description="{x:Static lsp:Resources.S_RollCallControls_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi AppsListFilled}}">
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_RollCallResetButton}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.RollCallResetButton}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_RollCallQuantityControl}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.RollCallQuantityControl}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_RollCallStartButton}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.RollCallStartButton}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_RollCallListSelector}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.RollCallListSelector}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_RollCallRangeSelector}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.RollCallRangeSelector}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_RollCallGenderSelector}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.RollCallGenderSelector}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_RollCallRemainingButton}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.RollCallRemainingButton}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_RollCallQuantityLabel}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.RollCallQuantityLabel}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_LotteryEnabled}"
                                   Description="{x:Static lsp:Resources.S_LotteryEnabled_D}"
                                   IconSource="{sr:FluentIconSource {sr:Fi GiftFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.LotteryEnabled}" />
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_LotteryPanelPosition}"
                                    Description="{x:Static lsp:Resources.S_LotteryPanelPosition_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi GiftFilled}}"
                                    IsVisible="{Binding Settings.LotteryEnabled}">
                <fa:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding Settings.LotteryControlPanelPosition}">
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Right}" />
                        <ComboBoxItem Content="{x:Static lsp:Resources.O_Left}" />
                    </ComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>

            <fa:FASettingsExpander Header="{x:Static lsp:Resources.S_LotteryControls}"
                                    Description="{x:Static lsp:Resources.S_LotteryControls_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi AppsListFilled}}"
                                    IsVisible="{Binding Settings.LotteryEnabled}">
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryResetButton}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryResetButton}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryQuantityControl}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryQuantityControl}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryStartButton}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryStartButton}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryListSelector}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryListSelector}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryStudentListSelector}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryStudentListSelector}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryRangeSelector}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryRangeSelector}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryGenderSelector}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryGenderSelector}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryRemainingButton}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryRemainingButton}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_LotteryQuantityLabel}">
                    <fa:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.LotteryQuantityLabel}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <sr:IconText x:Name="S_Shortcut"
                         Text="{x:Static lsp:Resources.S_Shortcut}"
                         Glyph="{sr:Fi FlashFilled}"
                         Margin="0 0 0 4" />

            <fa:FASettingsExpander x:Name="S_Shortcut_Card"
                                    Header="{x:Static lsp:Resources.S_Shortcut}"
                                    Description="{x:Static lsp:Resources.S_Shortcut_D}"
                                    IconSource="{sr:FluentIconSource {sr:Fi KeyboardFilled}}">
                <fa:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.EnableShortcut}" />
                </fa:FASettingsExpander.Footer>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_OpenRollCallPage}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsOpenRollCallPageShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="OpenRollCallPageShortcut" Text="{Binding Settings.OpenRollCallPageShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="OpenRollCallPageShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_QuickDraw}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsQuickDrawShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="QuickDrawShortcut" Text="{Binding Settings.QuickDrawShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="QuickDrawShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_OpenLotteryPage}"
                                           IsVisible="{Binding Settings.LotteryEnabled}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsOpenLotteryPageShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="OpenLotteryPageShortcut" Text="{Binding Settings.OpenLotteryPageShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="OpenLotteryPageShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_IncreaseRollCallCount}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsIncreaseRollCallCountShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="IncreaseRollCallCountShortcut" Text="{Binding Settings.IncreaseRollCallCountShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="IncreaseRollCallCountShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_DecreaseRollCallCount}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsDecreaseRollCallCountShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="DecreaseRollCallCountShortcut" Text="{Binding Settings.DecreaseRollCallCountShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="DecreaseRollCallCountShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_IncreaseLotteryCount}"
                                           IsVisible="{Binding Settings.LotteryEnabled}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsIncreaseLotteryCountShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="IncreaseLotteryCountShortcut" Text="{Binding Settings.IncreaseLotteryCountShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="IncreaseLotteryCountShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_DecreaseLotteryCount}"
                                           IsVisible="{Binding Settings.LotteryEnabled}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsDecreaseLotteryCountShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="DecreaseLotteryCountShortcut" Text="{Binding Settings.DecreaseLotteryCountShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="DecreaseLotteryCountShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_StartRollCall}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsStartRollCallShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="StartRollCallShortcut" Text="{Binding Settings.StartRollCallShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="StartRollCallShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
                <fa:FASettingsExpanderItem Content="{x:Static lsp:Resources.S_Shortcut_StartLottery}"
                                           IsVisible="{Binding Settings.LotteryEnabled}">
                    <fa:FASettingsExpanderItem.Footer>
                        <Grid ColumnDefinitions="50,8,180,32">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static lsp:Resources.C_ShortcutConflict}"
                                       IsVisible="{Binding IsStartLotteryShortcutConflicted}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Tag="StartLotteryShortcut" Text="{Binding Settings.StartLotteryShortcut}"
                                     IsReadOnly="True" PlaceholderText="{x:Static lsp:Resources.C_ShortcutCapture}"
                                     KeyDown="ShortcutBox_OnKeyDown" />
                            <Button Grid.Column="3" Tag="StartLotteryShortcut" Theme="{StaticResource TransparentButton}"
                                    ToolTip.Tip="{x:Static lsp:Resources.C_ShortcutClear}"
                                    Click="ClearShortcutButton_OnClick">
                                <sr:FluentIcon Glyph="{sr:Fi DismissCircleFilled}" />
                            </Button>
                        </Grid>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
