<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.ListManagement"
             xmlns:lr="clr-namespace:SecRandom.Langs.SettingsPages.ListManagement.LotteryList"
             xmlns:corelr="clr-namespace:SecRandom.Core.Langs.Common;assembly=SecRandom.Core"
             xmlns:services="clr-namespace:SecRandom.Core.Services;assembly=SecRandom.Core"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
             x:Class="SecRandom.Views.SettingsPages.ListManagement.LotteryListSettingsPage"
             x:DataType="local:LotteryListSettingsPage"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <Grid x:Key="ChangeCurrentListDrawer" Width="320" RowDefinitions="Auto *" RowSpacing="8" Margin="16">
            <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4">
                <TextBlock Theme="{StaticResource SubtitleTextBlockStyle}"
                           Text="{x:Static lr:Resources.C_CurrentList}" />

                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static lr:Resources.C_CurrentList_D}" />

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="{x:Static lr:Resources.C_AddList}" Click="AddListButton_OnClick" />
                    <Button Content="{x:Static lr:Resources.C_RenameList}" Click="RenameListButton_OnClick" />
                    <Button Content="{x:Static lr:Resources.C_DeleteList}" Click="DeleteListButton_OnClick" />
                </StackPanel>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding PrizeListNames}"
                     SelectedItem="{Binding SelectedPrizeListName, Mode=TwoWay}"
                     SelectionChanged="PrizeListListBox_OnSelectionChanged" />
        </Grid>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto *" RowSpacing="8" Classes="page-container animated-intro">
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <fa:FACommandBar DefaultLabelPosition="Right">
                <fa:FACommandBar.PrimaryCommands>
                    <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi PeopleListFilled}}"
                                           Label="{Binding SelectedPrizeListName}"
                                           ToolTip.Tip="{x:Static lr:Resources.C_CurrentList_D}"
                                           Click="ChangeCurrentListButton_OnClick" />

                    <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi ArrowClockwiseFilled}}"
                                           Label="{x:Static lr:Resources.C_Refresh}"
                                           Click="RefreshButton_OnClick" />

                    <fa:FACommandBarSeparator />

                    <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi PersonAddFilled}}"
                                           Label="{x:Static lr:Resources.C_AddPrize}"
                                           Click="AddPrizeButton_OnClick" />

                    <fa:FACommandBarButton IconSource="{sr:FluentIconSource {sr:Fi PeopleAddFilled}}"
                                           Label="{x:Static lr:Resources.C_ImportList}"
                                           Click="ImportButton_OnClick" />
                </fa:FACommandBar.PrimaryCommands>
            </fa:FACommandBar>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4 4 0 0"
                ClipToBounds="True">
            <DataGrid MinHeight="320"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      ItemsSource="{Binding SelectedPrizeList.Prizes}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn MinWidth="64"
                                            Header="{x:Static lr:Resources.C_Exists}"
                                            Binding="{Binding Exists}" />
                    
                    <DataGridTextColumn Width="0.8*" MinWidth="80"
                                        Header="{x:Static lr:Resources.C_PrizeId}"
                                        Binding="{Binding Id}" />
                    
                    <DataGridTextColumn Width="1.5*" MinWidth="150"
                                        Header="{x:Static lr:Resources.C_Name}"
                                        Binding="{Binding Name}" />
                    
                    <DataGridTextColumn Width="1*" MinWidth="100"
                                        Header="{x:Static lr:Resources.C_Weight}"
                                        Binding="{Binding Weight}" />
                    
                    <DataGridTextColumn Width="1*" MinWidth="100"
                                        Header="{x:Static lr:Resources.C_Count}"
                                        Binding="{Binding Count}" />
                    
                    <DataGridTextColumn Width="1.2*" MinWidth="120"
                                        Header="{x:Static lr:Resources.C_Tags}"
                                        Binding="{Binding Tags}" />
                    
                    <DataGridTemplateColumn MinWidth="96"
                                            Header="{x:Static corelr:Resources.C_AttachedSettings}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <sr:AttachedSettingsFlyoutButton
                                    TargetObject="{Binding}"
                                    ControlInfos="{x:Static services:AttachedSettingsRegistryService.PrizeAttachedSettingsControls}"
                                    SettingsChanged="AttachedSettings_OnSettingsChanged" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn MinWidth="64"
                                            Header="{x:Static lr:Resources.C_Operations}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="32"
                                        Height="32"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Theme="{StaticResource TransparentButton}"
                                        Foreground="Red"
                                        ToolTip.Tip="{x:Static lr:Resources.C_DeletePrize}"
                                        AutomationProperties.Name="{x:Static lr:Resources.C_DeletePrize}"
                                        CommandParameter="{Binding}"
                                        Click="DeletePrizeButton_OnClick">
                                    <sr:FluentIcon Glyph="{sr:Fi DeleteFilled}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
