<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SecRandom.Views.SettingsPages.ListManagement"
             xmlns:controls="clr-namespace:SecRandom.Controls"
             xmlns:lr="clr-namespace:SecRandom.Langs.SettingsPages.ListManagement.RollCallList"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="720"
             x:Class="SecRandom.Views.SettingsPages.ListManagement.RollCallListImportView"
             x:DataType="local:RollCallListImportView">
    <ScrollViewer Width="400">
        <StackPanel Margin="16" Spacing="8">
            <TextBlock Text="{x:Static lr:Resources.C_ImportTitle}" Theme="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{Binding TargetListDescription}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            
            <fa:FAInfoBar Title="{x:Static lr:Resources.C_InfoTitle}"
                          Message="{x:Static lr:Resources.C_InfoMessage}"
                          Severity="Informational"
                          IsClosable="False"
                          IsOpen="True" />

            <GroupBox Header="{Binding ImportSourceLabel}">
                <SplitButton x:Name="ImportSplitButton"
                             Classes="accent"
                             Content="{Binding FileImportModeLabel}"
                             Click="ImportSplitButton_OnClick">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem x:Name="FileImportMenuItem"
                                      Click="FileImportMenuItem_OnClick" />
                            <MenuItem x:Name="QuickQrImportMenuItem"
                                      Click="QuickQrImportMenuItem_OnClick" />
                            <MenuItem x:Name="OfflineQrImportMenuItem"
                                      Click="OfflineQrImportMenuItem_OnClick" />
                            <MenuItem x:Name="SessionCodeImportMenuItem"
                                      Click="SessionCodeImportMenuItem_OnClick" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </GroupBox>
            <StackPanel Spacing="4">
                    <TextBlock IsVisible="{Binding IsFileImportMode}"
                               Text="{Binding SelectedFileName}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock IsVisible="{Binding IsFileImportMode}"
                               Text="{x:Static lr:Resources.C_SupportedFormats}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <GroupBox IsVisible="{Binding IsQrImportMode}" Header="{Binding QrImportLabel}">
                <StackPanel Spacing="10">
                    <Border Height="220" ClipToBounds="True" CornerRadius="4"
                            IsVisible="{Binding IsCameraPreviewSupported}"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <controls:RosterQrCameraPreview x:Name="CameraControl" />
                    </Border>
                    <ProgressBar IsVisible="{Binding IsQrTransferStatsVisible}" Minimum="0" Maximum="1" Value="{Binding QrProgress}" />
                    <Grid IsVisible="{Binding IsQrTransferStatsVisible}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                        <StackPanel><TextBlock Classes="caption" Text="{Binding TransferProgressLabel}" /><TextBlock Text="{Binding QrProgressText}" FontSize="18" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Classes="caption" Text="{Binding TransferSpeedLabel}" /><TextBlock Text="{Binding QrDecodeSpeedText}" FontSize="18" /></StackPanel>
                        <StackPanel Grid.Row="1"><TextBlock Classes="caption" Text="{Binding TransferReceivedLabel}" /><TextBlock Text="{Binding QrPayloadText}" FontSize="18" /></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Classes="caption" Text="{Binding TransferFramesDetailLabel}" /><TextBlock Text="{Binding QrFramesText}" FontSize="18" /></StackPanel>
                        <StackPanel Grid.Row="2"><TextBlock Classes="caption" Text="{Binding TransferSessionLabel}" /><TextBlock Text="{Binding QrSessionText}" FontSize="18" /></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Classes="caption" Text="{Binding TransferElapsedLabel}" /><TextBlock Text="{Binding QrElapsedText}" FontSize="18" /></StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox IsVisible="{Binding IsSessionCodeImportMode}" Header="{Binding SessionCodeImportModeLabel}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SessionCodeHint}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="SessionCodeInput" MaxLength="12" TextAlignment="Center"
                             FontSize="17" TextChanged="SessionCodeInput_OnTextChanged" />
                </StackPanel>
            </GroupBox>

            <GroupBox IsVisible="{Binding IsFileImportMode}"
                      Header="{x:Static lr:Resources.C_ColumnMapping}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Static lr:Resources.C_ColumnMapping_D}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <sr:Field Label="{x:Static lr:Resources.C_StudentIdColumn}">
                        <ComboBox ItemsSource="{Binding OptionalColumnOptions}"
                                  SelectedItem="{Binding IdColumn, Mode=TwoWay}" />
                    </sr:Field>
                    <sr:Field Label="{x:Static lr:Resources.C_NameColumn}">
                        <ComboBox ItemsSource="{Binding OptionalColumnOptions}"
                                  SelectedItem="{Binding NameColumn, Mode=TwoWay}" />
                    </sr:Field>
                    <sr:Field Label="{x:Static lr:Resources.C_GenderColumn}">
                        <ComboBox ItemsSource="{Binding OptionalColumnOptions}"
                                  SelectedItem="{Binding GenderColumn, Mode=TwoWay}" />
                    </sr:Field>
                    <sr:Field Label="{x:Static lr:Resources.C_GroupColumn}">
                        <ComboBox ItemsSource="{Binding OptionalColumnOptions}"
                                  SelectedItem="{Binding GroupColumn, Mode=TwoWay}" />
                    </sr:Field>
                    <sr:Field Label="{x:Static lr:Resources.C_TagsColumn}">
                        <ComboBox ItemsSource="{Binding OptionalColumnOptions}"
                                  SelectedItem="{Binding TagsColumn, Mode=TwoWay}" />
                    </sr:Field>
                </StackPanel>
            </GroupBox>

            <Border IsVisible="{Binding HasPreview}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1" CornerRadius="4 4 0 0" ClipToBounds="True">
                <DataGrid Height="150"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          GridLinesVisibility="Horizontal"
                          ItemsSource="{Binding PreviewRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" MinWidth="50"
                                            Header="{x:Static lr:Resources.C_StudentId}"
                                            Binding="{Binding Id}" />
                        <DataGridTextColumn Width="2*" MinWidth="100"
                                            Header="{x:Static lr:Resources.C_Name}"
                                            Binding="{Binding Name}" />
                        <DataGridTextColumn Width="*" MinWidth="50"
                                            Header="{x:Static lr:Resources.C_Gender}"
                                            Binding="{Binding Gender}" />
                        <DataGridTextColumn Width="*" MinWidth="50"
                                            Header="{x:Static lr:Resources.C_Group}"
                                            Binding="{Binding Group}" />
                        <DataGridTextColumn Width="*" MinWidth="50"
                                            Header="{x:Static lr:Resources.C_Tags}"
                                            Binding="{Binding Tags}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid ColumnDefinitions="* Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding StatusText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Content="{x:Static lr:Resources.C_Cancel}" Click="CancelButton_OnClick" />
                    <Button Classes="accent"
                            Content="{x:Static lr:Resources.C_Import}"
                            IsEnabled="{Binding CanImport}"
                            Click="ImportButton_OnClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
