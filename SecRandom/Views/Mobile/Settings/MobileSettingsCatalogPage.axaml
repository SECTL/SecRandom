<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:local="clr-namespace:SecRandom.Views.Mobile.Settings"
             xmlns:langs="using:SecRandom.Langs.Mobile"
             x:Class="SecRandom.Views.Mobile.Settings.MobileSettingsCatalogPage"
             x:DataType="local:MobileSettingsCatalogPage">
    <ScrollViewer x:Name="PageScroll">
        <StackPanel Classes="page-container" Orientation="Vertical">
            <!-- 账号区固定在设置页最顶部：手机端没有标题栏账号入口，未登录时这里是唯一的登录入口。 -->
            <Border Margin="0 0 0 12"
                    Padding="14"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!--
                            头像是一个圆：三种状态共用**同一个**外圈（同一套中性 token + 描边），
                            只在里面换内容（人形图标 / 首字 / 真实头像）。这样浅色与深色主题下底色
                            永远来自主题资源，不会出现"未登录是一个不透明强调色圆、已登录是另一种底色"。
                            整体不透明底色（AccentFillColorDefault）在深色主题里会变成一个很扎眼的高饱和圆点，
                            而未登录本来只是一个占位——所以这里用 ControlFillColorSecondary + ControlStrokeColorDefault。
                        -->
                        <Border Width="44"
                                Height="44"
                                CornerRadius="22"
                                ClipToBounds="True"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Panel>
                                <!-- 未登录：人形轮廓，不留一个空的彩色圆 -->
                                <sr:FluentIcon Glyph="{sr:Fi PersonFilled}"
                                               FontSize="22"
                                               Opacity="0.6"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding Account.ShowPlaceholder}" />
                                <!-- 已登录但还没有头像：首字 -->
                                <TextBlock Text="{Binding Account.Initial}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding Account.ShowInitial}" />
                                <Image Source="{Binding Account.Avatar}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding Account.HasAvatar}" />
                            </Panel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Account.DisplayName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Account.IsSignedIn}" />
                            <TextBlock Text="{x:Static langs:Resources.MA_SignedOutHint}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !Account.IsSignedIn}" />
                            <TextBlock Text="{x:Static langs:Resources.MA_Reauthorize}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Account.RequiresReauthorization}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Classes="accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static langs:Resources.MA_SignIn}"
                            Command="{Binding Account.SignInCommand}"
                            IsEnabled="{Binding !Account.IsBusy}"
                            IsVisible="{Binding !Account.IsSignedIn}" />
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Content="{x:Static langs:Resources.MA_SignOut}"
                            Command="{Binding Account.SignOutCommand}"
                            IsEnabled="{Binding !Account.IsBusy}"
                            IsVisible="{Binding Account.IsSignedIn}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Classes="page-container" Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <fa:FASettingsExpander ItemsSource="{Binding Pages}"
                                           Header="{Binding Name}"
                                           Tag="{Binding PageId}"
                                           IsClickEnabled="{Binding IsPage}"
                                           ActionIconSource="{sr:FluentIconSource {sr:Fi ChevronRightFilled}}"
                                           Click="CatalogItem_OnClick">
                        <fa:FASettingsExpander.IconSource>
                            <sr:FluentIconSource Glyph="{Binding IconGlyph}" />
                        </fa:FASettingsExpander.IconSource>
                        <fa:FASettingsExpander.ItemTemplate>
                            <DataTemplate>
                                <fa:FASettingsExpanderItem Content="{Binding Name}"
                                                           Tag="{Binding Id}"
                                                           IsClickEnabled="True"
                                                           AutomationProperties.Name="{Binding Name}"
                                                           ActionIconSource="{sr:FluentIconSource {sr:Fi ChevronRightFilled}}"
                                                           Click="CatalogItem_OnClick">
                                    <fa:FASettingsExpanderItem.IconSource>
                                        <sr:FluentIconSource Glyph="{Binding IconGlyph}" />
                                    </fa:FASettingsExpanderItem.IconSource>
                                </fa:FASettingsExpanderItem>
                            </DataTemplate>
                        </fa:FASettingsExpander.ItemTemplate>
                    </fa:FASettingsExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
