<local:MobileSettingsCatalogPage xmlns="https://github.com/avaloniaui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                  xmlns:local="clr-namespace:SecRandom.Mobile.Views.Settings"
                                  xmlns:langs="clr-namespace:SecRandom.Mobile.Langs.Mobile"
                                  x:Class="SecRandom.Mobile.Views.Settings.MobileSettingsCatalogPage">
    <ScrollViewer x:Name="PageScroll"
                   Padding="20,20,20,28"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsScrollChainingEnabled="False"
                  IsScrollInertiaEnabled="True">
        <StackPanel x:Name="SettingsItems"
                     Spacing="14"
                    MaxWidth="720">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static langs:Resources.P_Settings}"
                            FontSize="24"
                            FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Static langs:Resources.S_SettingsCategories}"
                            FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:MobileSettingsCatalogPage>
