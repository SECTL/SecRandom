<local:MobileSettingsPageBase xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                              xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
                              xmlns:local="clr-namespace:SecRandom.Views.Mobile.Settings"
                              xmlns:langs="clr-namespace:SecRandom.Langs.Mobile"
                              x:Class="SecRandom.Views.Mobile.Settings.MobileSettingsCatalogPage"
                              x:DataType="local:MobileSettingsCatalogPage">
    <local:MobileSettingsPageBase.DataTemplates>
        <DataTemplate x:DataType="local:MobileSettingsCatalogEntry">
            <fa:FASettingsExpanderItem Content="{Binding Name}"
                                       Tag="{Binding Id}"
                                       IsClickEnabled="True"
                                       AutomationProperties.Name="{Binding Name}"
                                       ActionIconSource="{sr:FluentIconSource {sr:Fi ChevronRightFilled}}"
                                       Click="CatalogItem_OnClick">
                <fa:FASettingsExpanderItem.IconSource>
                    <sr:FluentIconSource Glyph="{Binding IconGlyph}" />
                </fa:FASettingsExpanderItem.IconSource>
            </fa:FASettingsExpanderItem>
        </DataTemplate>
        
        <DataTemplate x:DataType="local:MobileSettingsCatalogGroup">
            <fa:FASettingsExpander Header="{Binding Name}" IsExpanded="True">
                <fa:FASettingsExpander.IconSource>
                    <sr:FluentIconSource Glyph="{Binding IconGlyph}" />
                </fa:FASettingsExpander.IconSource>
                
                <ItemsControl ItemsSource="{Binding Pages}" />
            </fa:FASettingsExpander>
        </DataTemplate>
    </local:MobileSettingsPageBase.DataTemplates>
    
    <ScrollViewer x:Name="PageScroll"
                  Padding="20,20,20,28"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsScrollChainingEnabled="False"
                  IsScrollInertiaEnabled="True">
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</local:MobileSettingsPageBase>
