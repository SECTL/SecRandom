<local:MobileUpdateSettingsPage xmlns="https://github.com/avaloniaui"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                  xmlns:local="clr-namespace:SecRandom.Mobile.Views.Settings"
                                  xmlns:langs="clr-namespace:SecRandom.Mobile.Langs.Mobile"
                                  x:Class="SecRandom.Mobile.Views.Settings.MobileUpdateSettingsPage">
    <ScrollViewer x:Name="PageScroll" Padding="20,20,20,28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsScrollChainingEnabled="False" IsScrollInertiaEnabled="True">
        <StackPanel Spacing="14" MaxWidth="720">
            <Button Content="{x:Static langs:Resources.C_Back}" HorizontalAlignment="Left" MinHeight="44" Click="OnBackButtonClick" />
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static langs:Resources.S_AppUpdates}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static langs:Resources.S_AppUpdates_D}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="SettingsBody" Spacing="14" />
        </StackPanel>
    </ScrollViewer>
</local:MobileUpdateSettingsPage>
