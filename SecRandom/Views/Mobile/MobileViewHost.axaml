<local:MobileViewHost xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:SecRandom.Views.Mobile"
                      x:Class="SecRandom.Views.Mobile.MobileViewHost">
    <Grid>
        <Grid x:Name="PageContentRoot">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <NavigationPage x:Name="NavigationPage"
                            Popped="NavigationPage_OnPopped" />
        </Grid>
    </Grid>
</local:MobileViewHost>
