<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SecRandom.Controls.Mobile"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:local="clr-namespace:SecRandom.Views.Mobile"
             xmlns:langs="clr-namespace:SecRandom.Langs.Mobile"
             x:Class="SecRandom.Views.Mobile.MobileOverviewPage">
    <ScrollViewer x:Name="PageScroll"
                  Padding="20,20,20,28"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  IsScrollChainingEnabled="False"
                  IsScrollInertiaEnabled="True">
        <StackPanel Spacing="8" MaxWidth="720">
            <Grid x:Name="MetricsGrid"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="8">
                <Grid.Styles>
                    <Style Selector="Border.section">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="Padding" Value="8" />
                    </Style>
                </Grid.Styles>
                
                <Border x:Name="StudentMetricCard"
                        Classes="section"
                        Grid.Row="0" Grid.Column="0">
                    <StackPanel Spacing="4">
                        <sr:IconText Glyph="{sr:Fi PeopleFilled}"
                                     Text="{x:Static langs:Resources.M_Students}" FontSize="20" />
                        <TextBlock x:Name="StudentMetricValue"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                
                <Border x:Name="PrizeMetricCard"
                        Classes="section"
                        Grid.Row="0" Grid.Column="1">
                    <StackPanel Spacing="4">
                        <sr:IconText Glyph="{sr:Fi GiftFilled}"
                                     Text="{x:Static langs:Resources.M_Prizes}" FontSize="20" />
                        <TextBlock x:Name="PrizeMetricValue"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                
                <Border x:Name="RollCallRoundsMetricCard"
                        Classes="section"
                        Grid.Row="1" Grid.Column="0">
                    <StackPanel Spacing="4">
                        <sr:IconText Glyph="{sr:Fi TargetFilled}"
                                     Text="{x:Static langs:Resources.M_RollCallRounds}" FontSize="20" />
                        <TextBlock x:Name="RollCallRoundsMetricValue"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                
                <Border x:Name="LotteryRoundsMetricCard"
                        Classes="section"
                        Grid.Row="1" Grid.Column="1">
                    <StackPanel Spacing="4">
                        <sr:IconText Glyph="{sr:Fi TrophyFilled}"
                                     Text="{x:Static langs:Resources.M_LotteryRounds}" FontSize="20" />
                        <TextBlock x:Name="LotteryRoundsMetricValue"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
