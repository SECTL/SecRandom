<local:MobileRootView xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:SecRandom.Controls.Mobile"
                      xmlns:local="clr-namespace:SecRandom.Views.Mobile"
                       x:Class="SecRandom.Views.Mobile.MobileRootView"
                       Header="{x:Static local:MobileRootView.HeaderText}"
                       NavigationPage.HasBackButton="False"
                       Loaded="OnLoaded">
    <Grid RowDefinitions="*,Auto">
        <ContentControl x:Name="PageOutlet"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
        <controls:MobileNavigationBar x:Name="BottomBar" Grid.Row="1" />
    </Grid>
</local:MobileRootView>
