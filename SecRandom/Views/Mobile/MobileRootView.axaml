<local:MobileRootView xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:local="clr-namespace:SecRandom.Views.Mobile"
                       xmlns:controls="clr-namespace:SecRandom.Controls.Mobile"
                       x:Class="SecRandom.Views.Mobile.MobileRootView">
    <Grid x:Name="RootLayout"
          RowDefinitions="Auto,*,Auto">
        <controls:MobilePageHeader x:Name="PageHeader" />
        <ContentControl x:Name="PageOutlet"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
        <controls:MobileNavigationBar x:Name="BottomBar" Grid.Row="2" />
    </Grid>
</local:MobileRootView>
