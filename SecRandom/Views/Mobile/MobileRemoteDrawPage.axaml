<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SecRandom.Views.Mobile"
             xmlns:langs="using:SecRandom.Langs.Mobile"
             xmlns:vm="using:SecRandom.ViewModels.Mobile"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             x:Class="SecRandom.Views.Mobile.MobileRemoteDrawPage"
             x:DataType="local:MobileRemoteDrawPage">

    <UserControl.Styles>
        <!-- 不能用于抽取的设备照样列出，但整行置灰：藏起来只会让人以为设备没连上。 -->
        <Style Selector="Border.device-disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="12" Spacing="10" Classes="animated-intro">

            <!--
                页面内不再重复标题：导航栏已经显示「远程抽取」（MobileRootView.Header = P_RemoteDraw）。
                这一段引导语说明"手机只负责选与看，抽取发生在教室机"，因此比正文略暗。
            -->
            <TextBlock Text="{x:Static langs:Resources.RD_Hint}"
                       Opacity="0.75"
                       Margin="0 4 0 0"
                       TextWrapping="Wrap" />

            <!--
                ============ 顶部结果区 ============
                与桌面/平板版左侧结果区**同一份来源**（共享 VM）：有结果时给条数 + 回执里的成员，
                没有回执时给两行空态。抽完之后不用往下找：结果就长在控制项上面。
                失败/超时/被拒的状态文案也放在这里（全页只有这一处显示结果与失败）。

                高度：空态很矮（两行），有结果时封顶 200 且内部可滚动——
                结果多时不许把下面的地点/设备/抽取按钮顶出屏幕。
            -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <!-- 有回执：条数 + 成员列表（滚动受 MaxHeight 约束）。 -->
                    <StackPanel IsVisible="{Binding ViewModel.HasResult}" Spacing="8">
                        <TextBlock Text="{Binding ViewModel.DrawnCountText}" FontWeight="SemiBold" />
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ViewModel.DrawnMembers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ControlDrawnMember">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 2">
                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="16" />
                                            <TextBlock Text="{Binding SecondaryLabel}" Opacity="0.6" FontSize="14" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 没有回执：两行空态（空态只有这么高，不占半屏）。**不放刷新**：刷新在控制区，
                         同一动作只在一个地方出现。 -->
                    <StackPanel IsVisible="{Binding !ViewModel.HasResult}" Spacing="4">
                        <TextBlock Text="{Binding ViewModel.ResultPlaceholderTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ViewModel.ResultPlaceholderHint}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 执行中/失败/超时/被拒：都在这一处（文案由 VM 按错误码给）。 -->
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding ViewModel.IsBusy}" />
                    <TextBlock Text="{Binding ViewModel.StatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ViewModel.LoadFailure}"
                               IsVisible="{Binding ViewModel.HasLoadFailure}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--
                未登录：手机/平板没有集控页，也没有配对码通道，唯一入口就是这里。
                账号登录与设置页顶部的账号区是同一个账号（SectlAuthService），登录后自动加载地点。
            -->
            <Border IsVisible="{Binding ViewModel.NeedsSignIn}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static langs:Resources.RD_SignIn}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static langs:Resources.RD_AccountHint}"
                               FontSize="12"
                               Opacity="0.65"
                               TextWrapping="Wrap" />
                    <Button Classes="accent"
                            Content="{x:Static langs:Resources.RD_SignIn}"
                            Command="{Binding ViewModel.SignInCommand}"
                            IsEnabled="{Binding !ViewModel.IsBusy}"
                            HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <!--
                ============ 控制区：地点 → 年级 → 班级 ============
                唯一选择链，按控制台的数据模型逐级窄化。唯一地点/唯一年级/唯一班级会自动选中，
                所以多数老师只需要点"抽取"。抽取目标不是"我选的设备"，而是**这个班级当前占班的那一台**：
                设备列表只用来确认"谁来执行"，命令永远按班级下发。
            -->
            <StackPanel IsVisible="{Binding ViewModel.IsSignedIn}" Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding ViewModel.AccountName}"
                                   IsVisible="{Binding ViewModel.IsSignedIn}"
                                   FontSize="12"
                                   Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ViewModel.StatusDetail}"
                                   IsVisible="{Binding ViewModel.HasStatusDetail}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Content="{x:Static langs:Resources.RD_Refresh}"
                            Command="{Binding ViewModel.RefreshCommand}" />
                </Grid>

                <sr:Field Label="{x:Static langs:Resources.RD_Site}">
                    <ComboBox ItemsSource="{Binding ViewModel.Sites}"
                              SelectedItem="{Binding ViewModel.SelectedSite}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteSiteOption">
                                <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </sr:Field>

                <sr:Field Label="{x:Static langs:Resources.RD_Grade}" IsVisible="{Binding ViewModel.HasGrades}">
                    <ComboBox ItemsSource="{Binding ViewModel.Grades}"
                              SelectedItem="{Binding ViewModel.SelectedGrade}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteGradeOption">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </sr:Field>

                <sr:Field Label="{x:Static langs:Resources.RD_Class}" IsVisible="{Binding ViewModel.HasClasses}">
                    <ComboBox ItemsSource="{Binding ViewModel.Classes}"
                              SelectedItem="{Binding ViewModel.SelectedClass}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteClassOption">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </sr:Field>

                <sr:Field Label="{x:Static langs:Resources.RD_Kind}" IsVisible="{Binding ViewModel.HasSelection}">
                    <ComboBox ItemsSource="{Binding ViewModel.DrawKindOptions}"
                              SelectedItem="{Binding ViewModel.SelectedDrawKind}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DrawKindOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </sr:Field>

                <!-- 名单名称由占班设备的 roster.list 现取；设备不支持时不显示下拉，抽取用设备默认名单。 -->
                <sr:Field Label="{x:Static langs:Resources.RD_Roster}" IsVisible="{Binding ViewModel.HasRosters}">
                    <ComboBox ItemsSource="{Binding ViewModel.Rosters}"
                              SelectedItem="{Binding ViewModel.SelectedRoster}"
                              HorizontalAlignment="Stretch" />
                </sr:Field>

                <!-- 空态：登录、无地点、无年级、无班级各不相同；"下一步"按钮跟着状态走。 -->
                <Border IsVisible="{Binding ViewModel.HasEmptyState}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ViewModel.EmptyStateText}" TextWrapping="Wrap" />
                        <Button Content="{x:Static langs:Resources.RD_Refresh}"
                                Command="{Binding ViewModel.RefreshCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- 设备：这个班有哪些 SecRandom 设备、哪一台在占班、在线与否。 -->
                <StackPanel IsVisible="{Binding ViewModel.HasDevices}" Spacing="6">
                    <TextBlock Text="{x:Static langs:Resources.RD_TargetDevice}"
                               FontSize="12"
                               Opacity="0.6" />
                    <ListBox ItemsSource="{Binding ViewModel.Devices}"
                             SelectedItem="{Binding ViewModel.SelectedDevice}"
                             MaxHeight="280"
                             HorizontalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceRow">
                                <Border Classes.device-disabled="{Binding !IsUsable}" Padding="2">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DeviceLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border IsVisible="{Binding IsTarget}"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4" Padding="6 1"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Static langs:Resources.RD_TargetDevice}"
                                                           FontSize="11"
                                                           Opacity="0.85" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />
                                        <TextBlock Text="{Binding UnavailableReason}"
                                                   IsVisible="{Binding HasUnavailableReason}"
                                                   FontSize="12"
                                                   Opacity="0.8"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

            <!--
                抽取：默认 1 人，最多 50（与 draw.trigger 的服务端校验一致）。
                人数用数字输入框而不是下拉：点名页也是同一个输入控件，手输 12 人和点两下都是同一件事。
                抽不了的时候输入框和抽取按钮一起禁用，不能让"本来抽不了"的页面还留着能改的人数。
            -->
            <sr:Field Label="{x:Static langs:Resources.RD_Count}" IsVisible="{Binding ViewModel.HasSelection}">
                <NumericUpDown Value="{Binding ViewModel.SelectedCount}"
                               Minimum="1"
                               Maximum="50"
                               Increment="1"
                               FormatString="0"
                               IsEnabled="{Binding ViewModel.CanDraw}"
                               HorizontalAlignment="Stretch" />
            </sr:Field>

            <Button Classes="accent"
                    Content="{x:Static langs:Resources.RD_Draw}"
                    Command="{Binding ViewModel.DrawCommand}"
                    IsEnabled="{Binding ViewModel.CanDraw}"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Stretch" />

            <!-- 抽不了的时候必须说清楚卡在哪一步，否则按钮灰着就像坏了。 -->
            <TextBlock Text="{Binding ViewModel.DrawDisabledReason}"
                       IsVisible="{Binding ViewModel.HasDrawDisabledReason}"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />

            <!--
                重置本轮：次级按钮（不带 accent），视觉层级低于抽取。
                它是破坏性动作（清掉这一轮的抽取进度），因此要按两次，第一次只把按钮变成确认提示。
            -->
            <Button Content="{Binding ViewModel.ResetButtonText}"
                    Command="{Binding ViewModel.ResetRoundCommand}"
                    IsEnabled="{Binding ViewModel.CanReset}"
                    IsVisible="{Binding ViewModel.HasResult}"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Stretch" />
            </StackPanel>

            <!--
                抽取按钮下方只留**临时的进行中**状态。结果、失败、超时、被拒都已经在顶部结果区显示，
                这里再放一遍就是同一件事说两次（用户抽完还得往下找的那条旧文案就是这么来的）。
            -->
            <TextBlock Text="{x:Static langs:Resources.RD_Drawing}"
                       IsVisible="{Binding ViewModel.IsBusy}"
                       FontSize="12"
                       Opacity="0.7" />
        </StackPanel>
    </ScrollViewer>
</UserControl>