<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SecRandom.Views.ControlNode.ControlLockScreenWindow"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="FullScreen"
        Background="#FF000000">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" MaxWidth="1200">
            <TextBlock x:Name="MessageText"
                       FontSize="56"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <TextBlock x:Name="CountdownText"
                       FontSize="22"
                       FontFeatures="+tnum"
                       Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- 本机解除入口：长按 5 秒才出现确认，避免学生误触一次就把屏幕解开。 -->
        <Border x:Name="UnlockZone"
                Width="260"
                Height="64"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,32,32"
                Background="#14FFFFFF"
                CornerRadius="32"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                PointerPressed="OnUnlockPointerPressed"
                PointerReleased="OnUnlockPointerReleased"
                PointerCaptureLost="OnUnlockPointerCaptureLost">
            <TextBlock x:Name="UnlockHintText"
                       FontSize="15"
                       Foreground="#99FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center" />
        </Border>

        <!-- 确认层：长按完成后才显示，防止"按满 5 秒立刻解除"。 -->
        <Border x:Name="ConfirmPanel"
                IsVisible="False"
                Background="#F21E1E1E"
                CornerRadius="16"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="28">
                <TextBlock x:Name="ConfirmText"
                           FontSize="24"
                           Foreground="#FFFFFFFF"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="520" />
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Button x:Name="ConfirmButton" Click="OnConfirmClick" MinWidth="140" />
                    <Button x:Name="CancelButton" Click="OnCancelClick" MinWidth="140" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>