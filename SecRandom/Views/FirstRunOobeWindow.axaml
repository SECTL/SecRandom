<faWindowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                         xmlns:faWindowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                         xmlns:views="clr-namespace:SecRandom.Views"
                         xmlns:vm="clr-namespace:SecRandom.ViewModels"
                         xmlns:imports="clr-namespace:SecRandom.Views.SettingsPages.ListManagement"
                         xmlns:langs="clr-namespace:SecRandom.Langs.FirstRunOobe"
                         xmlns:enums="clr-namespace:SecRandom.Core.Enums.Configs;assembly=SecRandom.Core"
                         xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
                         x:Class="SecRandom.Views.FirstRunOobeWindow"
                         x:DataType="views:FirstRunOobeWindow"
                         mc:Ignorable="d"
                         Title="{Binding ViewModel.PageTitle}"
                         Width="840" Height="640" MinWidth="680" MinHeight="500"
                         WindowStartupLocation="CenterScreen"
                         Closing="Window_OnClosing">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0" Padding="32 24 32 20"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                IsVisible="{Binding ViewModel.IsStatusVisible}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="/Assets/AppLogo.png" Width="32" Height="32" />
                        <TextBlock Text="{Binding ViewModel.PageTitle}"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ViewModel.StepProgress}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="{Binding ViewModel.IntroText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <sr:DrawerHost x:Name="ImportDrawerHost" Grid.Row="1" DrawerPlacement="Right">
            <Carousel Classes="animated" SelectedIndex="{Binding ViewModel.SelectedStep}">
                <Grid Margin="32" IsVisible="{Binding ViewModel.IsFullSetup}">
                    <StackPanel Spacing="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520">
                        <Image Source="/Assets/AppLogo.png"
                               Width="88"
                               Height="88"
                               HorizontalAlignment="Center"
                               Stretch="Uniform" />
                        <TextBlock Text="{x:Static langs:Resources.C_WelcomeTitle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Static langs:Resources.C_WelcomeDescription}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Classes="accent"
                                Content="{Binding ViewModel.NextButtonText}"
                                IsEnabled="{Binding ViewModel.CanContinue}"
                                HorizontalAlignment="Center"
                                MinWidth="132"
                                MinHeight="44"
                                FontSize="16"
                                Margin="0 14 0 0"
                                Click="Next_OnClick" />
                    </StackPanel>
                </Grid>

                <ScrollViewer>
                    <StackPanel Margin="32" Spacing="16">
                        <TextBlock Text="{x:Static langs:Resources.C_LegalTitle}"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Static langs:Resources.C_LegalDescription}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        
                        <Expander Header="{x:Static langs:Resources.C_VerificationNoticeTitle}"
                                  IsExpanded="False"
                                  IsVisible="{Binding ViewModel.IsVerificationNoticeRequired}">
                            <ScrollViewer MinHeight="150" MaxHeight="240">
                                <SelectableTextBlock Text="{x:Static langs:Resources.VerificationNotice}"
                                                     TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Expander>
                        <CheckBox IsChecked="{Binding ViewModel.AcceptedVerificationNotice}"
                                  Content="{x:Static langs:Resources.C_VerificationNoticeAccept}"
                                  IsVisible="{Binding ViewModel.IsVerificationNoticeRequired}" />
                        
                        <Expander Header="{x:Static langs:Resources.C_PrivacyPolicyTitle}" IsExpanded="False">
                            <ScrollViewer MinHeight="150" MaxHeight="240">
                                <SelectableTextBlock Text="{x:Static langs:Resources.PrivacyPolicy}"
                                                     TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Expander>
                        <CheckBox IsChecked="{Binding ViewModel.AcceptedPrivacyPolicy}"
                                  Content="{x:Static langs:Resources.C_PrivacyPolicyAccept}" />
                        
                        <Expander Header="{x:Static langs:Resources.C_GplTitle}" IsExpanded="False">
                            <ScrollViewer MinHeight="150" MaxHeight="240">
                                <SelectableTextBlock Text="{x:Static langs:Resources.GplNotice}"
                                                     TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Expander>
                        <CheckBox IsChecked="{Binding ViewModel.AcceptedGpl}"
                                  Content="{x:Static langs:Resources.C_GplAccept}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding ViewModel.IsFullSetup}">
                    <StackPanel Margin="32" Spacing="16">
                        <TextBlock Text="{x:Static langs:Resources.C_DataTitle}"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Static langs:Resources.C_DataDescription}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Static langs:Resources.C_RestoreTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static langs:Resources.C_RestoreDescription}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{x:Static langs:Resources.C_ImportSettings}"
                                            Click="ImportSettings_OnClick" />
                                    <Button Content="{x:Static langs:Resources.C_ImportAllData}"
                                            Click="ImportAllData_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_RollCallList}"
                                               Description="{x:Static langs:Resources.C_RollCallListDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi PeopleListFilled}}"
                                               IsExpanded="True">
                            <fa:FASettingsExpander.Footer>
                                <ComboBox MinWidth="220"
                                          ItemsSource="{Binding ViewModel.StudentListNames}"
                                          SelectedItem="{Binding ViewModel.SelectedStudentListName, Mode=TwoWay}" />
                            </fa:FASettingsExpander.Footer>
                            <fa:FASettingsExpanderItem>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{x:Static langs:Resources.C_RefreshList}"
                                                Click="RefreshStudentLists_OnClick" />
                                        <Button Content="{x:Static langs:Resources.C_AddList}"
                                                Click="AddStudentList_OnClick" />
                                        <Button Content="{x:Static langs:Resources.C_RenameList}"
                                                Click="RenameStudentList_OnClick" />
                                        <Button Content="{x:Static langs:Resources.C_DeleteList}"
                                                Click="DeleteStudentList_OnClick" />
                                        <Button Classes="accent" Content="{x:Static langs:Resources.C_ImportRoster}"
                                                Click="ImportRoster_OnClick" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding ViewModel.IsFullSetup}">
                    <StackPanel Margin="32" Spacing="8">
                        <TextBlock Text="{x:Static langs:Resources.C_LotteryTitle}"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Static langs:Resources.C_LotteryDescription}"
                                   Margin="0 0 0 8"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_LotteryEnabled}"
                                               IconSource="{sr:FluentIconSource {sr:Fi GiftFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding ViewModel.MoreSettings.LotteryEnabled}" />
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_PrizeList}"
                                               Description="{x:Static langs:Resources.C_PrizeListDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi LotteryFilled}}"
                                               IsExpanded="True"
                                               IsVisible="{Binding ViewModel.MoreSettings.LotteryEnabled}">
                            <fa:FASettingsExpander.Footer>
                                <ComboBox MinWidth="220"
                                          ItemsSource="{Binding ViewModel.PrizeListNames}"
                                          SelectedItem="{Binding ViewModel.SelectedPrizeListName, Mode=TwoWay}" />
                            </fa:FASettingsExpander.Footer>
                            <fa:FASettingsExpanderItem>
                                <fa:FASettingsExpanderItem.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{x:Static langs:Resources.C_RefreshList}"
                                                Click="RefreshPrizeLists_OnClick" />
                                        <Button Content="{x:Static langs:Resources.C_AddList}"
                                                Click="AddPrizeList_OnClick" />
                                        <Button Content="{x:Static langs:Resources.C_RenameList}"
                                                Click="RenamePrizeList_OnClick" />
                                        <Button Content="{x:Static langs:Resources.C_DeleteList}"
                                                Click="DeletePrizeList_OnClick" />
                                        <Button Classes="accent" Content="{x:Static langs:Resources.C_PrizeImport}"
                                                Click="ImportPrizePool_OnClick" />
                                    </StackPanel>
                                </fa:FASettingsExpanderItem.Footer>
                            </fa:FASettingsExpanderItem>
                        </fa:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding ViewModel.IsFullSetup}">
                    <StackPanel Margin="32" Spacing="8">
                        <TextBlock Text="{x:Static langs:Resources.C_AppearanceTitle}"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_Theme}"
                                               Description="{x:Static langs:Resources.C_ThemeDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi DarkThemeFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <ComboBox SelectedIndex="{Binding ViewModel.Appearance.Theme}"
                                          SelectionChanged="Appearance_OnChanged">
                                    <ComboBoxItem Content="{x:Static langs:Resources.O_ThemeLight}" />
                                    <ComboBoxItem Content="{x:Static langs:Resources.O_ThemeDark}" />
                                    <ComboBoxItem Content="{x:Static langs:Resources.O_ThemeAuto}" />
                                </ComboBox>
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_ThemeColor}"
                                               Description="{x:Static langs:Resources.C_ThemeColorDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi ColorFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ColorPicker Color="{Binding ViewModel.Appearance.ThemeColor}"
                                                 IsVisible="{Binding ViewModel.Appearance.ThemeColorMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:ThemeColorMode.Custom}}" />
                                    <ComboBox SelectedIndex="{Binding ViewModel.Appearance.ThemeColorMode}"
                                              SelectionChanged="Appearance_OnChanged">
                                        <ComboBoxItem Content="{x:Static langs:Resources.O_SystemColor}" />
                                        <ComboBoxItem Content="{x:Static langs:Resources.O_CustomColor}" />
                                    </ComboBox>
                                </StackPanel>
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_Opacity}"
                                               Description="{x:Static langs:Resources.C_OpacityDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <NumericUpDown Value="{Binding ViewModel.FloatingWindow.FloatingWindowOpacity}"
                                               Minimum="20" Maximum="100" />
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding ViewModel.IsFullSetup}">
                    <StackPanel Margin="32" Spacing="8">
                        <TextBlock Text="{x:Static langs:Resources.C_DesktopTitle}"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Static langs:Resources.C_DesktopDescription}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_Autostart}"
                                               Description="{x:Static langs:Resources.C_AutostartDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi PowerFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding ViewModel.Autostart}" />
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_ShowStartupWindow}"
                                               Description="{x:Static langs:Resources.C_ShowStartupWindowDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi WindowFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding ViewModel.Basic.ShowStartupWindow}" />
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_ExternalIntegration}"
                                               Description="{x:Static langs:Resources.C_ExternalIntegrationDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi LinkSquareFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding ViewModel.ExternalIntegration}" />
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding ViewModel.IsFullSetup}">
                    <StackPanel Margin="32" Spacing="8">
                        <TextBlock Text="{x:Static langs:Resources.C_PrivacyTitle}"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Static langs:Resources.C_PrivacyDescription}"
                                   Margin="0 0 0 8"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Static langs:Resources.C_PrivacyEncouragement}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_SentryTelemetry}"
                                               Description="{x:Static langs:Resources.C_SentryTelemetryDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi PulseFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding ViewModel.PrivacySettings.SentryTelemetryEnabled}" />
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                        <fa:FASettingsExpander Header="{x:Static langs:Resources.C_OnlineStatus}"
                                               Description="{x:Static langs:Resources.C_OnlineStatusDescription}"
                                               IconSource="{sr:FluentIconSource {sr:Fi GlobeFilled}}">
                            <fa:FASettingsExpander.Footer>
                                <ComboBox SelectedIndex="{Binding ViewModel.PrivacySettings.OnlineStatusMode}">
                                    <ComboBoxItem Content="{x:Static langs:Resources.O_OnlineStatusMode_Full}" />
                                    <ComboBoxItem Content="{x:Static langs:Resources.O_OnlineStatusMode_Anonymous}" />
                                    <ComboBoxItem Content="{x:Static langs:Resources.O_OnlineStatusMode_Off}" />
                                </ComboBox>
                            </fa:FASettingsExpander.Footer>
                        </fa:FASettingsExpander>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding ViewModel.IsFullSetup}">
                    <StackPanel Margin="32" Spacing="14">
                        <TextBlock Text="{x:Static langs:Resources.C_CompleteTitle}"
                                   Theme="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Static langs:Resources.C_CompleteDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Static langs:Resources.C_CompletedItems}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static langs:Resources.C_CompletedClass}" />
                                <TextBlock Text="{x:Static langs:Resources.C_CompletedAppearance}" />
                                <TextBlock Text="{x:Static langs:Resources.C_CompletedIntegration}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static langs:Resources.C_CompletedPrivacy}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Static langs:Resources.C_ResourcesTitle}" FontWeight="SemiBold" />
                            <WrapPanel ItemHeight="40" HorizontalAlignment="Left">
                                <WrapPanel.Styles>
                                    <Style Selector="HyperlinkButton">
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="Padding" Value="4" />
                                    </Style>
                                </WrapPanel.Styles>
                                <HyperlinkButton CommandParameter="https://sectl.cn/" Click="OpenLink_OnClick"
                                                 Content="{x:Static langs:Resources.C_SectlWebsite}" />
                                <HyperlinkButton CommandParameter="https://secrandom.sectl.cn/"
                                                 Click="OpenLink_OnClick"
                                                 Content="{x:Static langs:Resources.C_Documentation}" />
                                <HyperlinkButton CommandParameter="https://space.bilibili.com/520571577"
                                                 Click="OpenLink_OnClick"
                                                 Content="{x:Static langs:Resources.C_AuthorBilibili}" />
                                <HyperlinkButton CommandParameter="https://afdian.com/a/lzy0983"
                                                 Click="OpenLink_OnClick"
                                                 Content="{x:Static langs:Resources.C_Sponsor}" />
                                <HyperlinkButton CommandParameter="https://qm.qq.com/q/k0l04MbSXS"
                                                 Click="OpenLink_OnClick"
                                                 Content="{x:Static langs:Resources.C_Community}" />
                            </WrapPanel>
                            <Border Padding="12,8" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <SelectableTextBlock Text="{x:Static langs:Resources.C_CommunityAnswer}"
                                                     TextWrapping="Wrap"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Carousel>
        </sr:DrawerHost>

        <Separator Grid.Row="2" />
        
        <Grid Grid.Row="3" Margin="24 16"  ColumnDefinitions="Auto,*,Auto">
            <Grid>
                <TextBlock Text="{Binding ViewModel.StatusMessage}"
                           IsVisible="{Binding ViewModel.IsStatusVisible}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ViewModel.IsWelcomeStep}">
                    <sr:FluentIcon Glyph="{sr:Fi GlobeFilled}"
                                   Width="20"
                                   Height="20"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{x:Static langs:Resources.C_Language}" />
                    <ComboBox Width="150"
                              SelectedIndex="{Binding ViewModel.Basic.Language, Mode=OneWay}"
                              SelectionChanged="Language_OnChanged">
                        <ComboBoxItem Content="简体中文" />
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="日本語" />
                    </ComboBox>
                </StackPanel>
            </Grid>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding ViewModel.IsCompletionActionVisible}">
                <Button Content="{x:Static langs:Resources.C_Previous}" IsVisible="{Binding ViewModel.HasPrevious}"
                        Click="Previous_OnClick" />
                <Button Classes="accent" Content="{Binding ViewModel.NextButtonText}"
                        IsEnabled="{Binding ViewModel.CanContinue}" Click="Next_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</faWindowing:FAAppWindow>