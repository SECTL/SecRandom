<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SecRandom.Views.MainPages"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:langs="using:SecRandom.Langs.MainPages.RollCall"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="using:SecRandom.ViewModels.MainPages"
             x:Class="SecRandom.Views.MainPages.RollCallPage"
             x:DataType="vm:RollCallPageViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="RollCallControlPanelTemplate" DataType="vm:RollCallPageViewModel">
            <Viewbox Width="280">
                <StackPanel Width="216" Spacing="6">
                    <StackPanel.Resources>
                        <ResourceDictionary>
                            <system:Double x:Key="SizeBase">36</system:Double>
                        </ResourceDictionary>
                    </StackPanel.Resources>
                    <StackPanel.Styles>
                        <Style Selector="StackPanel > Button">
                            <Setter Property="Height" Value="{DynamicResource SizeBase}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                        <Style Selector="StackPanel > ComboBox">
                            <Setter Property="Height" Value="{DynamicResource SizeBase}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </StackPanel.Styles>

                    <!-- 内容列固定 144：上方的按钮/下拉框与下方的数字输入框共用同一条外边；
                         起止标签不占内容列，而是落在面板另一侧 36px 的留白里 -->
                    <StackPanel Width="180" Spacing="6"
                                HorizontalAlignment="{Binding ControlPanelContentAlignment}">
                    <Button Content="{x:Static langs:Resources.C_Reset}"
                            IsVisible="{Binding MoreSettings.RollCallResetButton}"
                            Command="{Binding ResetDrawHistoryCommand}" />
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Grid.Styles>
                            <Style Selector="Grid > Button">
                                <Setter Property="Width" Value="{DynamicResource SizeBase}" />
                                <Setter Property="Height" Value="{DynamicResource SizeBase}" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="FontSize" Value="24" />
                            </Style>
                        </Grid.Styles>
                        <sr:AcceleratingRepeatButton Grid.Column="0" Content="-"
                                                      IsEnabled="{Binding CanDecreaseCount}"
                                                      Command="{Binding DecreaseCountCommand}" />
                        <TextBlock Grid.Column="1" Text="{Binding DrawCount}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                        <sr:AcceleratingRepeatButton Grid.Column="2" Content="+"
                                                      IsEnabled="{Binding CanIncreaseCount}"
                                                      Command="{Binding IncreaseCountCommand}" />
                    </Grid>
                    <Button Classes="accent" Content="{Binding DrawButtonText}"
                            IsVisible="{Binding MoreSettings.RollCallStartButton}"
                            IsEnabled="{Binding CanStartDraw}" Command="{Binding StartDrawCommand}" />
                    <ComboBox IsVisible="{Binding MoreSettings.RollCallListSelector}"
                              ItemsSource="{Binding StudentListNames}" SelectedItem="{Binding SelectedStudentListName}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsNumberMode}" Spacing="4"
                                HorizontalAlignment="Stretch">
                        <StackPanel.Styles>
                            <!-- 数字框与上方控件同宽（144）：起止标签放在旁边 36px 的留白里，保留调节按钮并放大数字 -->
                            <Style Selector="NumericUpDown">
                                <Setter Property="FontSize" Value="18" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                            <Style Selector="NumericUpDown /template/ TextBox">
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                            <Style Selector="TextBlock.RangeLabel">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Opacity" Value="0.7" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                            </Style>
                        </StackPanel.Styles>
                        <!-- 控制面板靠右：标签在输入框左侧留白里，输入框右边缘与上方控件对齐 -->
                        <Grid ColumnDefinitions="36,180" IsVisible="{Binding IsControlPanelOnRight}">
                            <TextBlock Classes="RangeLabel"
                                       Text="{x:Static langs:Resources.M_NumberRangeStart}" />
                            <NumericUpDown Grid.Column="1" Height="{DynamicResource SizeBase}"
                                           Minimum="0" Increment="1" FormatString="0"
                                           Value="{Binding NumberRangeStart}" />
                        </Grid>
                        <Grid ColumnDefinitions="36,180" IsVisible="{Binding IsControlPanelOnRight}">
                            <TextBlock Classes="RangeLabel"
                                       Text="{x:Static langs:Resources.M_NumberRangeEnd}" />
                            <NumericUpDown Grid.Column="1" Height="{DynamicResource SizeBase}"
                                           Minimum="0" Increment="1" FormatString="0"
                                           Value="{Binding NumberRangeEnd}" />
                        </Grid>
                        <!-- 控制面板靠左：标签在输入框右侧留白里，输入框左边缘与上方控件对齐 -->
                        <Grid ColumnDefinitions="180,36" IsVisible="{Binding IsControlPanelOnLeft}">
                            <NumericUpDown Grid.Column="0" Height="{DynamicResource SizeBase}"
                                           Minimum="0" Increment="1" FormatString="0"
                                           Value="{Binding NumberRangeStart}" />
                            <TextBlock Grid.Column="1" Classes="RangeLabel"
                                       Text="{x:Static langs:Resources.M_NumberRangeStart}" />
                        </Grid>
                        <Grid ColumnDefinitions="180,36" IsVisible="{Binding IsControlPanelOnLeft}">
                            <NumericUpDown Grid.Column="0" Height="{DynamicResource SizeBase}"
                                           Minimum="0" Increment="1" FormatString="0"
                                           Value="{Binding NumberRangeEnd}" />
                            <TextBlock Grid.Column="1" Classes="RangeLabel"
                                       Text="{x:Static langs:Resources.M_NumberRangeEnd}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Width="180" Spacing="6"
                                HorizontalAlignment="{Binding ControlPanelContentAlignment}">
                    <ComboBox IsVisible="{Binding IsGroupSelectorVisible}"
                              ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroup}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox IsVisible="{Binding IsGenderSelectorVisible}"
                              ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding SelectedGender}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox IsVisible="{Binding IsHistoryGroupSelectorVisible}"
                              ItemsSource="{Binding HistoryGroupOptions}" SelectedItem="{Binding SelectedHistoryGroup}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{x:Static langs:Resources.C_ShowRemainingList}"
                            IsVisible="{Binding IsRemainingListButtonVisible}"
                            Click="RemainingListButton_OnClick" />
                    <Viewbox HorizontalAlignment="Stretch" StretchDirection="DownOnly">
                        <TextBlock Text="{Binding CountSummary}" IsVisible="{Binding MoreSettings.RollCallQuantityLabel}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </Viewbox>
                    </StackPanel>
                </StackPanel>
            </Viewbox>
        </DataTemplate>
    </UserControl.Resources>
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="*" MinHeight="560">
        <Border Grid.Column="0" Margin="0,0,24,24" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                IsVisible="{Binding IsControlPanelOnLeft}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RollCallControlPanelTemplate}" />
        </Border>
        <local:RollCallResultPresenter Grid.Column="1" DataContext="{Binding}" />
        <Border Grid.Column="2" Margin="0,0,24,24" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                IsVisible="{Binding IsControlPanelOnRight}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RollCallControlPanelTemplate}" />
        </Border>
    </Grid>
</UserControl>
