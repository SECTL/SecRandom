<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SecRandom.ViewModels.MainPages"
             x:Class="SecRandom.Views.MainPages.LotteryResultPresenter"
             x:Name="RootControl"
             x:DataType="vm:LotteryPageViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="LotteryAvatarTemplate" DataType="vm:LotteryResultItem">
            <Border Width="72" Height="72"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Border CornerRadius="8" IsVisible="{Binding IsImageVisible}">
                        <Border.Background>
                            <ImageBrush Source="{Binding Image}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding Initial}" IsVisible="{Binding IsPlaceholderVisible}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.result-name">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="860" />
        </Style>
        <Style Selector="Border.result-card">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22 16" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>
    <Grid ClipToBounds="True">
        <TextBlock Classes="result-name" IsVisible="{Binding !IsResultVisible}" Text="{Binding ReminderText}"
                   Foreground="{Binding ReminderBrush}" FontSize="{Binding ReminderFontSize}"
                   FontFamily="{Binding ResultFontFamily}" FontWeight="SemiBold" />
        <ScrollViewer IsVisible="{Binding IsResultVisible}" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
            <ItemsControl x:Name="ResultPresenter" ItemsSource="{Binding ResultItems}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LotteryResultItem">
                        <Grid Classes="result-animation-item" Margin="8">
                            <Border Classes="result-card" IsVisible="{Binding IsCardStyle}"
                                    BorderBrush="{Binding AccentBrush}">
                                <StackPanel Orientation="{Binding ImageLayoutOrientation}" Spacing="6"
                                            HorizontalAlignment="Center">
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource LotteryAvatarTemplate}"
                                                    IsVisible="{Binding IsImageBeforeText}" />
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayText}" Classes="result-name"
                                                   Foreground="{Binding TextBrush}"
                                                   FontSize="{Binding #RootControl.DataContext.ResultFontSize}"
                                                   FontFamily="{Binding #RootControl.DataContext.ResultFontFamily}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Tags}" IsVisible="{Binding IsTagsVisible}"
                                                   HorizontalAlignment="Center" Opacity="0.72" FontSize="13" />
                                        <TextBlock Text="{Binding WeightText}" IsVisible="{Binding IsWeightVisible}"
                                                   HorizontalAlignment="Center" Opacity="0.62" FontSize="12" />
                                    </StackPanel>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource LotteryAvatarTemplate}"
                                                    IsVisible="{Binding IsImageAfterText}" />
                                </StackPanel>
                            </Border>
                            <StackPanel IsVisible="{Binding !IsCardStyle}"
                                        Orientation="{Binding ImageLayoutOrientation}" Spacing="6"
                                        HorizontalAlignment="Center">
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource LotteryAvatarTemplate}"
                                                IsVisible="{Binding IsImageBeforeText}" />
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayText}" Classes="result-name"
                                               Foreground="{Binding TextBrush}"
                                               FontSize="{Binding #RootControl.DataContext.ResultFontSize}"
                                               FontFamily="{Binding #RootControl.DataContext.ResultFontFamily}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Tags}" IsVisible="{Binding IsTagsVisible}"
                                               HorizontalAlignment="Center" Opacity="0.72" FontSize="13" />
                                    <TextBlock Text="{Binding WeightText}" IsVisible="{Binding IsWeightVisible}"
                                               HorizontalAlignment="Center" Opacity="0.62" FontSize="12" />
                                </StackPanel>
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource LotteryAvatarTemplate}"
                                                IsVisible="{Binding IsImageAfterText}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>