<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:history="using:SecRandom.Views.SettingsPages.History"
             xmlns:langs="using:SecRandom.Langs.MainPages.History"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="SecRandom.Views.MainPages.HistoryPage">

    <Grid RowDefinitions="Auto,*" Margin="0 12 0 0" RowSpacing="12">
        <TabStrip x:Name="HistoryTabStrip"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                  SelectedIndex="0"
                  Theme="{StaticResource TabStripStyle}">
            <TabStripItem Content="{x:Static langs:Resources.Tab_RollCall}" />
            <TabStripItem Content="{x:Static langs:Resources.Tab_Lottery}" />
        </TabStrip>

        <Carousel Grid.Row="1"
                  Classes="animated"
                  SelectedIndex="{Binding #HistoryTabStrip.SelectedIndex}">
            <history:RollCallHistorySettingsPage />
            <history:LotteryHistorySettingsPage />
        </Carousel>
    </Grid>
</UserControl>
