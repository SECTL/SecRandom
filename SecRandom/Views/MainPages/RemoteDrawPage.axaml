<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SecRandom.Views.MainPages"
             xmlns:langs="using:SecRandom.Langs.Mobile"
             xmlns:vm="using:SecRandom.ViewModels.Mobile"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             x:Class="SecRandom.Views.MainPages.RemoteDrawPage"
             x:DataType="local:RemoteDrawPage">

    <UserControl.Styles>
        <!-- 不能用于抽取的设备照样列出，但整行置灰：藏起来只会让人以为设备没连上。 -->
        <Style Selector="Border.device-disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- 桌面版式：左侧结果区占满剩余宽度，右侧控制区固定宽度，彼此不随内容跳动。 -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,360" ColumnSpacing="16" Margin="16" MinHeight="560">

        <!--
            ============ 左：结果区 ============
            这里**只显示远端设备回执里真的返回了什么**（payload.drawn 的成员）：没有回执就不列表，
            用状态文案说明当前处在"还没抽 / 失败 / 超时 / 被拒"的哪一种。左侧不自己造结果，
            也不在缺回执时编一句"抽到了某某"。
        -->
        <Border Grid.Column="0" CornerRadius="8" Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel LastChildFill="True">

                <!-- 回执状态：未抽/执行中/失败/超时/被拒都走这一行（文案由 VM 按错误码给）。 -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0 12 0 0">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding ViewModel.IsBusy}" />
                    <TextBlock Text="{Binding ViewModel.StatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ViewModel.LoadFailure}"
                               IsVisible="{Binding ViewModel.HasLoadFailure}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid>
                    <!-- 有回执成员：先给条数，再列回执里的成员。 -->
                    <DockPanel IsVisible="{Binding ViewModel.HasResult}">
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="0 0 0 8"
                                   FontWeight="SemiBold"
                                   Text="{Binding ViewModel.DrawnCountText}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ViewModel.DrawnMembers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ControlDrawnMember">
                                        <Border Padding="10" Margin="0 0 0 8" CornerRadius="6"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SecondaryLabel}" FontSize="14"
                                                           Opacity="0.6" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!--
                        没有可显示的结果：**两行**空态（还没有结果 / 回执里会出现什么）。
                        垂直居中——面板很高，靠上或靠角都会像"少了个按钮"。
                        这里**不再放刷新**：同一动作只在一个地方出现，刷新在右侧控制区。
                    -->
                    <StackPanel IsVisible="{Binding !ViewModel.HasResult}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="420" Spacing="8">
                        <TextBlock Text="{Binding ViewModel.ResultPlaceholderTitle}"
                                   TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ViewModel.ResultPlaceholderHint}"
                                   TextAlignment="Center" TextWrapping="Wrap" Opacity="0.7" />
                        <TextBlock Text="{Binding ViewModel.EmptyStateText}"
                                   IsVisible="{Binding ViewModel.HasEmptyState}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <!-- 登录是**这里才有**的动作（控制区没有登录入口），因此保留；刷新则已去掉。 -->
                        <Button Classes="accent"
                                Content="{x:Static langs:Resources.RD_SignIn}"
                                Command="{Binding ViewModel.SignInCommand}"
                                IsVisible="{Binding ViewModel.NeedsSignIn}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!--
            ============ 右：控制区 ============
            与点名/抽奖页同一套桌面版式：右侧固定宽度的操作面板，纵向排列、控件等高。
            账号登录后逐级选地点/年级/班级；抽取目标由班级当前占班的设备决定，设备列表只用于确认"谁来执行"。
        -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <!-- 顶部账号：桌面/平板没有集控页的账号入口（平板甚至没有集控页），所以这里也要能登录。 -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="hint"
                                   Text="{Binding ViewModel.AccountName}"
                                   IsVisible="{Binding ViewModel.IsSignedIn}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="hint"
                                   Text="{x:Static langs:Resources.RD_AccountHint}"
                                   IsVisible="{Binding ViewModel.NeedsSignIn}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top"
                            Content="{x:Static langs:Resources.RD_SignIn}"
                            Command="{Binding ViewModel.SignInCommand}"
                            IsVisible="{Binding ViewModel.NeedsSignIn}" />
                    <Button Grid.Column="1" VerticalAlignment="Top"
                            Content="{x:Static langs:Resources.RD_Refresh}"
                            Command="{Binding ViewModel.RefreshCommand}"
                            IsVisible="{Binding ViewModel.IsSignedIn}" />
                </Grid>

                <sr:Field Label="{x:Static langs:Resources.RD_Site}" IsVisible="{Binding ViewModel.IsSignedIn}">
                    <ComboBox ItemsSource="{Binding ViewModel.Sites}"
                              SelectedItem="{Binding ViewModel.SelectedSite}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteSiteOption">
                                <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </sr:Field>

                <sr:Field Label="{x:Static langs:Resources.RD_Grade}" IsVisible="{Binding ViewModel.HasGrades}">
                    <ComboBox ItemsSource="{Binding ViewModel.Grades}"
                              SelectedItem="{Binding ViewModel.SelectedGrade}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteGradeOption">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </sr:Field>

                <sr:Field Label="{x:Static langs:Resources.RD_Class}" IsVisible="{Binding ViewModel.HasClasses}">
                    <ComboBox ItemsSource="{Binding ViewModel.Classes}"
                              SelectedItem="{Binding ViewModel.SelectedClass}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteClassOption">
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </sr:Field>

                <sr:Field Label="{x:Static langs:Resources.RD_Kind}" IsVisible="{Binding ViewModel.HasSelection}">
                    <ComboBox ItemsSource="{Binding ViewModel.DrawKindOptions}"
                              SelectedItem="{Binding ViewModel.SelectedDrawKind}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DrawKindOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </sr:Field>

                <!-- 名单名称由占班设备的 roster.list 现取；设备不支持时不显示下拉，抽取用设备默认名单。 -->
                <sr:Field Label="{x:Static langs:Resources.RD_Roster}" IsVisible="{Binding ViewModel.HasRosters}">
                    <ComboBox ItemsSource="{Binding ViewModel.Rosters}"
                              SelectedItem="{Binding ViewModel.SelectedRoster}"
                              HorizontalAlignment="Stretch" />
                </sr:Field>

                <!-- 班级当前状态（年级名 · 班名）与"谁来执行"。 -->
                <TextBlock Classes="hint"
                           Text="{Binding ViewModel.StatusDetail}"
                           IsVisible="{Binding ViewModel.HasStatusDetail}" />

                <!-- 设备：这个班有哪些 SecRandom 设备、哪一台在占班、在线与否。 -->
                <StackPanel IsVisible="{Binding ViewModel.HasDevices}" Spacing="4">
                    <TextBlock Classes="hint" Text="{x:Static langs:Resources.RD_TargetDevice}" />
                    <ListBox ItemsSource="{Binding ViewModel.Devices}"
                             SelectedItem="{Binding ViewModel.SelectedDevice}"
                             MaxHeight="200"
                             HorizontalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceRow">
                                <Border Classes.device-disabled="{Binding !IsUsable}" Padding="2">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DeviceLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border IsVisible="{Binding IsTarget}"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4" Padding="6 1"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Static langs:Resources.RD_TargetDevice}"
                                                           FontSize="11" Opacity="0.85" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />
                                        <TextBlock Text="{Binding UnavailableReason}"
                                                   IsVisible="{Binding HasUnavailableReason}"
                                                   FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- 空态：登录、无地点、无年级、无班级各不相同。 -->
                <Border IsVisible="{Binding ViewModel.HasEmptyState}"
                        CornerRadius="8" Padding="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="{Binding ViewModel.EmptyStateText}" TextWrapping="Wrap" />
                </Border>

                <!--
                    人数：默认 1 人，最多 50（与 draw.trigger 的服务端校验一致）。
                    用数字输入框（与点名页同一种控件），不是下拉：手输和点按钮都能改。
                    draw.trigger 的其余参数（名单/性别/组）在 v4.3 command-options 到手前拿不到，
                    所以这里刻意不提供——设备会用它的默认名单。
                -->
                <sr:Field Label="{x:Static langs:Resources.RD_Count}" IsVisible="{Binding ViewModel.HasSelection}">
                    <NumericUpDown Value="{Binding ViewModel.SelectedCount}"
                                   Minimum="1"
                                   Maximum="50"
                                   Increment="1"
                                   FormatString="0"
                                   IsEnabled="{Binding ViewModel.CanDraw}"
                                   HorizontalAlignment="Stretch" />
                </sr:Field>

                <Button Classes="accent"
                        Content="{x:Static langs:Resources.RD_Draw}"
                        Command="{Binding ViewModel.DrawCommand}"
                        IsEnabled="{Binding ViewModel.CanDraw}"
                        HorizontalContentAlignment="Center"
                        HorizontalAlignment="Stretch" />

                <!-- 抽不了的时候必须说清楚卡在哪一步，否则按钮灰着就像坏了。 -->
                <TextBlock Classes="hint"
                           Text="{Binding ViewModel.DrawDisabledReason}"
                           IsVisible="{Binding ViewModel.HasDrawDisabledReason}" />

                <!-- 重置本轮：次级按钮（破坏性动作，因此要按两次，第一次只把文案换成确认提示）。 -->
                <Button Content="{Binding ViewModel.ResetButtonText}"
                        Command="{Binding ViewModel.ResetRoundCommand}"
                        IsEnabled="{Binding ViewModel.CanReset}"
                        IsVisible="{Binding ViewModel.HasResult}"
                        HorizontalContentAlignment="Center"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>