<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Condition="'$(BuildMobile)' != 'true'">
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildMobile)' == 'true'">
        <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <ApplicationTitle>SecRandom</ApplicationTitle>
        <ApplicationId>cn.sectl.secrandom.mobile</ApplicationId>
        <RuntimeIdentifier Condition="'$(TargetFramework)' == 'net10.0-android'">android-arm64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="'$(TargetFramework)' == 'net10.0-ios'">ios-arm64</RuntimeIdentifier>
        <AndroidPackageFormats Condition="'$(TargetFramework)' == 'net10.0-android'">apk</AndroidPackageFormats>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">13.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateResourceDesigner>true</GenerateResourceDesigner>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SecRandom.Platforms\SecRandom.Platforms.csproj"
                          AdditionalProperties="TargetFramework=net10.0"
                          GlobalPropertiesToRemove="TargetFramework;TargetFrameworks" />
        <ProjectReference Include="..\SecRandom.Platforms.Abstractions\SecRandom.Platforms.Abstractions.csproj"
                          AdditionalProperties="TargetFramework=net10.0"
                          GlobalPropertiesToRemove="TargetFramework;TargetFrameworks" />
        <ProjectReference Include="..\SecRandom.Shared\SecRandom.Shared.csproj"
                          AdditionalProperties="TargetFramework=net8.0"
                          GlobalPropertiesToRemove="TargetFramework;TargetFrameworks" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
        <AndroidResource Include="..\SecRandom\Assets\AppLogo.png" Link="Resources\mipmap\app_logo.png" />
        <AndroidResource Include="Platforms\Android\update_paths.xml" Link="Resources\xml\update_paths.xml" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
        <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="..\SecRandom\Assets\AppLogo.png" Link="Assets\AppLogo.png" />
        <AvaloniaResource Include="..\SecRandom\Assets\Updates\release-public-key.txt" Link="Assets\Updates\release-public-key.txt" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Langs\Mobile\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Langs\Mobile\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <Import Project="..\Global.props" />

    <Target Name="SetMobileApplicationDisplayVersion"
            DependsOnTargets="GetGitInfoForSourceGenerator"
            BeforeTargets="_GetAndroidPackageName;_CompileAppManifestInputs"
            Condition="'$(BuildMobile)' == 'true'">
        <PropertyGroup>
            <_MobileApplicationDisplayVersion>$(GitTag)</_MobileApplicationDisplayVersion>
            <_MobileApplicationDisplayVersion Condition="$([System.String]::Copy('$(_MobileApplicationDisplayVersion)').StartsWith('v'))">$([System.String]::Copy('$(_MobileApplicationDisplayVersion)').Substring(1))</_MobileApplicationDisplayVersion>
            <!-- versionCode stays monotonic for Android updates; versionName follows the desktop Git tag. -->
            <ApplicationDisplayVersion>$(_MobileApplicationDisplayVersion)</ApplicationDisplayVersion>
        </PropertyGroup>
    </Target>
</Project>
