root = true

# EdgeTtsSharp is compiled from its upstream submodule. Its nullable annotations and
# legacy naming are not maintained by this project, so suppress only its known diagnostics.
[vendors/EdgeTtsSharp/**/*.cs]
dotnet_diagnostic.CS8600.severity = none
dotnet_diagnostic.CS8603.severity = none
dotnet_diagnostic.CS8618.severity = none
dotnet_diagnostic.CS8625.severity = none
dotnet_diagnostic.CS8981.severity = none
dotnet_diagnostic.CA2200.severity = none
