<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetFramework">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>SecRandom.Shared</PackageId>
        <Description>Cross-project shared contracts for SecRandom: config bases, profile/list/history models, attached-settings interfaces, and path utilities.</Description>
        <Authors>SECTL</Authors>
        <Company>SECTL</Company>
        <RepositoryUrl>https://github.com/SECTL/SecRandom</RepositoryUrl>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageTags>secrandom;draw;random;education</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <Import Project="..\Global.props"/>

</Project>
