# Public key used to verify official SDK notification channels.
# Set the Base64 SubjectPublicKeyInfo value after the equals sign.
SECRANDOM_INTEGRATION_PUBLIC_KEY_SPKI_BASE64=


# API keys are embedded in SecRandom binaries during build.
# Use 43-128 base64url characters and keep the matching server value in its environment.
SECRANDOM_SYNC_API_KEY=
SECRANDOM_VERIFY_API_KEY=
# Used to authenticate offline QR manifests between SecRandom builds.
SECRANDOM_OFFLINE_QR_API_KEY=
