<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SecRandom.Mobile.Controls">
    <!--
        移动端设计 token 与关键 ControlTheme。
        颜色 token 分 Light/Dark 两套主题字典，页面一律用 DynamicResource 引用，
        主题切换时由 Avalonia 资源系统统一刷新，不再依赖手工 RefreshTheme。
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- 间距 -->
            <x:Double x:Key="MobileSpacingXs">4</x:Double>
            <x:Double x:Key="MobileSpacingSm">8</x:Double>
            <x:Double x:Key="MobileSpacingMd">14</x:Double>
            <x:Double x:Key="MobileSpacingLg">20</x:Double>
            <x:Double x:Key="MobileSpacingXl">28</x:Double>
            <!-- 圆角 -->
            <CornerRadius x:Key="MobileCornerRadiusSmall">10</CornerRadius>
            <CornerRadius x:Key="MobileCornerRadiusMedium">15</CornerRadius>
            <CornerRadius x:Key="MobileCornerRadiusLarge">18</CornerRadius>
            <!-- 字号 -->
            <x:Double x:Key="MobileFontSizeCaption">12</x:Double>
            <x:Double x:Key="MobileFontSizeBody">16</x:Double>
            <x:Double x:Key="MobileFontSizeSection">20</x:Double>
            <x:Double x:Key="MobileFontSizeTitle">24</x:Double>
            <x:Double x:Key="MobileFontSizeResult">34</x:Double>
            <!-- 触控高度 -->
            <x:Double x:Key="MobileMinHeightSecondary">44</x:Double>
            <x:Double x:Key="MobileMinHeightPrimary">48</x:Double>
            <!-- 常用厚度 -->
            <Thickness x:Key="MobilePagePadding">20,20,20,28</Thickness>
            <Thickness x:Key="MobileCardPadding">16</Thickness>

            <!-- 卡片容器默认外观：Surface 底 + 细边框 + 15 圆角 + 16 内边距 -->
            <ControlTheme x:Key="{x:Type controls:MobileCard}" TargetType="controls:MobileCard">
                <Setter Property="Background" Value="{DynamicResource MobileSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MobileBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource MobileCornerRadiusMedium}" />
                <Setter Property="Padding" Value="{DynamicResource MobileCardPadding}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MobileCanvasBrush" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="MobileSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MobileSurfaceMutedBrush" Color="#E7ECEB" />
                    <SolidColorBrush x:Key="MobileBorderBrush" Color="#E4E7EC" />
                    <SolidColorBrush x:Key="MobilePrimaryBrush" Color="#006E5B" />
                    <SolidColorBrush x:Key="MobilePrimaryWashBrush" Color="#E8F4F0" />
                    <SolidColorBrush x:Key="MobileWarmWashBrush" Color="#FFF4E5" />
                    <SolidColorBrush x:Key="MobileMutedTextBrush" Color="#667085" />
                    <SolidColorBrush x:Key="MobileDangerBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="MobileTextBrush" Color="#1D2939" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MobileCanvasBrush" Color="#111817" />
                    <SolidColorBrush x:Key="MobileSurfaceBrush" Color="#1C2523" />
                    <SolidColorBrush x:Key="MobileSurfaceMutedBrush" Color="#27312F" />
                    <SolidColorBrush x:Key="MobileBorderBrush" Color="#35413E" />
                    <SolidColorBrush x:Key="MobilePrimaryBrush" Color="#72D8C2" />
                    <SolidColorBrush x:Key="MobilePrimaryWashBrush" Color="#173D35" />
                    <SolidColorBrush x:Key="MobileWarmWashBrush" Color="#402E18" />
                    <SolidColorBrush x:Key="MobileMutedTextBrush" Color="#A5B0AD" />
                    <SolidColorBrush x:Key="MobileDangerBrush" Color="#FFB4AB" />
                    <SolidColorBrush x:Key="MobileTextBrush" Color="#E7ECEB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
