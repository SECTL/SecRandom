<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Neutral library TFM: mobile workloads are only required by the SecRandom.Android/SecRandom.iOS heads. -->
        <TargetFramework>net10.0</TargetFramework>
        <!-- Assembly identity must stay SecRandom.Mobile: Core InternalsVisibleTo and avares://SecRandom.Mobile/ URIs depend on it. -->
        <AssemblyName>SecRandom.Mobile</AssemblyName>
        <RootNamespace>SecRandom.Mobile</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateResourceDesigner>true</GenerateResourceDesigner>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SecRandom.Platforms\SecRandom.Platforms.csproj" />
        <ProjectReference Include="..\SecRandom.Platforms.Abstractions\SecRandom.Platforms.Abstractions.csproj" />
        <ProjectReference Include="..\SecRandom.Shared\SecRandom.Shared.csproj" />
        <ProjectReference Include="..\SecRandom.Core\SecRandom.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
        <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
        <PackageReference Include="Sentry" Version="6.6.0" />
        <!-- 不引用 Sentry.Profiling：其 buildTransitive targets 在 android/ios 上硬报错。
             共享编译的 SentryTelemetrySdkAdapter 对 AddProfilingIntegration 的引用由
             Services/Telemetry/MobileProfilingIntegrationStub.cs 的 no-op 扩展满足，
             且适配器自身的 OS 门保证移动平台永远不会执行该调用。 -->
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Link the desktop telemetry seam sources (namespace SecRandom.Services.Telemetry stays unchanged)
             instead of copying them, so both ends share one implementation. The desktop-only
             TelemetryTransactionSentryExtensions shim must stay excluded on mobile. -->
        <Compile Include="..\SecRandom\Services\Telemetry\*.cs"
                 Link="Telemetry\%(Filename)%(Extension)"
                 Exclude="..\SecRandom\Services\Telemetry\TelemetryTransactionSentryExtensions.cs" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="..\SecRandom\Assets\AppLogo.png" Link="Assets\AppLogo.png" />
        <AvaloniaResource Include="..\SecRandom\Assets\Updates\release-public-key.txt" Link="Assets\Updates\release-public-key.txt" />
        <AvaloniaResource Include="Styles\MobileStyles.axaml" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Langs\Mobile\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Langs\Mobile\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <Import Project="..\Global.props" />
</Project>
