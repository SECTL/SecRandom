<Application xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styling="using:FluentAvalonia.Styling"
              x:Class="SecRandom.Mobile.MobileApp">
    <Application.Styles>
        <styling:FluentAvaloniaTheme PreferSystemTheme="True"
                                     UseSystemFontOnWindows="True"
                                     TextVerticalAlignmentOverrideBehavior="Disabled" />
        <StyleInclude Source="avares://SecRandom.Mobile/Styles/MobileStyles.axaml" />
    </Application.Styles>
</Application>
