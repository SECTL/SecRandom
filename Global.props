<Project>
    <PropertyGroup>
        <!-- we'll do our own versioning -->
        <GitVersion>false</GitVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <NullabilityInfoContextSupport>True</NullabilityInfoContextSupport>
        <ErrorOnDuplicatePublishOutputFiles>False</ErrorOnDuplicatePublishOutputFiles>
        <CheckEolWorkloads>false</CheckEolWorkloads>
        <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;publish/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SecRandom.SimpleGitInfoGenerator" Version="1.0.0.0"
                          PrivateAssets="All" IncludeAssets="build;analyzers"/>

        <Compile Include="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)'))/AssemblyInfo.cs">
            <LinkBase>Properties</LinkBase>
        </Compile>
    </ItemGroup>

    <PropertyGroup>
        <GitVersion_UpdateAssemblyInfo>true</GitVersion_UpdateAssemblyInfo>
    </PropertyGroup>

    <Target Name="NormalizeGitTagForAssemblyVersion"
            AfterTargets="GetGitInfoForSourceGenerator"
            BeforeTargets="CoreCompile">
        <PropertyGroup>
            <!-- Release tags keep their conventional v-prefix; assembly versions cannot. -->
            <GitTag Condition="$([System.String]::Copy('$(GitTag)').StartsWith('v'))">$([System.String]::Copy('$(GitTag)').Substring(1))</GitTag>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.200" PrivateAssets="All"/>
    </ItemGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <PropertyGroup>
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>
</Project>
